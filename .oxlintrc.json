                  "kysely/**",
                  "pg",
                  "pg/**",
                  "**/infrastructure/postgres/generated/**",
                  "**/infrastructure/prisma/**",
                  "**/modules/*/internal/**"
                ],
                "message": "Nest adapters may use the module interface, not persistence internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/backend/src/migrations/**/*.ts"
      ],
