{
  "name": "@inside/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "guardrails": "node scripts/check-web-architecture.mjs && node scripts/check-negative-guardrails.mjs",
    "test": "vitest run --config vitest.config.mts",
    "test:standalone-config": "node --test scripts/check-standalone-runtime-config.test.mjs",
    "test:storybook": "vitest run --config vitest.config.mts --project=storybook",
    "test:e2e": "playwright test",
    "test:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "test:identity": "playwright test --config playwright.identity.config.ts",
    "test:evidence": "CAPTURE_EVIDENCE=1 playwright test",
    "smoke:backend": "vitest run --config vitest.smoke.config.mts",
    "openapi:generate": "node scripts/generate-openapi-client.mjs generate",
    "openapi:check": "node scripts/generate-openapi-client.mjs check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@logto/next": "4.2.10",
    "@tanstack/react-query": "5.102.8",
    "@tiptap/core": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@logto/node": "3.1.10",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "agentation": "3.0.2",
    "openapi-typescript-codegen": "0.31.0",
    "shadcn": "4.19.0",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
