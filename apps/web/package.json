{
  "name": "@inside/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "guardrails": "node scripts/check-web-architecture.mjs && node scripts/check-negative-guardrails.mjs",
    "test": "bash ../../scripts/heavy-check.sh vitest run --config vitest.config.mts",
    "test:standalone-config": "node --test scripts/check-standalone-runtime-config.test.mjs",
    "test:prerendered-handlers": "node scripts/check-prerendered-route-handlers.mjs",
    "test:module": "vitest run --config vitest.config.mts --project=module",
    "test:browser-engines": "bash ../../scripts/heavy-check.sh vitest run --config vitest.config.mts --project=browser-engines",
    "test:storybook": "bash ../../scripts/heavy-check.sh vitest run --config vitest.config.mts --project=storybook",
    "test:e2e": "bash ../../scripts/heavy-check.sh playwright test",
    "test:fullstack": "bash ../../scripts/heavy-check.sh playwright test --config playwright.fullstack.config.ts",
    "test:navigation": "bash ../../scripts/heavy-check.sh playwright test --config playwright.navigation.config.ts",
    "test:identity": "bash ../../scripts/heavy-check.sh playwright test --config playwright.identity.config.ts",
    "test:production-access": "bash ../../scripts/heavy-check.sh playwright test --config playwright.production.config.ts",
    "test:evidence": "bash ../../scripts/heavy-check.sh env CAPTURE_EVIDENCE=1 playwright test",
    "smoke:backend": "vitest run --config vitest.smoke.config.mts",
    "openapi:generate": "node scripts/generate-openapi-client.mjs generate",
    "openapi:check": "node scripts/generate-openapi-client.mjs check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "bash ../../scripts/heavy-check.sh storybook build --output-dir storybook-static",
    "test:contracts": "bash ../../scripts/heavy-check.sh vitest run --config vitest.config.mts --project=contracts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@inside/access-capabilities": "workspace:*",
    "@inside/contracts": "workspace:*",
    "@inside/legal": "workspace:*",
    "@inside/material-blocks": "workspace:*",
    "@inside/runtime-identity": "workspace:*",
    "@kinescope/player-iframe-api-loader": "0.9.0",
    "@logto/next": "5.0.0",
    "@tanstack/react-query": "5.104.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "1.4.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@logto/node": "4.0.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-dom-shim": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "openapi-typescript-codegen": "0.31.0",
    "shadcn": "4.21.1",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
