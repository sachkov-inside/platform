{
  "name": "@inside/telegram",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "owner:group-members-report": "tsx src/operations/group-members-report-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm guardrails && pnpm test && pnpm test:contracts && pnpm build",
    "check:full": "pnpm check && pnpm test:integration",
    "conformance:communications-provider": "tsx scripts/communications-conformance-provider.ts",
    "conformance:platform-provider": "tsx scripts/platform-conformance-provider.ts",
    "credentialed-proof:probe": "tsx src/operations/run-credentialed-proof.ts",
    "credentialed-proof:preflight": "tsx src/operations/run-credentialed-proof-preflight.ts",
    "credentialed-proof:wizard": "bash scripts/credentialed-proof-wizard.sh",
    "db:migrate": "tsx src/database/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "format": "pnpm --dir ../.. format",
    "format:check": "pnpm --dir ../.. format:check",
    "guardrails": "node scripts/check-architecture.mjs && node scripts/check-migration-history.mjs",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d --wait postgres rabbitmq",
    "owner:recover-identity": "tsx src/operations/recover-identity-link.ts",
    "lint": "pnpm --dir ../.. lint",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:widget": "bash ../../scripts/heavy-check.sh vitest run --config vitest.widget.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proof:course:provider": "tsx test/local/course-activation-provider.ts",
    "owner:community-restriction": "tsx src/operations/community-restriction-cli.ts",
    "owner:activation-review": "tsx src/operations/activation-review-cli.ts",
    "owner:activation-announcement": "tsx src/operations/activation-announcement-cli.ts",
    "owner:trainer-bank-import": "tsx src/operations/trainer-bank-import-cli.ts",
    "owner:trainer-report": "tsx src/operations/trainer-report-cli.ts",
    "owner:ai-models-reference-import": "tsx src/operations/ai-models-reference-import-cli.ts",
    "owner:ai-models-report": "tsx src/operations/ai-models-report-cli.ts",
    "proof:course:browser": "tsx test/local/course-activation-browser.ts",
    "proof:course:existing": "node test/local/course-existing-browser.mjs",
    "trainer:widget:build": "tsx scripts/trainer-widget/build.ts",
    "ai-models:widget:build": "tsx scripts/ai-models-widget/build.ts",
    "ai-models:widget:fit": "bash ../../scripts/heavy-check.sh node ../../scripts/owned-node.mjs --import tsx scripts/ai-models-widget/fit.ts",
    "trainer:widget:fit": "bash ../../scripts/heavy-check.sh node ../../scripts/owned-node.mjs --import tsx scripts/trainer-widget/fit.ts",
    "trainer:bank:schema": "tsx scripts/trainer-bank/write-schema.ts",
    "ai-models:reference:schema": "tsx scripts/ai-models-reference/write-schema.ts",
    "test:contracts": "bash ../../scripts/heavy-check.sh vitest run --config vitest.contract.config.ts",
    "trainer:review": "node ../../scripts/owned-node.mjs --import tsx scripts/trainer-widget/review.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.117",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@inside/access-capabilities": "workspace:*",
    "@inside/contracts": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "abort-controller": "3.0.0",
    "ai": "7.0.172",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.3.1",
    "fastify": "5.12.8",
    "grammy": "1.46.0",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nestjs/testing": "12.5.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
