telegram.sachkov.dev {
	@provider {
		method POST
		path_regexp provider ^/(webhooks/telegram|integrations/platform/v1/(identity-links(/[^/]+/confirm)?|community-entitlements|telegram-contacts|participant-activity)|integrations/platform/v2/(communications|telegram-contacts/(search|read))|integrations/identity/v1/sign-in(/[^/]+/(status|consume|account-link))?)$
	}
	handle @provider {
		reverse_proxy 127.0.0.1:3303
	}
	handle {
		respond 404
	}
}
