{
  "name": "@inside/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:mcp": "tsx watch src/entrypoints/mcp.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/entrypoints/api.js",
    "start:mcp": "node dist/entrypoints/mcp.js",
    "db:migrate": "tsx src/migrations/migrate.ts",
    "db:types:generate": "kysely-codegen --env-file ../../.env --dialect postgres --default-schema public --include-pattern 'public.*' --exclude-pattern 'kysely_*' --out-file src/infrastructure/postgres/generated/database.ts",
    "db:types:check": "kysely-codegen --env-file ../../.env --dialect postgres --default-schema public --include-pattern 'public.*' --exclude-pattern 'kysely_*' --out-file src/infrastructure/postgres/generated/database.ts --verify",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "guardrails": "node scripts/check-backend-architecture.mjs src && node scripts/check-negative-guardrails.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "smoke:health": "vitest run --config vitest.smoke.config.mts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/extension-unique-id": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
