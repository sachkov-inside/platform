{
  "name": "@inside/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:mcp": "tsx watch src/entrypoints/mcp.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "start:mcp": "node dist/entrypoints/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:health": "vitest run --config vitest.smoke.config.mts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "pg-boss": "12.27.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
