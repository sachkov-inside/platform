{
  "name": "@inside/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:mcp": "tsx watch src/entrypoints/mcp.ts",
    "dev:material-assets-worker": "tsx watch src/entrypoints/material-assets-worker.ts",
    "dev:profile-avatars-worker": "tsx watch src/entrypoints/profile-avatars-worker.ts",
    "dev:video-deletions-worker": "tsx watch src/entrypoints/video-deletions-worker.ts",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "build:production": "pnpm prisma:generate && tsc -p tsconfig.production.json",
    "conformance:telegram-membership": "tsx scripts/telegram-membership-conformance.ts",
    "start:api": "node dist/entrypoints/api.js",
    "start:mcp": "node dist/entrypoints/mcp.js",
    "start:material-assets-worker": "node dist/entrypoints/material-assets-worker.js",
    "start:profile-avatars-worker": "node dist/entrypoints/profile-avatars-worker.js",
    "start:video-deletions-worker": "node dist/entrypoints/video-deletions-worker.js",
    "db:migrate": "tsx src/migrations/migrate.ts",
    "release:bootstrap-owner": "tsx src/release/bootstrap-owner-account.ts",
    "release:fingerprint-billing-contacts": "tsx src/release/fingerprint-billing-contacts.ts",
    "release:moderate-profiles": "tsx src/release/moderate-account-profiles.ts",
    "db:seed": "tsx src/development/seed-local.ts",
    "dev:bank-double": "tsx watch src/development/bank-double.ts",
    "smoke:set-full-stack-membership": "tsx src/development/set-full-stack-membership.ts",
    "smoke:grant-full-stack-membership": "tsx src/development/grant-full-stack-membership.ts",
    "smoke:link-full-stack-telegram": "tsx src/development/link-full-stack-telegram.ts",
    "db:schema:check": "pnpm prisma:validate && pnpm prisma:generate",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "guardrails": "pnpm --filter @inside/contracts discussions:check && pnpm contracts:check && pnpm notifications:check && pnpm communications:check && pnpm mcp:check && node scripts/check-backend-architecture.mjs src && node scripts/check-negative-guardrails.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "mcp:generate": "tsx scripts/mcp-tool-surface.ts && tsx scripts/mcp-tool-surface.ts --learning",
    "mcp:check": "tsx scripts/mcp-tool-surface.ts --check && tsx scripts/mcp-tool-surface.ts --learning --check",
    "test": "vitest run",
    "test:integration": "bash ../../scripts/heavy-check.sh vitest run --config vitest.integration.config.mts",
    "test:integration:parallel": "bash ../../scripts/heavy-check.sh vitest run --config vitest.integration.config.mts --project integration",
    "test:integration:serial": "bash ../../scripts/heavy-check.sh vitest run --config vitest.integration.config.mts --project integration-serial",
    "smoke:mcp-authoring": "bash ../../scripts/heavy-check.sh tsx scripts/mcp-authoring-smoke.ts",
    "smoke:health": "bash ../../scripts/heavy-check.sh vitest run --config vitest.smoke.config.mts",
    "communications:generate": "node scripts/generate-communications-contract.mjs",
    "communications:check": "node scripts/generate-communications-contract.mjs --check",
    "conformance:communications": "tsx scripts/communications-conformance.ts",
    "notifications:generate": "tsx scripts/generate-notification-topology.ts",
    "notifications:check": "tsx scripts/generate-notification-topology.ts --check",
    "dev:notifications-worker": "tsx watch src/entrypoints/notifications-worker.ts",
    "start:notifications-worker": "node dist/entrypoints/notifications-worker.js",
    "dev:billing-worker": "tsx watch src/entrypoints/billing-worker.ts",
    "start:billing-worker": "node dist/entrypoints/billing-worker.js",
    "contracts:generate": "tsx scripts/generate-subscription-contracts.ts",
    "contracts:check": "tsx scripts/generate-subscription-contracts.ts --check",
    "test:contracts": "bash ../../scripts/heavy-check.sh bash -c 'pnpm build && vitest run --config vitest.contract.config.mts \"$@\"' --",
    "telemetry:measure": "bash ../../scripts/heavy-check.sh tsx scripts/measure-web-telemetry.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.10",
    "@inside/access-capabilities": "workspace:*",
    "@inside/contracts": "workspace:*",
    "@inside/legal": "workspace:*",
    "@inside/material-blocks": "workspace:*",
    "@inside/runtime-identity": "workspace:*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.3.1",
    "fastify": "5.12.8",
    "file-type": "22.3.0",
    "jose": "6.2.17",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
