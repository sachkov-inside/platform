generator client {
  provider               = "prisma-client"
  output                 = "../src/infrastructure/prisma/generated"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["notifications", "billing", "accounts", "assets", "communications", "materials", "member_profiles", "reading_activity", "membership_entitlements", "telegram_membership", "videos", "workshop"]
}

model Account {
  id               String   @id @db.Uuid
  logtoIssuer      String   @map("logto_issuer")
  logtoSubject     String   @map("logto_subject")
  telegramSubjectRef String? @unique(map: "accounts_telegram_subject_unique") @map("telegram_subject_ref") @db.Uuid
  emailFingerprint String?  @unique(map: "accounts_email_fingerprint_unique") @map("email_fingerprint") @db.VarChar(67)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([logtoIssuer, logtoSubject], map: "accounts_logto_identity_unique")
  @@map("accounts")
  @@schema("accounts")
}

model AccountPermission {
  accountId  String   @map("account_id") @db.Uuid
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([accountId, permission], map: "account_permissions_primary")
  @@map("account_permissions")
  @@schema("accounts")
}

model AccountAuditEvent {
  permission String?
  id        String   @id @db.Uuid
  event     String
  accountId String?  @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("account_audit_events")
  @@schema("accounts")
}

model MemberProfile {
  accountId       String   @id @map("account_id") @db.Uuid
  publicProfileId String   @unique(map: "member_profiles_public_profile_id_unique") @map("public_profile_id") @db.Uuid
  displayName     String   @map("display_name") @db.VarChar(80)
  bio             String?  @db.VarChar(500)
  avatarId        String?  @map("avatar_id") @db.Uuid
  status          String
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  avatar          ProfileAvatar? @relation("CurrentProfileAvatar", fields: [avatarId, accountId], references: [id, accountId])
  ownedAvatars    ProfileAvatar[] @relation("ProfileOwnedAvatars")

  @@unique([avatarId, accountId], map: "member_profiles_avatar_account_unique")
  @@map("profiles")
  @@schema("member_profiles")
}

model ProfileAvatar {
  id                  String    @id @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  state               String
  failureCode         String?   @map("failure_code") @db.VarChar(64)
  currentlyReferenced Boolean   @default(false) @map("currently_referenced")
  orphanedAt          DateTime  @default(now()) @map("orphaned_at") @db.Timestamptz
  cleanupClaimedAt    DateTime? @map("cleanup_claimed_at") @db.Timestamptz
  readyAt             DateTime? @map("ready_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  currentProfile      MemberProfile? @relation("CurrentProfileAvatar")
  ownerProfile        MemberProfile  @relation("ProfileOwnedAvatars", fields: [accountId], references: [accountId], onDelete: Cascade)
  renditions          ProfileAvatarRendition[]

  @@unique([id, accountId], map: "profile_avatars_id_account_unique")
  @@index([orphanedAt, updatedAt], map: "profile_avatars_cleanup_idx")
  @@map("avatars")
  @@schema("member_profiles")
}

model ProfileAvatarRendition {
  avatarId          String @map("avatar_id") @db.Uuid
  size              Int
  contentType       String @map("content_type") @db.VarChar(255)
  byteSize          Int    @map("byte_size")
  checksumSha256    String @map("checksum_sha256") @db.Char(64)
  protectedObjectKey String @map("protected_object_key") @db.VarChar(512)
  avatar            ProfileAvatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@id([avatarId, size], map: "profile_avatar_renditions_primary")
  @@map("avatar_renditions")
  @@schema("member_profiles")
}

model MemberProfileAuditEvent {
  id              String   @id @db.Uuid
  event           String
  accountId       String   @map("account_id") @db.Uuid
  publicProfileId String   @map("public_profile_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([accountId, createdAt(sort: Desc)], map: "member_profile_audit_account_created_idx")
  @@map("audit_events")
  @@schema("member_profiles")
}

model MembershipBinding {
  accountId    String   @id @map("account_id") @db.Uuid
  principalRef String   @unique(map: "membership_account_bindings_principal_unique") @map("principal_ref") @db.VarChar(256)
  linkedAt     DateTime @map("linked_at") @db.Timestamptz

  @@unique([accountId, principalRef], map: "membership_account_bindings_pair_unique")
  @@map("account_bindings")
  @@schema("membership_entitlements")
}

model MembershipEvidenceReceipt {
  deliveryId        String    @id @map("delivery_id") @db.VarChar(256)
  accountId         String    @map("account_id") @db.Uuid
  source            String
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  principalRef      String?   @map("principal_ref") @db.VarChar(256)
  evidenceRef       String?   @map("evidence_ref") @db.VarChar(256)
  evidenceVersion   BigInt?   @map("evidence_version") @db.BigInt
  decision          String?
  outcome           String
  checkedAt         DateTime? @map("checked_at") @db.Timestamptz
  validUntil        DateTime? @map("valid_until") @db.Timestamptz
  receivedAt        DateTime  @map("received_at") @db.Timestamptz
  retainUntil       DateTime  @map("retain_until") @db.Timestamptz

  @@index([accountId, receivedAt(sort: Desc), deliveryId(sort: Desc)], map: "membership_evidence_receipts_account_received_idx")
  @@index([retainUntil], map: "membership_evidence_receipts_retention_idx")
  @@map("evidence_receipts")
  @@schema("membership_entitlements")
}

model MembershipProjection {
  accountId           String   @id @map("account_id") @db.Uuid
  principalRef        String   @unique(map: "membership_current_projections_principal_unique") @map("principal_ref") @db.VarChar(256)
  decision            String
  evidenceRef         String   @map("evidence_ref") @db.VarChar(256)
  evidenceVersion     BigInt   @map("evidence_version") @db.BigInt
  evidenceFingerprint String   @map("evidence_fingerprint") @db.Char(64)
  checkedAt           DateTime @map("checked_at") @db.Timestamptz
  validUntil          DateTime @map("valid_until") @db.Timestamptz
  updatedAt           DateTime @map("updated_at") @db.Timestamptz

  @@map("current_projections")
  @@schema("membership_entitlements")
}

model WorkshopEntitlement {
  id                 String   @id @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  workshopScope      String   @map("workshop_scope") @db.VarChar(128)
  startsAt           DateTime @map("starts_at") @db.Timestamptz
  validUntil         DateTime @map("valid_until") @db.Timestamptz
  grantSource        String   @map("grant_source") @db.VarChar(64)
  grantedBy          String   @map("granted_by") @db.Uuid
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(200)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  createdAt          DateTime @map("created_at") @db.Timestamptz

  @@unique([grantedBy, idempotencyKey], map: "workshop_entitlements_idempotency_unique")
  @@index([accountId, workshopScope, validUntil(sort: Desc)], map: "workshop_entitlements_access_idx")
  @@map("entitlements")
  @@schema("workshop")
}

model WorkshopMembershipEntitlementProjection {
  accountId           String   @id @map("account_id") @db.Uuid
  principalRef        String   @unique(map: "workshop_membership_entitlement_principal_unique") @map("principal_ref") @db.VarChar(256)
  decision            String
  evidenceRef         String   @map("evidence_ref") @db.VarChar(256)
  evidenceVersion     BigInt   @map("evidence_version") @db.BigInt
  evidenceFingerprint String   @map("evidence_fingerprint") @db.Char(64)
  checkedAt           DateTime @map("checked_at") @db.Timestamptz
  validUntil          DateTime @map("valid_until") @db.Timestamptz
  updatedAt           DateTime @map("updated_at") @db.Timestamptz

  @@map("membership_entitlement_projections")
  @@schema("workshop")
}

model WorkshopCase {
  id               String               @id @db.Uuid
  slug             String               @unique(map: "workshop_cases_slug_unique") @db.VarChar(120)
  workshopScope    String               @map("workshop_scope") @db.VarChar(128)
  lifecycle        String
  currentVersionId String?              @unique(map: "workshop_cases_current_version_unique") @map("current_version_id") @db.Uuid
  createdAt        DateTime             @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @map("updated_at") @db.Timestamptz
  currentVersion   WorkshopCaseVersion? @relation("WorkshopCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions         WorkshopCaseVersion[] @relation("WorkshopCaseVersions")

  @@map("cases")
  @@schema("workshop")
}

model WorkshopCaseVersion {
  id                     String                 @id @db.Uuid
  caseId                 String                 @map("case_id") @db.Uuid
  caseVersion            String                 @map("case_version") @db.VarChar(128)
  schemaVersion          String                 @map("schema_version") @db.VarChar(128)
  caseSpec               Json                   @map("case_spec")
  contentDigest          String                 @map("content_digest") @db.Char(64)
  sourceRepository       String                 @map("source_repository") @db.VarChar(256)
  sourceCommit           String                 @map("source_commit") @db.Char(40)
  artifacts              Json
  publicationFingerprint String                 @map("publication_fingerprint") @db.Char(64)
  publishedBy            String                 @map("published_by") @db.Uuid
  idempotencyKey         String                 @map("idempotency_key") @db.VarChar(200)
  publishedAt            DateTime               @map("published_at") @db.Timestamptz
  withdrawnAt            DateTime?              @map("withdrawn_at") @db.Timestamptz
  workshopCase           WorkshopCase           @relation("WorkshopCaseVersions", fields: [caseId], references: [id], onDelete: Restrict)
  currentFor             WorkshopCase?          @relation("WorkshopCurrentVersion")
  materials              WorkshopCaseMaterial[]
  hintReveals            WorkshopHintReveal[]
  solutionReveals        WorkshopSolutionReveal[]

  @@unique([caseId, caseVersion], map: "workshop_case_versions_domain_version_unique")
  @@unique([sourceRepository, sourceCommit, contentDigest], map: "workshop_case_versions_source_unique")
  @@unique([publishedBy, idempotencyKey], map: "workshop_case_versions_idempotency_unique")
  @@map("case_versions")
  @@schema("workshop")
}

model WorkshopCaseMaterial {
  caseVersionId String              @map("case_version_id") @db.Uuid
  materialId    String              @map("material_id") @db.Uuid
  role          String
  ordinal       Int
  releasePolicy String              @map("release_policy")
  hintKey       String?             @map("hint_key") @db.VarChar(128)
  caseVersion   WorkshopCaseVersion @relation(fields: [caseVersionId], references: [id], onDelete: Restrict)

  @@id([caseVersionId, materialId], map: "workshop_case_materials_primary")
  @@unique([caseVersionId, ordinal], map: "workshop_case_materials_ordinal_unique")
  @@map("case_materials")
  @@schema("workshop")
}

model WorkshopHintReveal {
  id                 String              @id @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  caseVersionId      String              @map("case_version_id") @db.Uuid
  hintKey            String              @map("hint_key") @db.VarChar(128)
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(200)
  requestFingerprint String              @map("request_fingerprint") @db.Char(64)
  revealedAt         DateTime            @map("revealed_at") @db.Timestamptz
  caseVersion        WorkshopCaseVersion @relation(fields: [caseVersionId], references: [id], onDelete: Restrict)

  @@unique([accountId, caseVersionId, hintKey], map: "workshop_hint_reveals_identity_unique")
  @@unique([accountId, idempotencyKey], map: "workshop_hint_reveals_idempotency_unique")
  @@map("hint_reveals")
  @@schema("workshop")
}

model WorkshopSolutionReveal {
  id                 String              @id @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  caseVersionId      String              @map("case_version_id") @db.Uuid
  reason             String
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(200)
  requestFingerprint String              @map("request_fingerprint") @db.Char(64)
  revealedAt         DateTime            @map("revealed_at") @db.Timestamptz
  caseVersion        WorkshopCaseVersion @relation(fields: [caseVersionId], references: [id], onDelete: Restrict)

  @@unique([accountId, caseVersionId], map: "workshop_solution_reveals_identity_unique")
  @@unique([accountId, idempotencyKey], map: "workshop_solution_reveals_idempotency_unique")
  @@map("solution_reveals")
  @@schema("workshop")
}

model TelegramLinkTransaction {
  linkRef                String   @id @map("link_ref") @db.Uuid
  accountId              String   @map("account_id") @db.Uuid
  principalRef           String   @unique(map: "telegram_link_principal_unique") @map("principal_ref") @db.VarChar(256)
  returnCorrelation      String   @unique(map: "telegram_link_return_correlation_unique") @map("return_correlation") @db.VarChar(256)
  tokenDigest            String   @unique(map: "telegram_link_token_digest_unique") @map("token_digest") @db.Char(43)
  providerTransactionRef String?  @unique(map: "telegram_link_provider_transaction_unique") @map("provider_transaction_ref") @db.VarChar(256)
  providerIdentityRef    String?  @map("provider_identity_ref") @db.VarChar(256)
  status                 String
  expiresAt              DateTime @map("expires_at") @db.Timestamptz
  createdAt              DateTime @map("created_at") @db.Timestamptz
  updatedAt              DateTime @map("updated_at") @db.Timestamptz

  @@index([accountId, updatedAt(sort: Desc), linkRef(sort: Desc)], map: "telegram_link_account_updated_idx")
  @@map("link_transactions")
  @@schema("telegram_membership")
}

model Topic {
  id         String    @id @db.Uuid
  slug       String    @unique(map: "topics_slug_unique")
  name       String
  summary    String    @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  version    Int       @default(1)
  coverId    String?   @map("cover_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("topics")
  @@schema("materials")
}


model Tag {
  id             String @id @db.Uuid
  name           String
  normalizedName String @unique(map: "tags_normalized_name_unique") @map("normalized_name")

  @@map("tags")
  @@schema("materials")
}

model Guide {
  id         String    @id @db.Uuid
  slug       String    @unique(map: "series_slug_unique")
  name       String
  summary    String    @default("")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  version    Int       @default(1)
  coverId    String?   @map("cover_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("series")
  @@schema("materials")
}

model GuideArtifact {
  id              String    @id @db.Uuid
  title           String    @db.VarChar(200)
  purpose         String    @default("") @db.VarChar(1000)
  access          String
  origin          String
  sourceId        String?   @map("source_id") @db.VarChar(200)
  importedAt       DateTime? @map("imported_at") @db.Timestamptz
  importedRevision Int?      @map("imported_revision")
  revision         Int       @default(1)
  currentVersion   Int       @map("current_version")
  state           String
  createdBy       String    @map("created_by") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  versions      GuideArtifactVersion[]
  placements    GuideArtifactPlacement[]
  materialLinks GuideArtifactMaterialLink[]

  @@unique([sourceId], map: "guide_artifacts_source_unique")
  @@index([state, updatedAt(sort: Desc)], map: "guide_artifacts_state_idx")
  @@map("guide_artifacts")
  @@schema("materials")
}

model GuideArtifactVersion {
  artifactId          String    @map("artifact_id") @db.Uuid
  version             Int
  contentKind         String    @map("content_kind")
  externalUrl         String?   @map("external_url") @db.VarChar(2048)
  originalFilename    String?   @map("original_filename") @db.VarChar(255)
  contentType         String?   @map("content_type") @db.VarChar(255)
  byteSize            Int?      @map("byte_size")
  checksumSha256      String?   @map("checksum_sha256") @db.Char(64)
  objectNonce         String?   @map("object_nonce") @db.Uuid
  quarantineObjectKey String?   @map("quarantine_object_key") @db.VarChar(512)
  protectedObjectKey  String?   @map("protected_object_key") @db.VarChar(512)
  publicObjectKey     String?   @map("public_object_key") @db.VarChar(512)
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  supersededAt        DateTime? @map("superseded_at") @db.Timestamptz

  artifact GuideArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([artifactId, version], map: "guide_artifact_versions_primary")
  @@map("guide_artifact_versions")
  @@schema("materials")
}

model GuideArtifactPlacement {
  artifactId String   @map("artifact_id") @db.Uuid
  guideId    String   @map("guide_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  artifact GuideArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@id([artifactId, guideId], map: "guide_artifact_placements_primary")
  @@index([guideId, createdAt], map: "guide_artifact_placements_guide_idx")
  @@map("guide_artifact_placements")
  @@schema("materials")
}

model GuideArtifactMaterialLink {
  artifactId String   @map("artifact_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  artifact GuideArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@id([artifactId, materialId], map: "guide_artifact_material_links_primary")
  @@index([materialId], map: "guide_artifact_material_links_material_idx")
  @@map("guide_artifact_material_links")
  @@schema("materials")
}

model HomeSeriesPin {
  id       Int     @id
  seriesId String? @map("series_id") @db.Uuid
  version  Int     @default(1)

  @@map("home_series_pin")
  @@schema("materials")
}

model Material {
  id               String    @id @db.Uuid
  slug             String?   @unique(map: "materials_slug_unique")
  title            String?
  summary          String?
  topicId          String?   @map("topic_id") @db.Uuid
  formatId         String?   @map("format_id")
  schemaVersion    Int       @map("schema_version") @db.SmallInt
  body             Json
  createdBy        String    @map("created_by") @db.Uuid
  access           String
  publicationState String    @map("publication_state")
  contentVersion   BigInt    @map("content_version") @db.BigInt
  firstPublishedAt DateTime? @map("first_published_at") @db.Timestamptz
  publishedAt      DateTime? @map("published_at") @db.Timestamptz
  publishedBy      String?   @map("published_by") @db.Uuid
  primaryVideoId   String?   @map("primary_video_id") @db.Uuid
  coverId          String?   @map("cover_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([id, contentVersion], map: "materials_id_content_version_unique")
  @@map("materials")
  @@schema("materials")
}

model MaterialTag {
  materialId String @map("material_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  @@id([materialId, tagId], map: "material_tags_primary")
  @@map("material_tags")
  @@schema("materials")
}

model GuideMembership {
  stepGroup String? @map("step_group")
  seriesId   String @map("series_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  ordinal    Int

  @@id([seriesId, materialId], map: "series_memberships_primary")
  @@unique([seriesId, ordinal], map: "series_memberships_ordinal_unique")
  @@map("series_memberships")
  @@schema("materials")
}

model AuthoringIdempotency {
  actorId            String    @map("actor_id") @db.Uuid
  operation          String
  idempotencyKey     String    @map("idempotency_key")
  requestFingerprint String    @map("request_fingerprint") @db.Char(64)
  materialId         String?   @map("material_id") @db.Uuid
  contentVersion     BigInt?   @map("content_version") @db.BigInt
  publicationState   String?   @map("publication_state")
  publishedAt        DateTime? @map("published_at") @db.Timestamptz
  deleted            Boolean   @default(false)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([actorId, operation, idempotencyKey], map: "authoring_idempotency_primary")
  @@map("authoring_idempotency")
  @@schema("materials")
}

model PublishedMaterial {
  materialId     String   @id @map("material_id") @db.Uuid
  contentVersion BigInt   @map("content_version") @db.BigInt
  slug           String   @unique(map: "published_materials_slug_unique")
  title          String
  summary        String
  access         String
  topicId        String   @map("topic_id") @db.Uuid
  formatId       String   @map("format_id")
  publicSearchText String @map("public_search_text")
  publishedBy    String   @map("published_by") @db.Uuid
  publishedAt    DateTime @map("published_at") @db.Timestamptz
  primaryVideoId String?  @map("primary_video_id") @db.Uuid
  coverId        String?  @map("cover_id") @db.Uuid

  @@index([publishedAt(sort: Desc), materialId(sort: Desc)], map: "published_materials_cursor_idx")
  @@map("published_materials")
  @@schema("materials")
}

model ContentCover {
  id                  String    @id @db.Uuid
  materialId          String?   @map("material_id") @db.Uuid
  topicId             String?   @map("topic_id") @db.Uuid
  seriesId            String?   @map("series_id") @db.Uuid
  state               String
  failureCode         String?   @map("failure_code") @db.VarChar(64)
  currentlyReferenced Boolean   @default(false) @map("currently_referenced")
  uploadConfirmed     Boolean   @default(false) @map("upload_confirmed")
  orphanedAt          DateTime  @default(now()) @map("orphaned_at") @db.Timestamptz
  readyAt             DateTime? @map("ready_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  renditions          ContentCoverRendition[]

  @@unique([id, materialId], map: "content_covers_material_identity")
  @@unique([id, topicId], map: "content_covers_topic_identity")
  @@unique([id, seriesId], map: "content_covers_series_identity")
  @@index([currentlyReferenced, orphanedAt, updatedAt], map: "content_covers_orphan_idx")
  @@map("content_covers")
  @@schema("materials")
}

model ContentCoverRendition {
  coverId         String @map("cover_id") @db.Uuid
  width           Int
  height          Int
  contentType     String @map("content_type") @db.VarChar(255)
  byteSize        Int    @map("byte_size")
  checksumSha256  String @map("checksum_sha256") @db.Char(64)
  publicObjectKey String @map("public_object_key") @db.VarChar(512)
  cover           ContentCover @relation(fields: [coverId], references: [id], onDelete: Cascade)

