generator client {
  provider               = "prisma-client"
  output                 = "../src/infrastructure/prisma/generated"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["accounts", "materials", "member_profiles", "membership_entitlements"]
}

model Account {
  id               String   @id @db.Uuid
  logtoIssuer      String   @map("logto_issuer")
  logtoSubject     String   @map("logto_subject")
  emailFingerprint String?  @unique(map: "accounts_email_fingerprint_unique") @map("email_fingerprint") @db.VarChar(67)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([logtoIssuer, logtoSubject], map: "accounts_logto_identity_unique")
  @@map("accounts")
  @@schema("accounts")
}

model AccountPermission {
  accountId  String   @map("account_id") @db.Uuid
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([accountId, permission], map: "account_permissions_primary")
  @@map("account_permissions")
  @@schema("accounts")
}

model AccountAuditEvent {
  id        String   @id @db.Uuid
  event     String
  accountId String?  @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("account_audit_events")
  @@schema("accounts")
}

model MemberProfile {
  accountId       String   @id @map("account_id") @db.Uuid
  publicProfileId String   @unique(map: "member_profiles_public_profile_id_unique") @map("public_profile_id") @db.Uuid
  displayName     String   @map("display_name") @db.VarChar(80)
  bio             String?  @db.VarChar(500)
  status          String
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("profiles")
  @@schema("member_profiles")
}

model MemberProfileAuditEvent {
  id              String   @id @db.Uuid
  event           String
  accountId       String   @map("account_id") @db.Uuid
  publicProfileId String   @map("public_profile_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([accountId, createdAt(sort: Desc)], map: "member_profile_audit_account_created_idx")
  @@map("audit_events")
  @@schema("member_profiles")
}

model MemberProfileReport {
  id                String   @id @db.Uuid
  publicProfileId   String   @map("public_profile_id") @db.Uuid
  reporterAccountId String   @map("reporter_account_id") @db.Uuid
  reason            String
  status            String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([publicProfileId, reporterAccountId], map: "member_profile_reports_reporter_unique")
  @@index([status, createdAt], map: "member_profile_reports_status_created_idx")
  @@map("reports")
  @@schema("member_profiles")
}

model MembershipBinding {
  accountId    String   @id @map("account_id") @db.Uuid
  principalRef String   @unique(map: "membership_account_bindings_principal_unique") @map("principal_ref") @db.VarChar(256)
  linkedAt     DateTime @map("linked_at") @db.Timestamptz

  @@unique([accountId, principalRef], map: "membership_account_bindings_pair_unique")
  @@map("account_bindings")
  @@schema("membership_entitlements")
}

model MembershipEvidenceReceipt {
  deliveryId        String    @id @map("delivery_id") @db.VarChar(256)
  accountId         String    @map("account_id") @db.Uuid
  source            String
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  principalRef      String?   @map("principal_ref") @db.VarChar(256)
  evidenceRef       String?   @map("evidence_ref") @db.VarChar(256)
  evidenceVersion   BigInt?   @map("evidence_version") @db.BigInt
  decision          String?
  outcome           String
  checkedAt         DateTime? @map("checked_at") @db.Timestamptz
  validUntil        DateTime? @map("valid_until") @db.Timestamptz
  receivedAt        DateTime  @map("received_at") @db.Timestamptz
  retainUntil       DateTime  @map("retain_until") @db.Timestamptz

  @@index([accountId, receivedAt(sort: Desc), deliveryId(sort: Desc)], map: "membership_evidence_receipts_account_received_idx")
  @@index([retainUntil], map: "membership_evidence_receipts_retention_idx")
  @@map("evidence_receipts")
  @@schema("membership_entitlements")
}

model MembershipProjection {
  accountId           String   @id @map("account_id") @db.Uuid
  principalRef        String   @unique(map: "membership_current_projections_principal_unique") @map("principal_ref") @db.VarChar(256)
  decision            String
  evidenceRef         String   @map("evidence_ref") @db.VarChar(256)
  evidenceVersion     BigInt   @map("evidence_version") @db.BigInt
  evidenceFingerprint String   @map("evidence_fingerprint") @db.Char(64)
  checkedAt           DateTime @map("checked_at") @db.Timestamptz
  validUntil          DateTime @map("valid_until") @db.Timestamptz
  updatedAt           DateTime @map("updated_at") @db.Timestamptz

  @@map("current_projections")
  @@schema("membership_entitlements")
}

model Topic {
  id   String @id @db.Uuid
  slug String @unique(map: "topics_slug_unique")
  name String

  @@map("topics")
  @@schema("materials")
}

model Format {
  id   String @id @db.Uuid
  slug String @unique(map: "formats_slug_unique")
  name String

  @@map("formats")
  @@schema("materials")
}

model Tag {
  id             String @id @db.Uuid
  name           String
  normalizedName String @unique(map: "tags_normalized_name_unique") @map("normalized_name")

  @@map("tags")
  @@schema("materials")
}

model Series {
  id   String @id @db.Uuid
  slug String @unique(map: "series_slug_unique")
  name String

  @@map("series")
  @@schema("materials")
}

model Material {
  id               String    @id @db.Uuid
  slug             String?   @unique(map: "materials_slug_unique")
  title            String?
  summary          String?
  topicId          String?   @map("topic_id") @db.Uuid
  formatId         String?   @map("format_id") @db.Uuid
  schemaVersion    Int       @map("schema_version") @db.SmallInt
  body             Json
  createdBy        String    @map("created_by") @db.Uuid
  access           String
  publicationState String    @map("publication_state")
  contentVersion   BigInt    @map("content_version") @db.BigInt
  firstPublishedAt DateTime? @map("first_published_at") @db.Timestamptz
  publishedAt      DateTime? @map("published_at") @db.Timestamptz
  publishedBy      String?   @map("published_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([id, contentVersion], map: "materials_id_content_version_unique")
  @@map("materials")
  @@schema("materials")
}

model MaterialTag {
  materialId String @map("material_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  @@id([materialId, tagId], map: "material_tags_primary")
  @@map("material_tags")
  @@schema("materials")
}

model SeriesMembership {
  seriesId   String @map("series_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  ordinal    Int

  @@id([seriesId, materialId], map: "series_memberships_primary")
  @@unique([seriesId, ordinal], map: "series_memberships_ordinal_unique")
  @@map("series_memberships")
  @@schema("materials")
}

model AuthoringIdempotency {
  actorId            String    @map("actor_id") @db.Uuid
  operation          String
  idempotencyKey     String    @map("idempotency_key")
  requestFingerprint String    @map("request_fingerprint") @db.Char(64)
  materialId         String?   @map("material_id") @db.Uuid
  contentVersion     BigInt?   @map("content_version") @db.BigInt
  publicationState   String?   @map("publication_state")
  publishedAt        DateTime? @map("published_at") @db.Timestamptz
  deleted            Boolean   @default(false)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([actorId, operation, idempotencyKey], map: "authoring_idempotency_primary")
  @@map("authoring_idempotency")
  @@schema("materials")
}

model PublishedMaterial {
  materialId     String   @id @map("material_id") @db.Uuid
  contentVersion BigInt   @map("content_version") @db.BigInt
  slug           String   @unique(map: "published_materials_slug_unique")
  title          String
  summary        String
  access         String
  topicId        String   @map("topic_id") @db.Uuid
  formatId       String   @map("format_id") @db.Uuid
  publicSearchText String @map("public_search_text")
  publishedBy    String   @map("published_by") @db.Uuid
  publishedAt    DateTime @map("published_at") @db.Timestamptz

  @@index([publishedAt(sort: Desc), materialId(sort: Desc)], map: "published_materials_cursor_idx")
  @@map("published_materials")
  @@schema("materials")
}

model PublishedMaterialTag {
  materialId String @map("material_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  @@id([materialId, tagId], map: "published_material_tags_primary")
  @@map("published_material_tags")
  @@schema("materials")
}

model PublishedMaterialSeriesMembership {
  materialId String @map("material_id") @db.Uuid
  seriesId   String @map("series_id") @db.Uuid
  ordinal    Int

  @@id([materialId, seriesId], map: "published_material_series_primary")
  @@unique([seriesId, ordinal], map: "published_material_series_ordinal_unique")
  @@map("published_material_series_memberships")
  @@schema("materials")
}

model MaterialRelatedPin {
  sourceMaterialId String @map("source_material_id") @db.Uuid
  targetMaterialId String @map("target_material_id") @db.Uuid
  ordinal          Int

  @@id([sourceMaterialId, targetMaterialId], map: "material_related_pins_primary")
  @@unique([sourceMaterialId, ordinal], map: "material_related_pins_source_ordinal_unique")
  @@index([targetMaterialId], map: "material_related_pins_target_idx")
  @@map("material_related_pins")
  @@schema("materials")
}

model MaterialSearchDocument {
  materialId     String @id @map("material_id") @db.Uuid
  contentVersion BigInt @map("content_version") @db.BigInt
  plainText      String @map("plain_text")

  @@map("material_search_documents")
  @@schema("materials")
}
