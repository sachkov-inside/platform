generator client {
  provider               = "prisma-client"
  output                 = "../src/infrastructure/prisma/generated"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity_principals", "materials"]
}

model IdentityPrincipal {
  id              String   @id @db.Uuid
  kind            String
  state           String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  securityVersion Int      @default(1) @map("security_version")

  @@map("principals")
  @@schema("identity_principals")
}

model ExternalIdentity {
  id               String   @id @db.Uuid
  principalId      String   @map("principal_id") @db.Uuid
  issuer           String
  subject          String
  emailFingerprint String?  @unique(map: "external_identities_email_fingerprint_unique") @map("email_fingerprint") @db.VarChar(67)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([issuer, subject], map: "external_identities_issuer_subject_unique")
  @@map("external_identities")
  @@schema("identity_principals")
}

model PrincipalPermission {
  principalId String   @map("principal_id") @db.Uuid
  permission  String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([principalId, permission], map: "principal_permissions_primary")
  @@map("principal_permissions")
  @@schema("identity_principals")
}

model PlatformSession {
  id              String    @id @db.Uuid
  principalId     String    @map("principal_id") @db.Uuid
  createdAt       DateTime  @map("created_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  authenticatedAt DateTime  @map("authenticated_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  securityVersion Int       @map("security_version")

  @@map("platform_sessions")
  @@schema("identity_principals")
}

model IdentityIdempotency {
  operation          String
  idempotencyKey     String    @map("idempotency_key") @db.VarChar(200)
  requestFingerprint String    @map("request_fingerprint") @db.Char(64)
  principalId        String?   @map("principal_id") @db.Uuid
  sessionId          String?   @map("session_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([operation, idempotencyKey], map: "identity_idempotency_primary")
  @@map("identity_idempotency")
  @@schema("identity_principals")
}

model IdentityReauthenticationAttempt {
  id                         String    @id @db.Uuid
  sessionId                  String    @map("session_id") @db.Uuid
  createdAt                  DateTime  @map("created_at") @db.Timestamptz
  expiresAt                  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt                 DateTime? @map("consumed_at") @db.Timestamptz
  tokenFingerprint           String?   @unique(map: "identity_reauthentication_attempts_token_fingerprint_key") @map("token_fingerprint") @db.Char(64)
  beginIdempotencyKey        String    @unique(map: "identity_reauthentication_attempts_begin_idempotency_key_key") @map("begin_idempotency_key") @db.VarChar(200)
  beginRequestFingerprint    String    @map("begin_request_fingerprint") @db.Char(64)
  completeIdempotencyKey     String?   @unique(map: "identity_reauthentication_attempts_complete_idempotency_key_key") @map("complete_idempotency_key") @db.VarChar(200)
  completeRequestFingerprint String?   @map("complete_request_fingerprint") @db.Char(64)

  @@map("identity_reauthentication_attempts")
  @@schema("identity_principals")
}

model IdentityAuditEvent {
  id          String   @id @db.Uuid
  operation   String
  outcome     String
  principalId String?  @map("principal_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("identity_audit_events")
  @@schema("identity_principals")
}

model Topic {
  id   String @id @db.Uuid
  slug String @unique(map: "topics_slug_unique")
  name String

  @@map("topics")
  @@schema("materials")
}

model Format {
  id   String @id @db.Uuid
  slug String @unique(map: "formats_slug_unique")
  name String

  @@map("formats")
  @@schema("materials")
}

model Tag {
  id             String @id @db.Uuid
  name           String
  normalizedName String @unique(map: "tags_normalized_name_unique") @map("normalized_name")

  @@map("tags")
  @@schema("materials")
}

model Series {
  id   String @id @db.Uuid
  slug String @unique(map: "series_slug_unique")
  name String

  @@map("series")
  @@schema("materials")
}

model Material {
  id                         String    @id @db.Uuid
  slug                       String    @unique(map: "materials_slug_unique")
  currentDraftRevisionId     String    @map("current_draft_revision_id") @db.Uuid
  currentPublishedRevisionId String?   @map("current_published_revision_id") @db.Uuid
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("materials")
  @@schema("materials")
}

model MaterialRevision {
  id                     String   @id @db.Uuid
  materialId             String   @map("material_id") @db.Uuid
  title                  String
  summary                String
  slug                   String
  topicId                String   @map("topic_id") @db.Uuid
  formatId               String   @map("format_id") @db.Uuid
  schemaVersion          Int      @map("schema_version") @db.SmallInt
  body                   Json
  createdBy              String   @map("created_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  access                 String
  restoredFromRevisionId String?  @map("restored_from_revision_id") @db.Uuid

  @@unique([materialId, id], map: "material_revisions_material_and_id_unique")
  @@map("material_revisions")
  @@schema("materials")
}

model MaterialTag {
  materialId String @map("material_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  @@id([materialId, tagId], map: "material_tags_primary")
  @@map("material_tags")
  @@schema("materials")
}

model SeriesMembership {
  seriesId   String @map("series_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  ordinal    Int

  @@id([seriesId, materialId], map: "series_memberships_primary")
  @@unique([seriesId, ordinal], map: "series_memberships_ordinal_unique")
  @@map("series_memberships")
  @@schema("materials")
}

model MaterialRevisionTag {
  revisionId String @map("revision_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  @@id([revisionId, tagId], map: "material_revision_tags_primary")
  @@map("material_revision_tags")
  @@schema("materials")
}

model MaterialRevisionSeriesMembership {
  revisionId String @map("revision_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  seriesId   String @map("series_id") @db.Uuid
  ordinal    Int

  @@id([revisionId, seriesId], map: "material_revision_series_primary")
  @@map("material_revision_series_memberships")
  @@schema("materials")
}

model AuthoringIdempotency {
  actorId            String    @map("actor_id") @db.Uuid
  operation          String
  idempotencyKey     String    @map("idempotency_key")
  requestFingerprint String    @map("request_fingerprint") @db.Char(64)
  materialId         String?   @map("material_id") @db.Uuid
  revisionId         String?   @map("revision_id") @db.Uuid
  publicationEventId String?   @map("publication_event_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([actorId, operation, idempotencyKey], map: "authoring_idempotency_primary")
  @@map("authoring_idempotency")
  @@schema("materials")
}

model PublishedMaterial {
  materialId String   @id @map("material_id") @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  slug       String   @unique(map: "published_materials_slug_unique")
  title      String
  summary    String
  access     String
  topicId    String   @map("topic_id") @db.Uuid
  formatId   String   @map("format_id") @db.Uuid
  publishedBy String  @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  @@unique([materialId, revisionId], map: "published_materials_material_revision_unique")
  @@index([publishedAt(sort: Desc), materialId(sort: Desc)], map: "published_materials_cursor_idx")
  @@map("published_materials")
  @@schema("materials")
}

model PublishedMaterialTag {
  materialId String @map("material_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  @@id([materialId, tagId], map: "published_material_tags_primary")
  @@map("published_material_tags")
  @@schema("materials")
}

model PublishedMaterialSeriesMembership {
  materialId String @map("material_id") @db.Uuid
  seriesId   String @map("series_id") @db.Uuid
  ordinal    Int

  @@id([materialId, seriesId], map: "published_material_series_primary")
  @@unique([seriesId, ordinal], map: "published_material_series_ordinal_unique")
  @@map("published_material_series_memberships")
  @@schema("materials")
}

model MaterialSearchDocument {
  materialId String @id @map("material_id") @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  plainText  String @map("plain_text")

  @@map("material_search_documents")
  @@schema("materials")
}

model MaterialPublicationEvent {
  id         String   @id @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  kind       String
  actorId    String   @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("material_publication_events")
  @@schema("materials")
}

model MaterialAccessAuditEvent {
  id         String   @id @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  decision   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("material_access_audit_events")
  @@schema("materials")
}
