{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema1"
    },
    "source": {
      "$ref": "#/$defs/__schema2"
    },
    "images": {
      "$ref": "#/$defs/__schema3"
    },
    "vulnerabilityWaiver": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "source",
    "images",
    "vulnerabilityWaiver"
  ],
  "additionalProperties": false,
  "title": "Inside Platform ordinal release manifest",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "inside.platform.release-manifest.v1"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "const": "sachkov-inside/platform"
        },
        "sha": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "format": "lowercase",
          "allOf": [
            {
              "pattern": "^[0-9a-fA-F]*$"
            },
            {
              "pattern": "^[^A-Z]*$"
            }
          ]
        }
      },
      "required": [
        "repository",
        "sha"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "backend": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^(ghcr\\.io\\/sachkov-inside\\/platform-backend)@sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "string",
              "format": "lowercase",
              "pattern": "^[^A-Z]*$"
            }
          ]
        },
        "web": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^(ghcr\\.io\\/sachkov-inside\\/platform-web)@sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "string",
              "format": "lowercase",
              "pattern": "^[^A-Z]*$"
            }
          ]
        }
      },
      "required": [
        "backend",
        "web"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 20,
              "maxLength": 1000
            },
            "runUrl": {
              "type": "string",
              "pattern": "^https:\\/\\/github[.]com\\/sachkov-inside\\/platform\\/actions\\/runs\\/[1-9][0-9]*$"
            }
          },
          "required": [
            "actor",
            "reason",
            "runUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "https://github.com/sachkov-inside/platform/blob/main/release/manifest.schema.json"
}
