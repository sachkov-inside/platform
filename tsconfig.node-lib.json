{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "sourceMap": true,
    "types": []
  }
}
