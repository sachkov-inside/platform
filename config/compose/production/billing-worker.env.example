NODE_ENV=production
DATABASE_URL=postgresql://platform:replace-with-a-url-encoded-password@postgres:5432/inside

# Payment contour: the same terminal as api.env. Recovery, refunds and reconciliation use it.
# All methods stay on the bank form (owner decision 15.09.2026): one-time sale needs no card-only
# confirmation, and subscription sale stays refused until both confirmations are true.
# See docs/runbooks/production-release.md#payment-contour.
TBANK_CONFIG_JSON={"environment":"production","terminalKey":"replace-with-production-terminal-key","password":"replace-with-production-terminal-password","bindingEncryptionKey":"replace-with-32-random-bytes-as-base64","recurringCardConfirmed":false,"cardOnlyHostedConfirmed":false,"minimumKopecks":100,"maximumKopecks":30000000,"returnUrl":"https://inside.sachkov.dev/subscription/return","notificationUrl":"https://inside.sachkov.dev/billing/tbank/notification","receipt":{"taxation":"usn_income","tax":"none"}}

# Receipt contact and renewal notices; the key must equal api.env and notifications-worker.env.
BILLING_CONTACT_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64
BILLING_CONTACT_SMTP_HOST=replace-with-smtp-host
BILLING_CONTACT_SMTP_PORT=587
BILLING_CONTACT_SMTP_USER=replace-with-smtp-user
BILLING_CONTACT_SMTP_PASSWORD=replace-with-smtp-password
BILLING_CONTACT_FROM=replace-with-verified-sender@inside.sachkov.dev

# Community entitlement delivery, protocol v2 only; the same values as api.env. During the joint
# rollout remove these four lines until step 9 of docs/runbooks/production-release.md.
TELEGRAM_COMMUNITY_CONTRACT_VERSION=inside.community-entitlement.v2
TELEGRAM_COMMUNITY_ENTITLEMENT_ENDPOINT=https://telegram.sachkov.dev/integrations/platform/v1/community-entitlements
TELEGRAM_COMMUNITY_ENTITLEMENT_SECRET=replace-with-a-separate-community-provider-secret
TELEGRAM_COMMUNITY_DISPATCH_SECRET=replace-with-a-separate-community-dispatch-secret
