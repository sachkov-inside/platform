NODE_ENV=production
DATABASE_URL=postgresql://platform:replace-with-a-url-encoded-password@postgres:5432/inside
MCP_HOST=0.0.0.0
MCP_PORT=3002
MCP_SERVER_URL=https://inside.sachkov.dev/mcp
LOGTO_ISSUER=https://auth.sachkov.dev/oidc
LOGTO_AUDIENCE=https://api.inside.sachkov.dev
LOGTO_JWKS_URL=https://auth.sachkov.dev/oidc/jwks
IDENTITY_EMAIL_FINGERPRINT_KEY=replace-with-at-least-32-random-characters
PUBLIC_SITE_ORIGIN=https://inside.sachkov.dev
OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-a-yandex-service-account-static-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-yandex-service-account-static-secret-key
OBJECT_STORAGE_PUBLIC_BUCKET=replace-with-a-private-public-delivery-bucket
OBJECT_STORAGE_PROTECTED_BUCKET=replace-with-a-private-protected-bucket
OBJECT_STORAGE_QUARANTINE_BUCKET=replace-with-a-private-quarantine-bucket
OBJECT_STORAGE_SIGNED_GET_TTL_SECONDS=60
MATERIAL_ASSET_ORPHAN_GRACE_SECONDS=86400
PROFILE_AVATAR_ORPHAN_GRACE_SECONDS=86400
KINESCOPE_PROVIDER_MODE=real
KINESCOPE_API_BASE_URL=https://api.kinescope.io
KINESCOPE_UPLOADER_BASE_URL=https://uploader.kinescope.io
KINESCOPE_API_TOKEN=replace-with-kinescope-api-token
KINESCOPE_PUBLIC_PROJECT_ID=replace-with-public-project-id
KINESCOPE_MEMBERSHIP_PROJECT_ID=replace-with-membership-project-id
KINESCOPE_CALLBACK_USERNAME=replace-with-callback-username
KINESCOPE_CALLBACK_PASSWORD=replace-with-at-least-16-random-characters
KINESCOPE_WEBHOOK_USERNAME=replace-with-webhook-username
KINESCOPE_WEBHOOK_PASSWORD=replace-with-at-least-16-random-characters
KINESCOPE_PLAYBACK_JWT_SECRET=replace-with-at-least-32-random-characters
KINESCOPE_PLAYBACK_JWT_TTL_SECONDS=60

# Communications and funnels: the same four values as api.env; see docs/integrations/communications-v1.md.
TELEGRAM_COMMUNICATIONS_ENDPOINT=https://telegram.sachkov.dev/integrations/platform/v1/communications
TELEGRAM_COMMUNICATIONS_SECRET=replace-with-telegram-PLATFORM_COMMUNICATIONS_SECRET-not-the-linking-secret
TELEGRAM_AUTHOR_AUTHORIZATION_SECRET=replace-with-a-separate-author-authorization-secret
TELEGRAM_COMMUNICATIONS_BOT_IDENTITY=replace-with-the-exact-provider-bot-identity
# Funnel preview and publication; must match the public WEB_BASE_URL origin.
TELEGRAM_COMMUNICATIONS_PUBLIC_ORIGIN=https://inside.sachkov.dev
TELEGRAM_TRACKING_ORIGIN=https://inside.sachkov.dev

# Owner billing tools send decided refunds and reconcile payments through the same terminal and
# contact key as api.env.
TBANK_CONFIG_JSON={"environment":"production","terminalKey":"replace-with-production-terminal-key","password":"replace-with-production-terminal-password","bindingEncryptionKey":"replace-with-32-random-bytes-as-base64","recurringCardConfirmed":false,"cardOnlyHostedConfirmed":false,"minimumKopecks":100,"maximumKopecks":30000000,"returnUrl":"https://inside.sachkov.dev/subscription/return","notificationUrl":"https://inside.sachkov.dev/billing/tbank/notification","receipt":{"taxation":"usn_income","tax":"none"}}
BILLING_CONTACT_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64
BILLING_CONTACT_SMTP_HOST=replace-with-smtp-host
BILLING_CONTACT_SMTP_PORT=587
BILLING_CONTACT_SMTP_USER=replace-with-smtp-user
BILLING_CONTACT_SMTP_PASSWORD=replace-with-smtp-password
BILLING_CONTACT_FROM=replace-with-verified-sender@inside.sachkov.dev
