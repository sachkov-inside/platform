NODE_ENV=production
DATABASE_URL=postgresql://platform:replace-with-a-url-encoded-password@postgres:5432/inside

# Four Platform broker principals on the environment vhost; see docs/runbooks/notification-transport.md.
# Each principal has its own URL-encoded password. The Telegram principal is not configured here.
NOTIFICATIONS_BROKER_URLS={"billing":"amqps://platform-billing:replace-with-billing-broker-password@rabbitmq:5671/inside-production?heartbeat=30","materials":"amqps://platform-materials:replace-with-materials-broker-password@rabbitmq:5671/inside-production?heartbeat=30","notifications":"amqps://platform-notifications:replace-with-notifications-broker-password@rabbitmq:5671/inside-production?heartbeat=30","email":"amqps://platform-email:replace-with-email-broker-password@rabbitmq:5671/inside-production?heartbeat=30"}
# Compose mounts the environment broker CA here from /etc/inside/runtime/rabbitmq/tls/ca.pem.
NOTIFICATIONS_BROKER_CA_FILE=/etc/inside/broker-ca.pem
NOTIFICATIONS_PREFETCH=4
NOTIFICATIONS_QUARANTINE_CAPACITY=1000

# The same reader origin and dispatch secret as api.env. Without them notices wait for configuration.
NOTIFICATIONS_PLATFORM_ORIGIN=https://inside.sachkov.dev
NOTIFICATIONS_TELEGRAM_SECRET=replace-with-a-separate-notification-dispatch-secret-of-32-characters

# Email delivery uses the billing contact sender; the key must equal api.env and billing-worker.env.
BILLING_CONTACT_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64
BILLING_CONTACT_SMTP_HOST=replace-with-smtp-host
BILLING_CONTACT_SMTP_PORT=587
BILLING_CONTACT_SMTP_USER=replace-with-smtp-user
BILLING_CONTACT_SMTP_PASSWORD=replace-with-smtp-password
BILLING_CONTACT_FROM=replace-with-verified-sender@inside.sachkov.dev
