NODE_ENV=production
DATABASE_URL=postgresql://platform:replace-with-a-url-encoded-password@postgres:5432/inside
KINESCOPE_PROVIDER_MODE=real
KINESCOPE_API_BASE_URL=https://api.kinescope.io
KINESCOPE_UPLOADER_BASE_URL=https://uploader.kinescope.io
KINESCOPE_API_TOKEN=replace-with-delete-capable-kinescope-api-token
KINESCOPE_PUBLIC_PROJECT_ID=replace-with-public-project-id
KINESCOPE_MEMBERSHIP_PROJECT_ID=replace-with-membership-project-id
KINESCOPE_CALLBACK_USERNAME=replace-with-callback-username
KINESCOPE_CALLBACK_PASSWORD=replace-with-at-least-16-random-characters
KINESCOPE_WEBHOOK_USERNAME=replace-with-webhook-username
KINESCOPE_WEBHOOK_PASSWORD=replace-with-at-least-16-random-characters
KINESCOPE_PLAYBACK_JWT_SECRET=replace-with-at-least-32-random-characters
KINESCOPE_PLAYBACK_JWT_TTL_SECONDS=60
