NODE_ENV=production
DATABASE_URL=postgresql://inside:replace-with-a-url-encoded-password@postgres:5432/inside
API_HOST=0.0.0.0
API_PORT=3001
LOGTO_ISSUER=https://identity.example.com/oidc
LOGTO_AUDIENCE=https://api.inside.sachkov.dev
LOGTO_JWKS_URL=https://identity.example.com/oidc/jwks
IDENTITY_EMAIL_FINGERPRINT_KEY=replace-with-at-least-32-random-characters
MEMBERSHIP_ACQUISITION_URL=https://t.me/tribute
TELEGRAM_BOT_START_URL=https://t.me/replace_with_bot_username
TELEGRAM_LINKING_ENDPOINT=https://telegram.example.com/integrations/platform/v1/identity-links
TELEGRAM_LINKING_SECRET=replace-with-a-base64url-linking-secret
TELEGRAM_EVIDENCE_INGRESS_SECRET=replace-with-a-base64url-evidence-secret
TELEGRAM_LINK_LIFETIME_SECONDS=300
OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-a-yandex-service-account-static-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-yandex-service-account-static-secret-key
OBJECT_STORAGE_PUBLIC_BUCKET=replace-with-a-private-public-delivery-bucket
OBJECT_STORAGE_PROTECTED_BUCKET=replace-with-a-private-protected-bucket
OBJECT_STORAGE_QUARANTINE_BUCKET=replace-with-a-private-quarantine-bucket
OBJECT_STORAGE_SIGNED_GET_TTL_SECONDS=60
MATERIAL_ASSET_ORPHAN_GRACE_SECONDS=86400
PROFILE_AVATAR_ORPHAN_GRACE_SECONDS=86400
KINESCOPE_PROVIDER_MODE=real
KINESCOPE_API_BASE_URL=https://api.kinescope.io
KINESCOPE_UPLOADER_BASE_URL=https://uploader.kinescope.io
KINESCOPE_API_TOKEN=replace-with-delete-capable-kinescope-api-token
KINESCOPE_PUBLIC_PROJECT_ID=replace-with-public-project-id
KINESCOPE_MEMBERSHIP_PROJECT_ID=replace-with-membership-project-id
KINESCOPE_CALLBACK_USERNAME=replace-with-callback-username
KINESCOPE_CALLBACK_PASSWORD=replace-with-at-least-16-random-characters
KINESCOPE_WEBHOOK_USERNAME=replace-with-webhook-username
KINESCOPE_WEBHOOK_PASSWORD=replace-with-at-least-16-random-characters
KINESCOPE_PLAYBACK_JWT_SECRET=replace-with-at-least-32-random-characters
KINESCOPE_PLAYBACK_JWT_TTL_SECONDS=60
