# Вход стенда. Порт внутри контейнера совпадает с опубликованным: адрес входа один и тот же
# и для браузера, и для приложения внутри сети Compose, иначе issuer токена не сошёлся бы.
PORT=3301
ADMIN_PORT=3302
ENDPOINT=https://identity.inside.localhost:3301
ADMIN_ENDPOINT=https://identity.inside.localhost:3302
DB_URL=postgres://logto:inside-local@logto-postgres:5432/logto
HTTPS_CERT_PATH=/identity-tls/certificate.pem
HTTPS_KEY_PATH=/identity-tls/private-key.pem
TRUST_PROXY_HEADER=0
