NODE_ENV=development
DATABASE_URL=postgresql://inside:inside@postgres:5432/inside
# Продление и возврат идут тем же контуром, что покупка: двойник банка на стенде.
# Настоящий терминал (TBANK_CONFIG_JSON) принадлежит #402/#413 и здесь отсутствует.
TBANK_PROVIDER_MODE=test
TBANK_TEST_API_BASE_URL=http://bank-double:8090/v2
TBANK_TEST_NOTIFICATION_URL=http://api:3001/billing/tbank/notification
# Ключ тот же, что у API: продление читает сохранённый подтверждённый адрес.
BILLING_CONTACT_ENCRYPTION_KEY=aW5zaWRlLWxvY2FsLWJpbGxpbmctY29udGFjdC1rZXk=
BILLING_CONTACT_SMTP_HOST=mailpit
BILLING_CONTACT_SMTP_PORT=1025
BILLING_CONTACT_FROM=no-reply@inside.localhost
BILLING_CONTACT_SMTP_LOCAL_CAPTURE=true
