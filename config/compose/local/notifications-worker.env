NOTIFICATIONS_BROKER_URLS={"billing":"amqps://local-billing:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5","materials":"amqps://local-materials:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5","notifications":"amqps://local-notifications:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5","email":"amqps://local-email:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5"}
NOTIFICATIONS_PREFETCH=4
NOTIFICATIONS_QUARANTINE_CAPACITY=1000
