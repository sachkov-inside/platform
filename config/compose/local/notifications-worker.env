NODE_ENV=development
DATABASE_URL=postgresql://inside:inside@postgres:5432/inside
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_ACCESS_KEY_ID=inside-local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=inside-local-secret-key
NOTIFICATIONS_BROKER_CA_FILE=/local-ca/ca.pem
NOTIFICATIONS_BROKER_URLS={"billing":"amqps://local-billing:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5","materials":"amqps://local-materials:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5","notifications":"amqps://local-notifications:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5","email":"amqps://local-email:inside-local-only@rabbitmq:5671/inside-local?heartbeat=5"}
NOTIFICATIONS_PREFETCH=4
NOTIFICATIONS_QUARANTINE_CAPACITY=1000
# Уведомления ведут читателя на стенд: адрес петли, потому что сертификата у стенда нет.
# Без этого адреса повод оплаты ждёт настройки доставки и письма не уходят.
NOTIFICATIONS_PLATFORM_ORIGIN=http://127.0.0.1:3000
NOTIFICATIONS_TELEGRAM_SECRET=inside-local-notification-dispatch-secret
# Письма уведомлений уходят в тот же перехватчик, что и коды подтверждения адреса.
BILLING_CONTACT_ENCRYPTION_KEY=aW5zaWRlLWxvY2FsLWJpbGxpbmctY29udGFjdC1rZXk=
BILLING_CONTACT_SMTP_HOST=mailpit
BILLING_CONTACT_SMTP_PORT=1025
BILLING_CONTACT_FROM=no-reply@inside.localhost
BILLING_CONTACT_SMTP_LOCAL_CAPTURE=true
