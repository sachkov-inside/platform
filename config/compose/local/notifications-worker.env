NODE_ENV=development
DATABASE_URL=postgresql://inside:inside@postgres:5432/inside
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_ACCESS_KEY_ID=inside-local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=inside-local-secret-key
