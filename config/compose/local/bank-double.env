NODE_ENV=development
TBANK_PROVIDER_MODE=test
TBANK_TEST_API_BASE_URL=http://bank-double:8090/v2
TBANK_TEST_NOTIFICATION_URL=http://api:3001/billing/tbank/notification
# Внутри контейнера двойник слушает все адреса; наружу его публикует только петля Compose.
BANK_DOUBLE_HOST=0.0.0.0
# Журнал двойника переживает его перезапуск: банк не забывает начатый платёж.
BANK_DOUBLE_LEDGER=/data/bank-double.json
