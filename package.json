{
  "name": "@inside/platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @inside/web --filter @inside/backend dev",
    "dev:web": "pnpm --filter @inside/web dev",
    "dev:api": "pnpm --filter @inside/backend dev:api",
    "dev:mcp": "pnpm --filter @inside/backend dev:mcp",
    "dev:video-deletions-worker": "pnpm --filter @inside/backend dev:video-deletions-worker",
    "storybook": "pnpm --filter @inside/web storybook",
    "platform:doctor": "bash scripts/doctor.sh",
    "identity:proof:certs": "node scripts/identity-proof-certificates.mjs",
    "identity:proof:build": "docker compose --env-file infra/identity/logto/compose.env -f infra/identity/logto/compose.yaml build logto",
    "identity:proof:bootstrap": "NODE_EXTRA_CA_CERTS=.identity-proof/tls/certificate.pem node scripts/identity-proof-bootstrap.mjs",
    "identity:proof:email-smoke": "NODE_EXTRA_CA_CERTS=.identity-proof/tls/certificate.pem node scripts/identity-proof-bootstrap.mjs --email-smoke",
    "identity:proof:up": "pnpm identity:proof:certs && docker compose --env-file infra/identity/logto/compose.env -f infra/identity/logto/compose.yaml up -d --wait && pnpm identity:proof:bootstrap",
    "identity:proof:down": "docker compose --env-file infra/identity/logto/compose.env -f infra/identity/logto/compose.yaml down",
    "identity:proof:dev": "node scripts/identity-proof-dev.mjs",
    "identity:proof:start": "node scripts/identity-proof-start.mjs",
    "identity:proof:hardening": "node scripts/identity-hardening-proof.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "build": "pnpm --recursive --if-present build",
    "api:generate": "pnpm --filter @inside/backend openapi:generate && pnpm --filter @inside/web openapi:generate",
    "api:check": "pnpm --filter @inside/backend openapi:check && pnpm --filter @inside/web openapi:check",
    "docs:check": "node scripts/check-agent-documentation.mjs",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives --ignore-pattern 'apps/backend/test/guardrails/fixtures/oxlint/**' .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "guardrails": "pnpm --filter @inside/backend guardrails && pnpm --filter @inside/web guardrails",
    "test": "pnpm test:tooling && pnpm --recursive --if-present test",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:integration": "pnpm --filter @inside/backend test:integration",
    "test:e2e": "pnpm --filter @inside/web test:e2e",
    "test:storybook": "pnpm --filter @inside/web test:storybook",
    "evidence:web": "pnpm --filter @inside/web test:evidence",
    "build:storybook": "pnpm --filter @inside/web build-storybook",
    "check": "pnpm docs:check && pnpm api:check && pnpm lint && pnpm typecheck && pnpm guardrails && pnpm test && pnpm test:e2e && pnpm build && pnpm --filter @inside/web test:standalone-config && pnpm build:storybook",
    "compose:up": "docker compose up -d --build --wait",
    "compose:smoke": "bash scripts/compose-stack-smoke.sh",
    "compose:production:smoke": "bash scripts/production-compose-smoke.sh",
    "release:images:smoke": "bash scripts/release-image-smoke.sh",
    "release:dry-run": "bash scripts/release-dry-run.sh",
    "conformance:telegram-membership": "pnpm --filter @inside/backend conformance:telegram-membership",
    "infra:up": "docker compose up -d --wait postgres object-storage",
    "infra:down": "docker compose down",
    "smoke:health": "pnpm --filter @inside/backend smoke:health",
    "smoke:fullstack": "node scripts/full-stack-smoke.mjs",
    "check:full": "pnpm check && pnpm test:integration && pnpm smoke:fullstack"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@logto/node": "3.1.10",
    "jose": "6.2.10",
    "oxc-parser": "0.147.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "proper-lockfile": "4.1.2",
    "typescript": "7.0.2"
  }
}
