{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "prompt_input_exit|logout|other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-cleanup.mjs\" --session-end",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
