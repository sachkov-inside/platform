{
  "name": "@inside/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./community-members-without-right": {
      "types": "./dist/community-result/members-without-right.d.ts",
      "default": "./dist/community-result/members-without-right.js"
    },
    "./*": "./*",
    "./community-result": {
      "types": "./dist/community-result/codec.d.ts",
      "default": "./dist/community-result/codec.js"
    },
    "./telegram-contact": {
      "types": "./dist/runtime/telegram-contact.d.ts",
      "default": "./dist/runtime/telegram-contact.js"
    },
    "./published-catalog": {
      "types": "./dist/runtime/published-catalog.d.ts",
      "default": "./dist/runtime/published-catalog.js"
    },
    "./payment-audit": {
      "types": "./dist/runtime/payment-audit.d.ts",
      "default": "./dist/runtime/payment-audit.js"
    }
  },
  "files": [
    "**/*.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
