data: {"jsonrpc":"2.0","id":5,"result":{"content":[{"type":"text","text":"# MaterialReaderView\n\nID: pages-material-reader-quiz\n\nClient-safe presentation shared by the production RSC route and Storybook.\n\n## Stories\n\n### Unanswered\n\nStory ID: pages-material-reader-quiz--unanswered\n\n```\nimport { MaterialReaderView } from '@inside/web';\nimport { readerBlocks } from '@/storybook/quiz-content';\n\nconst Unanswered = () => <MaterialReaderView\n    body={readerBlocks.flatMap((block): RenderedBlock[] =>\n      block.kind === \"markdown\"\n        ? prose(block.markdown)\n        : [\n            {\n              kind: \"quiz\",\n              id: block.id,\n              prompt: prose(block.promptMarkdown),\n              correctOptionId: block.correctOptionId,\n              options: block.options.map((option) => ({\n                id: option.id,\n                content: prose(option.markdown),\n                explanation: prose(option.explanationMarkdown),\n              })),\n              dontKnow: {\n                explanation: prose(block.dontKnow.explanationMarkdown),\n                reviewLinks: block.dontKnow.reviewLinks,\n              },\n            },\n          ],\n    )}\n    primaryVideo={null}\n    material={{\n      materialId: \"02000000-0000-4000-8000-000000001283\",\n      contentVersion: 1,\n      access: \"free\",\n      cover: null,\n      format: { name: \"Гайд\", slug: \"guide\" },\n      difficulty: \"basic\",\n      outcomes: [],\n      publishedAt: \"2026-10-09T09:00:00.000Z\",\n      seriesMemberships: [],\n      slug: \"quiz-proof\",\n      summary:\n        \"Учебная фикстура: как поставить агенту задачу и проверить результат.\",\n      tags: [],\n      title: \"Задача начинается с результата\",\n      topic: { name: \"AI-first engineering\", slug: \"ai-first-engineering\" },\n    }} />;\n```\n\n### Correct\n\nStory ID: pages-material-reader-quiz--correct\n\n```\nimport { MaterialReaderView } from '@inside/web';\nimport { readerBlocks } from '@/storybook/quiz-content';\n\nconst Correct = () => <MaterialReaderView\n    body={readerBlocks.flatMap((block): RenderedBlock[] =>\n      block.kind === \"markdown\"\n        ? prose(block.markdown)\n        : [\n            {\n              kind: \"quiz\",\n              id: block.id,\n              prompt: prose(block.promptMarkdown),\n              correctOptionId: block.correctOptionId,\n              options: block.options.map((option) => ({\n                id: option.id,\n                content: prose(option.markdown),\n                explanation: prose(option.explanationMarkdown),\n              })),\n              dontKnow: {\n                explanation: prose(block.dontKnow.explanationMarkdown),\n                reviewLinks: block.dontKnow.reviewLinks,\n              },\n            },\n          ],\n    )}\n    primaryVideo={null}\n    material={{\n      materialId: \"02000000-0000-4000-8000-000000001283\",\n      contentVersion: 1,\n      access: \"free\",\n      cover: null,\n      format: { name: \"Гайд\", slug: \"guide\" },\n      difficulty: \"basic\",\n      outcomes: [],\n      publishedAt: \"2026-10-09T09:00:00.000Z\",\n      seriesMemberships: [],\n      slug: \"quiz-proof\",\n      summary:\n        \"Учебная фикстура: как поставить агенту задачу и проверить результат.\",\n      tags: [],\n      title: \"Задача начинается с результата\",\n      topic: { name: \"AI-first engineering\", slug: \"ai-first-engineering\" },\n    }} />;\n```\n\n### Incorrect\n\nStory ID: pages-material-reader-quiz--incorrect\n\n```\nimport { MaterialReaderView } from '@inside/web';\nimport { readerBlocks } from '@/storybook/quiz-content';\n\nconst Incorrect = () => <MaterialReaderView\n    body={readerBlocks.flatMap((block): RenderedBlock[] =>\n      block.kind === \"markdown\"\n        ? prose(block.markdown)\n        : [\n            {\n              kind: \"quiz\",\n              id: block.id,\n              prompt: prose(block.promptMarkdown),\n              correctOptionId: block.correctOptionId,\n              options: block.options.map((option) => ({\n                id: option.id,\n                content: prose(option.markdown),\n                explanation: prose(option.explanationMarkdown),\n              })),\n              dontKnow: {\n                explanation: prose(block.dontKnow.explanationMarkdown),\n                reviewLinks: block.dontKnow.reviewLinks,\n              },\n            },\n          ],\n    )}\n    primaryVideo={null}\n    material={{\n      materialId: \"02000000-0000-4000-8000-000000001283\",\n      contentVersion: 1,\n      access: \"free\",\n      cover: null,\n      format: { name: \"Гайд\", slug: \"guide\" },\n      difficulty: \"basic\",\n      outcomes: [],\n      publishedAt: \"2026-10-09T09:00:00.000Z\",\n      seriesMemberships: [],\n      slug: \"quiz-proof\",\n      summary:\n        \"Учебная фикстура: как поставить агенту задачу и проверить результат.\",\n      tags: [],\n      title: \"Задача начинается с результата\",\n      topic: { name: \"AI-first engineering\", slug: \"ai-first-engineering\" },\n    }} />;\n```\n\n### Other Stories\n\n- Dont Know (pages-material-reader-quiz--dont-know)\n- All Explanations (pages-material-reader-quiz--all-explanations)\n\n## Props\n\n```\nexport type Props = {\n  /**\n    \n  */\n  body: unknown;\n  /**\n    \n  */\n  material: MaterialReaderMetadata;\n  /**\n    \n  */\n  primaryVideo: PrimaryVideoPresentation | null;\n  /**\n    \n  */\n  returnTarget?: MaterialReaderReturnTarget = Object.freeze({\n  href: internalRoute(\"/\"),\n  kind: \"home\",\n  label: \"Назад на Главную\",\n});\n  /**\n    \n  */\n  seriesContext?: SeriesReaderContext | null = null;\n  /**\n    \n  */\n  readingAction?: ReactNode;\n  /**\n    \n  */\n  bookmarkAction?: ReactNode;\n  /**\n    \n  */\n  practiceActions?: ReactNode;\n  /**\n    Подсказка о двух режимах и место, куда она встаёт: перед шагом с этим номером. Место выбирает\nстраница, потому что подсказка должна стоять у шага, который читатель действительно видит.\n  */\n  modeHint?: { readonly at: number; readonly node: ReactNode };\n  /**\n    Переключатель режима прохождения; у руководства без вариантных шагов его нет.\n  */\n  modeSwitch?: ReactNode;\n}\n```"}]}}

