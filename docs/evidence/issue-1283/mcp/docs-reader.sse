data: {"jsonrpc":"2.0","id":6,"result":{"content":[{"type":"text","text":"# MaterialReaderView\n\nID: pages-material-reader\n\nClient-safe presentation shared by the production RSC route and Storybook.\n\n## Stories\n\n### Ordered List Start\n\nStory ID: pages-material-reader--ordered-list-start\n\n```\nimport {\n  LearningPracticePrompts,\n  MaterialReaderAccess,\n  MaterialReaderLoading,\n  MaterialReaderNotFound,\n  MaterialReaderUnavailable,\n  MaterialReaderUnexpectedError,\n  MaterialReaderView,\n  ProductModeHint,\n  ProductModeProvider,\n  ProductModeSwitch,\n  ReadingProgressProvider,\n  SavedBookmarkAction,\n  SavedReadingAction,\n} from '@inside/web';\nimport { numberedListBlocks } from '@/storybook/material-list-start';\nimport { parseMaterialReaderReturnTarget, materialReaderHref } from '@/shared/routing/material-reader';\nimport { calloutTones } from '@/entities/material';\nimport { variantDiagram } from '@/storybook/image-variants';\n\nconst OrderedListStart = () => <MaterialReaderView\n    body={numberedListBlocks}\n    material={{\n      materialId: \"02000000-0000-4000-8000-000000000010\",\n      contentVersion: 7,\n      access: \"free\",\n      cover: {\n        coverId: \"02000000-0000-4000-8000-000000000011\",\n        renditions: [{ height: 540, width: 960 }],\n      },\n      format: { name: \"Гайд\", slug: \"guide\" },\n      difficulty: \"intermediate\",\n      outcomes: [\n        \"Собрать повторяемый skill из готового процесса\",\n        \"Проверить его на одном реальном прогоне\",\n      ],\n      publishedAt: \"2026-08-25T05:00:00.000Z\",\n      seriesMemberships: [\n        {\n          ordinal: 5,\n          series: { name: \"Создание Platform Inside\", slug: \"platform-inside\" },\n        },\n      ],\n      slug: \"agent-first-skills\",\n      summary:\n        \"Как превратить повторяемый инженерный процесс в короткую repository-owned инструкцию, которую человек и агент выполняют одинаково.\",\n      tags: [{ name: \"agent skills\" }, { name: \"harness\" }],\n      title: \"Публичные skills для agent-first setup\",\n      topic: { name: \"AI-first engineering\", slug: \"ai-first-engineering\" },\n    }}\n    primaryVideo={null} />;\n```\n\n### Ordered List Start Mobile\n\nStory ID: pages-material-reader--ordered-list-start-mobile\n\n```\nimport {\n  LearningPracticePrompts,\n  MaterialReaderAccess,\n  MaterialReaderLoading,\n  MaterialReaderNotFound,\n  MaterialReaderUnavailable,\n  MaterialReaderUnexpectedError,\n  MaterialReaderView,\n  ProductModeHint,\n  ProductModeProvider,\n  ProductModeSwitch,\n  ReadingProgressProvider,\n  SavedBookmarkAction,\n  SavedReadingAction,\n} from '@inside/web';\nimport { numberedListBlocks } from '@/storybook/material-list-start';\nimport { parseMaterialReaderReturnTarget, materialReaderHref } from '@/shared/routing/material-reader';\nimport { calloutTones } from '@/entities/material';\nimport { variantDiagram } from '@/storybook/image-variants';\n\nconst OrderedListStartMobile = () => <MaterialReaderView\n    body={numberedListBlocks}\n    material={{\n      materialId: \"02000000-0000-4000-8000-000000000010\",\n      contentVersion: 7,\n      access: \"free\",\n      cover: {\n        coverId: \"02000000-0000-4000-8000-000000000011\",\n        renditions: [{ height: 540, width: 960 }],\n      },\n      format: { name: \"Гайд\", slug: \"guide\" },\n      difficulty: \"intermediate\",\n      outcomes: [\n        \"Собрать повторяемый skill из готового процесса\",\n        \"Проверить его на одном реальном прогоне\",\n      ],\n      publishedAt: \"2026-08-25T05:00:00.000Z\",\n      seriesMemberships: [\n        {\n          ordinal: 5,\n          series: { name: \"Создание Platform Inside\", slug: \"platform-inside\" },\n        },\n      ],\n      slug: \"agent-first-skills\",\n      summary:\n        \"Как превратить повторяемый инженерный процесс в короткую repository-owned инструкцию, которую человек и агент выполняют одинаково.\",\n      tags: [{ name: \"agent skills\" }, { name: \"harness\" }],\n      title: \"Публичные skills для agent-first setup\",\n      topic: { name: \"AI-first engineering\", slug: \"ai-first-engineering\" },\n    }}\n    primaryVideo={null} />;\n```\n\n### Mobile\n\nStory ID: pages-material-reader--mobile\n\n```\nimport {\n  LearningPracticePrompts,\n  MaterialReaderAccess,\n  MaterialReaderLoading,\n  MaterialReaderNotFound,\n  MaterialReaderUnavailable,\n  MaterialReaderUnexpectedError,\n  MaterialReaderView,\n  ProductModeHint,\n  ProductModeProvider,\n  ProductModeSwitch,\n  ReadingProgressProvider,\n  SavedBookmarkAction,\n  SavedReadingAction,\n} from '@inside/web';\nimport { numberedListBlocks } from '@/storybook/material-list-start';\nimport { parseMaterialReaderReturnTarget, materialReaderHref } from '@/shared/routing/material-reader';\nimport { calloutTones } from '@/entities/material';\nimport { variantDiagram } from '@/storybook/image-variants';\n\nconst Mobile = () => <MaterialReaderView\n    body={[\n      {\n        kind: \"paragraph\",\n        content: [\n          {\n            kind: \"text\",\n            text: \"Хороший skill начинается с повторяемого решения и проверяемого результата.\",\n            marks: [{ kind: \"bold\" }],\n          },\n        ],\n      },\n      {\n        kind: \"heading\",\n        level: 2,\n        content: [\n          { kind: \"text\", text: \"Сначала найдите устойчивый seam\", marks: [] },\n        ],\n      },\n      {\n        kind: \"paragraph\",\n        content: [\n          {\n            kind: \"text\",\n            text: \"Запишите вход, observable result и границу ответственности.\",\n            marks: [],\n          },\n        ],\n      },\n      {\n        kind: \"bullet_list\",\n        items: [\n          [\n            {\n              kind: \"paragraph\",\n              content: [{ kind: \"text\", text: \"Один authority\", marks: [] }],\n            },\n          ],\n          [\n            {\n              kind: \"paragraph\",\n              content: [{ kind: \"text\", text: \"Один workflow\", marks: [] }],\n            },\n          ],\n          [\n            {\n              kind: \"paragraph\",\n              content: [{ kind: \"text\", text: \"Одна проверка\", marks: [] }],\n            },\n          ],\n        ],\n      },\n      {\n        kind: \"callout\",\n        tone: \"warning\",\n        content: [\n          {\n            kind: \"paragraph\",\n            content: [\n              {\n                kind: \"text\",\n                text: \"Skill дополняет project rules, но не отменяет их.\",\n                marks: [],\n              },\n            ],\n          },\n        ],\n      },\n      {\n        kind: \"code_block\",\n        text: \"export const isReady = (evidence: readonly string[]) => evidence.length > 0\",\n      },\n      {\n        kind: \"heading\",\n        level: 3,\n        content: [\n          {\n            kind: \"text\",\n            text: \"Проверьте instruction на двух задачах\",\n            marks: [],\n          },\n        ],\n      },\n      {\n        kind: \"table\",\n        rows: [\n          {\n            cells: [\n              {\n                header: true,\n                content: [\n                  {\n                    kind: \"paragraph\",\n                    content: [{ kind: \"text\", text: \"Признак\", marks: [] }],\n                  },\n                ],\n              },\n              {\n                header: true,\n                content: [\n                  {\n                    kind: \"paragraph\",\n                    content: [{ kind: \"text\", text: \"Evidence\", marks: [] }],\n                  },\n                ],\n              },\n            ],\n          },\n          {\n            cells: [\n              {\n                header: false,\n                content: [\n                  {\n                    kind: \"paragraph\",\n                    content: [{ kind: \"text\", text: \"Trigger\", marks: [] }],\n                  },\n                ],\n              },\n              {\n                header: false,\n                content: [\n                  {\n                    kind: \"paragraph\",\n                    content: [\n                      { kind: \"text\", text: \"Две реальные задачи\", marks: [] },\n                    ],\n                  },\n                ],\n              },\n            ],\n          },\n        ],\n      },\n      {\n        kind: \"image\",\n        assetId: \"image-agent-path\",\n        alt: \"Маршрут от project rules через skill к evidence\",\n        caption: \"Один authority, один workflow, одна проверка\",\n        height: 900,\n        variants: [\n          { height: 450, width: 480 },\n          { height: 900, width: 960 },\n        ],\n        width: 960,\n      },\n      {\n        kind: \"file\",\n        assetId: \"skill-review-checklist\",\n        label: \"Чек-лист проверки repository-owned skill\",\n      },\n    ]}\n    material={{\n      materialId: \"02000000-0000-4000-8000-000000000010\",\n      contentVersion: 7,\n      access: \"free\",\n      cover: {\n        coverId: \"02000000-0000-4000-8000-000000000011\",\n        renditions: [{ height: 540, width: 960 }],\n      },\n      format: { name: \"Гайд\", slug: \"guide\" },\n      difficulty: \"intermediate\",\n      outcomes: [\n        \"Собрать повторяемый skill из готового процесса\",\n        \"Проверить его на одном реальном прогоне\",\n      ],\n      publishedAt: \"2026-08-25T05:00:00.000Z\",\n      seriesMemberships: [\n        {\n          ordinal: 5,\n          series: { name: \"Создание Platform Inside\", slug: \"platform-inside\" },\n        },\n      ],\n      slug: \"agent-first-skills\",\n      summary:\n        \"Как превратить повторяемый инженерный процесс в короткую repository-owned инструкцию, которую человек и агент выполняют одинаково.\",\n      tags: [{ name: \"agent skills\" }, { name: \"harness\" }],\n      title: \"Публичные skills для agent-first setup\",\n      topic: { name: \"AI-first engineering\", slug: \"ai-first-engineering\" },\n    }}\n    primaryVideo={null} />;\n```\n\n### Other Stories\n\n- Mobile · batched intersections (pages-material-reader--mobile-batched-intersection): Replays an initial visible entry queued together with the first scroll-out entry.\n- Desktop (pages-material-reader--desktop)\n- Image Viewer (pages-material-reader--image-viewer): Картинка урока открывается на весь экран, приближается и возвращает фокус после закрытия.\n- Image Viewer Failed (pages-material-reader--image-viewer-failed): Если крупная картинка не загрузилась, окно предлагает загрузить её снова, а не тупик.\n- Image Viewer Backdrop Close (pages-material-reader--image-viewer-backdrop-close): Нажатие на фон окна без приближения закрывает просмотр.\n- Image Viewer Mobile (pages-material-reader--image-viewer-mobile): На телефоне просмотр занимает весь экран; история оставляет его открытым и приближенным.\n- Video Processing (pages-material-reader--video-processing)\n- Video Failed (pages-material-reader--video-failed)\n- Loading (pages-material-reader--loading)\n- Playlist Return (pages-material-reader--playlist-return)\n- Not Found (pages-material-reader--not-found)\n- Access Required (pages-material-reader--access-required)\n- Access Required Mobile (pages-material-reader--access-required-mobile): Тот же отказ на телефоне: заголовок, объяснение и одно действие остаются читаемыми.\n- Access Product Purchase (pages-material-reader--access-product-purchase): Закрытый материал руководства со своей ценой: дальше идёт оплата именно этого руководства.\n- Access Not Offered (pages-material-reader--access-not-offered): Продажа выключена: обещания купить нет, материал честно остаётся на месте.\n- Unavailable (pages-material-reader--unavailable)\n- Unexpected Error (pages-material-reader--unexpected-error)\n- Short Material (pages-material-reader--short-material)\n- Lesson Blocks (pages-material-reader--lesson-blocks)\n- Lesson Blocks Mobile (pages-material-reader--lesson-blocks-mobile)\n- Lesson Blocks Long (pages-material-reader--lesson-blocks-long)\n- Lesson Blocks Empty (pages-material-reader--lesson-blocks-empty)\n- Product Modes (pages-material-reader--product-modes)\n- Product Modes Switched (pages-material-reader--product-modes-switched)\n- Product Modes Other Branch (pages-material-reader--product-modes-other-branch)\n- Product Modes Mobile (pages-material-reader--product-modes-mobile)\n- Product Without Modes (pages-material-reader--product-without-modes)\n- Source Anchors (pages-material-reader--source-anchors)\n- Source Anchors Mobile (pages-material-reader--source-anchors-mobile)\n- Source Anchor Metadata Collision (pages-material-reader--source-anchor-metadata-collision)\n- Source Anchor Legacy Collision (pages-material-reader--source-anchor-legacy-collision): The owner chose the Content source address when a legacy alias conflicts.\n- Source Anchor Shell Collision (pages-material-reader--source-anchor-shell-collision): Shell IDs use punctuation that Content source slugs cannot produce.\n- Image Variants (pages-material-reader--image-variants)\n- Image Variants Mobile (pages-material-reader--image-variants-mobile)\n- Collapsible Advice (pages-material-reader--collapsible-advice)\n- Collapsible Advice Mobile (pages-material-reader--collapsible-advice-mobile)\n\n## Props\n\n```\nexport type Props = {\n  /**\n    \n  */\n  body: unknown;\n  /**\n    \n  */\n  material: MaterialReaderMetadata;\n  /**\n    \n  */\n  primaryVideo: PrimaryVideoPresentation | null;\n  /**\n    \n  */\n  returnTarget?: MaterialReaderReturnTarget = Object.freeze({\n  href: internalRoute(\"/\"),\n  kind: \"home\",\n  label: \"Назад на Главную\",\n});\n  /**\n    \n  */\n  seriesContext?: SeriesReaderContext | null = null;\n  /**\n    \n  */\n  readingAction?: ReactNode;\n  /**\n    \n  */\n  bookmarkAction?: ReactNode;\n  /**\n    \n  */\n  practiceActions?: ReactNode;\n  /**\n    Подсказка о двух режимах и место, куда она встаёт: перед шагом с этим номером. Место выбирает\nстраница, потому что подсказка должна стоять у шага, который читатель действительно видит.\n  */\n  modeHint?: { readonly at: number; readonly node: ReactNode };\n  /**\n    Переключатель режима прохождения; у руководства без вариантных шагов его нет.\n  */\n  modeSwitch?: ReactNode;\n}\n```"}]}}

