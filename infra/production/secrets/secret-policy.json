{
  "schemaVersion": 1,
  "minimumAgeRecipients": 2,
  "services": {
    "api": {
      "file": "api.env",
      "secrets": {
        "IDENTITY_EMAIL_FINGERPRINT_KEY": "identityEmailFingerprintKey",
        "KINESCOPE_API_TOKEN": "kinescopeApiToken",
        "KINESCOPE_CALLBACK_PASSWORD": "kinescopeCallbackPassword",
        "KINESCOPE_PLAYBACK_JWT_SECRET": "kinescopePlaybackJwtSecret",
        "KINESCOPE_WEBHOOK_PASSWORD": "kinescopeWebhookPassword",
        "OBJECT_STORAGE_ACCESS_KEY_ID": "assetStorageAccessKeyId",
        "OBJECT_STORAGE_SECRET_ACCESS_KEY": "assetStorageSecretAccessKey",
        "TELEGRAM_EVIDENCE_INGRESS_SECRET": "telegramEvidenceIngressSecret",
        "TELEGRAM_LINKING_SECRET": "telegramLinkingSecret"
      }
    },
    "logto": {
      "file": "logto.env",
      "secrets": {
        "LOGTO_DATABASE_PASSWORD": "logtoDatabaseOwnerPassword",
        "SECRET_VAULT_KEK": "logtoSecretVaultKek"
      }
    },
    "logto-config": {
      "file": "logto-config.env",
      "secrets": {
        "SMTP_PASSWORD": "smtpPassword",
        "SMTP_USERNAME": "smtpUsername"
      }
    },
    "material-assets-worker": {
      "file": "material-assets-worker.env",
      "secrets": {
        "OBJECT_STORAGE_ACCESS_KEY_ID": "assetStorageAccessKeyId",
        "OBJECT_STORAGE_SECRET_ACCESS_KEY": "assetStorageSecretAccessKey"
      }
    },
    "mcp": {
      "file": "mcp.env",
      "secrets": {
        "IDENTITY_EMAIL_FINGERPRINT_KEY": "identityEmailFingerprintKey",
        "PLATFORM_DATABASE_RUNTIME_PASSWORD": "platformDatabaseRuntimePassword"
      }
    },
    "pgbackrest": {
      "file": "pgbackrest.env",
      "secrets": {
        "PGBACKREST_REPO1_CIPHER_PASS": "backupRepositoryCipherPassphrase",
        "PGBACKREST_REPO1_S3_KEY": "backupStorageAccessKeyId",
        "PGBACKREST_REPO1_S3_KEY_SECRET": "backupStorageSecretAccessKey"
      }
    },
    "postgres": {
      "file": "postgres.env",
      "secrets": {
        "LOGTO_DATABASE_OWNER_PASSWORD": "logtoDatabaseOwnerPassword",
        "PLATFORM_DATABASE_OWNER_PASSWORD": "platformDatabaseOwnerPassword",
        "PLATFORM_DATABASE_RUNTIME_PASSWORD": "platformDatabaseRuntimePassword",
        "POSTGRES_PASSWORD": "postgresSuperuserPassword"
      }
    },
    "profile-avatars-worker": {
      "file": "profile-avatars-worker.env",
      "secrets": {
        "OBJECT_STORAGE_ACCESS_KEY_ID": "assetStorageAccessKeyId",
        "OBJECT_STORAGE_SECRET_ACCESS_KEY": "assetStorageSecretAccessKey"
      }
    },
    "video-deletions-worker": {
      "file": "video-deletions-worker.env",
      "secrets": {
        "KINESCOPE_API_TOKEN": "kinescopeApiToken",
        "KINESCOPE_CALLBACK_PASSWORD": "kinescopeCallbackPassword",
        "KINESCOPE_PLAYBACK_JWT_SECRET": "kinescopePlaybackJwtSecret",
        "KINESCOPE_WEBHOOK_PASSWORD": "kinescopeWebhookPassword",
        "PLATFORM_DATABASE_RUNTIME_PASSWORD": "platformDatabaseRuntimePassword"
      }
    },
    "web": {
      "file": "web.env",
      "secrets": {
        "LOGTO_APP_SECRET": "logtoApplicationSecret",
        "LOGTO_COOKIE_SECRET": "logtoCookieSecret"
      }
    }
  }
}
