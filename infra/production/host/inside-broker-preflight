#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${INSIDE_DEPLOY_TEST_ROOT:-}" ]]; then
  [[ "$EUID" -ne 0 ]] || { echo 'Test root is forbidden for root' >&2; exit 1; }
  host_root="${INSIDE_DEPLOY_TEST_ROOT%/}"
else
  [[ "$EUID" -eq 0 ]] || { echo 'Broker preflight must run as root' >&2; exit 1; }
  host_root=""
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
fi
[[ $# -eq 1 && -f "$1" && ! -L "$1" ]] || { echo 'Expected one verified Compose file' >&2; exit 1; }
# This file is generated by the server configuration contract, never sourced as shell code.
project="$(sed -nE 's/^PLATFORM_COMPOSE_PROJECT=([a-z0-9][a-z0-9_-]*)$/\1/p' "$host_root/etc/inside/runtime/compose.env")"
[[ "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo 'Invalid server-owned Compose project' >&2; exit 1; }
expected_volume="${project}_broker-data"
# Parse YAML with Compose itself without reading env_file secrets or evaluating bundle variables.
config="$(docker compose --env-file /dev/null --project-name "$project" --file "$1" config \
  --no-interpolate --no-env-resolution --no-consistency --format json)"
jq --exit-status --slurp 'length == 1 and (.[0].services | type == "object")' <<<"$config" >/dev/null
broker_present="$(jq --raw-output '.services | has("rabbitmq")' <<<"$config")"
candidate_image="$(jq --raw-output '.services.rabbitmq.image // empty' <<<"$config")"
if [[ "$broker_present" == true ]]; then
  [[ "$candidate_image" =~ ^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$ ]] || {
    echo 'Broker image must have a literal immutable digest' >&2; exit 1;
  }
  candidate_volume="$(jq --exit-status --raw-output '
    [.services.rabbitmq.volumes[] | select(.target == "/var/lib/rabbitmq")] as $mounts |
    if ($mounts | length) == 1 and $mounts[0].type == "volume" then
      .volumes[$mounts[0].source].name
    else error("expected one broker data volume") end | select(type == "string")
  ' <<<"$config")"
  [[ "$candidate_volume" == "$expected_volume" ]] || { echo 'Broker volume differs from server-owned data' >&2; exit 1; }
fi
broker_ids="$(docker ps --all --quiet --no-trunc --filter "label=com.docker.compose.project=$project" \
  --filter label=com.docker.compose.service=rabbitmq)"
if [[ -n "$broker_ids" ]]; then
  [[ "$broker_ids" =~ ^[a-f0-9]{64}$ ]] || { echo 'Expected one broker container' >&2; exit 1; }
  [[ "$broker_present" == true ]] || { echo 'Legacy bundle without a broker requires foundation review' >&2; exit 1; }
  live_image="$(docker inspect --format '{{.Config.Image}}' "$broker_ids")"
  if [[ "$live_image" != "$candidate_image" ]]; then
    echo 'Broker image change requires a separate foundation upgrade; deploy and rollback cannot migrate broker data' >&2
    exit 1
  fi
  live_mounts="$(docker inspect --format '{{json .Mounts}}' "$broker_ids")"
  live_volume="$(jq --exit-status --raw-output '
    [.[] | select(.Destination == "/var/lib/rabbitmq")] |
    if length == 1 and .[0].Type == "volume" then .[0].Name else error("invalid live broker mount") end
  ' <<<"$live_mounts")"
  [[ "$live_volume" == "$expected_volume" ]] || { echo 'Live broker volume is not the server-owned data' >&2; exit 1; }
else
  existing_volumes="$(docker volume ls --format '{{.Name}}' --filter "name=^${expected_volume}$")"
  if [[ -n "$existing_volumes" ]]; then
    echo 'Existing broker data has no verified container image; foundation recovery is required' >&2
    exit 1
  fi
fi
