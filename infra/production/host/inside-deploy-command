#!/usr/bin/env bash
set -euo pipefail

if [[ -t 0 || -t 1 || -t 2 ]]; then
  echo "Interactive deploy sessions are not allowed" >&2
  exit 64
fi

original_command="${SSH_ORIGINAL_COMMAND:-}"
if [[ -z "$original_command" ]]; then
  echo "A versioned deploy command is required" >&2
  exit 64
fi

exec sudo -n /usr/local/libexec/inside/host-foundation.py deploy \
  --original-command "$original_command"
