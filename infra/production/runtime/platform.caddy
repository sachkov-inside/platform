sachkov.dev, inside.sachkov.dev {
	# Браузер год помнит площадку как HTTPS-only, и набранный http:// адрес не уходит в открытую сеть.
	# includeSubDomains сохраняется только на старом hostname; основной домен не расширяет эту политику.
	# Preload не включён: его отмена занимает месяцы.
	@legacy_hsts host inside.sachkov.dev
	header @legacy_hsts Strict-Transport-Security "max-age=31536000; includeSubDomains"
	@primary_hsts host sachkov.dev www.sachkov.dev
	header @primary_hsts Strict-Transport-Security "max-age=31536000"

	route {
		# Only the host's loopback verification may mark its empty bank rejection probe.
		# Match the socket peer, never a client-supplied forwarding header.
		@external_probe not remote_ip 127.0.0.1 ::1
		request_header @external_probe -X-Inside-Production-Verify
		# Метку доставки защищённых файлов ставит только маршрут @protected_delivery ниже (#1766).
		request_header -X-Inside-Storage-Delivery

		@private_health path /health /health/* /_health/*
		respond @private_health 404

		@telegram_sign_in {
			method POST
			path /integrations/telegram/v1/sign-in/linked-identity
		}
		reverse_proxy @telegram_sign_in {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@kinescope_webhook path /integrations/kinescope/v1/webhook
		reverse_proxy @kinescope_webhook {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@kinescope_authorize path /integrations/kinescope/v1/authorize
		reverse_proxy @kinescope_authorize {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Уведомление банка об оплате и возврате; подлинность проверяет подпись терминала.
		@tbank_notification {
			method POST
			path /billing/tbank/notification
		}
		reverse_proxy @tbank_notification {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Product Sales State: публичный факт без входа; бот читает состояние продаж продукта.
		@billing_product_sales_states {
			method GET
			path /billing/product-sales-states
		}
		reverse_proxy @billing_product_sales_states {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Course Activation exposes exactly five canonical operations; retired aliases fail closed.
		@telegram_activation {
			method POST
			path /integrations/telegram/v1/course-activation/binding /integrations/telegram/v1/course-activation/own-access /integrations/telegram/v1/course-activation/attempts /integrations/telegram/v1/course-activation/evidence /integrations/telegram/v1/course-activation/announcement
		}
		reverse_proxy @telegram_activation {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Служебные разрешения для Telegram: у каждого свой bearer, чужой credential получает 401.
		@community_dispatch {
			method POST
			path /internal/billing-dispatch/authorize
		}
		reverse_proxy @community_dispatch {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@notification_dispatch {
			method POST
			path /internal/notifications/dispatch/authorize
		}
		reverse_proxy @notification_dispatch {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Авторское меню бота: разрешение автора и проверка содержимого; bearer автора communications.
		@communications_authorize {
			method POST
			path /integrations/telegram/v2/communications/authorize
		}
		reverse_proxy @communications_authorize {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Активная аудитория списка ожидания: тот же отдельный bearer communications.
		@communications_waitlist {
			method POST
			path /integrations/telegram/v2/communications/waitlist
		}
		reverse_proxy @communications_waitlist {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@communications_materials {
			method POST
			path /integrations/telegram/v2/communications/materials
		}
		reverse_proxy @communications_materials {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@communications_validate {
			method POST
			path /integrations/telegram/v2/communications/validate-content
		}
		reverse_proxy @communications_validate {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# События воронки продаж от бота (#816): отдельный bearer воронки; без секрета вход закрыт.
		@sales_funnel_events {
			method POST
			path /integrations/telegram/v1/sales-funnel/events
		}
		reverse_proxy @sales_funnel_events {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Перенос из Content (#805): наружу выходит только backend /authoring/*. Bearer Logto автора и
		# право materials:manage проверяет API. Префикс не пересекается со страницами /authoring и BFF /api.
		@authoring_api path /authoring-api/authoring/*
		uri @authoring_api strip_prefix /authoring-api
		reverse_proxy @authoring_api {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@mcp {
			host inside.sachkov.dev
			path /mcp
		}
		reverse_proxy @mcp {$PLATFORM_MCP_UPSTREAM:127.0.0.1:13002}

		@mcp_metadata {
			host inside.sachkov.dev
			path /.well-known/oauth-protected-resource/mcp
		}
		reverse_proxy @mcp_metadata {$PLATFORM_MCP_UPSTREAM:127.0.0.1:13002}

		# Учебный MCP использует отдельный OAuth resource и не предоставляет авторские операции.
		@learning_mcp {
			host inside.sachkov.dev
			path /mcp/learning
		}
		reverse_proxy @learning_mcp {$PLATFORM_MCP_UPSTREAM:127.0.0.1:13002}

		@learning_mcp_metadata {
			host inside.sachkov.dev
			path /.well-known/oauth-protected-resource/mcp/learning
		}
		reverse_proxy @learning_mcp_metadata {$PLATFORM_MCP_UPSTREAM:127.0.0.1:13002}

		@private_web_telemetry path /internal/web-telemetry /internal/web-telemetry/*
		respond @private_web_telemetry 404

		@unknown_integration path /integrations/*
		respond @unknown_integration 404

		@unknown_internal path /internal/*
		respond @unknown_internal 404

		@other_mcp path /mcp /mcp/* /.well-known/oauth-protected-resource/mcp /.well-known/oauth-protected-resource/mcp/*
		respond @other_mcp 404

		# Незавершённый вход не переносит code/state и cookie между hostname.
		@old_callback {
			host inside.sachkov.dev
			path /callback
		}
		header @old_callback Cache-Control "no-store"
		redir @old_callback https://sachkov.dev/?authentication=failed 303

		@old_web host inside.sachkov.dev
		header @old_web Cache-Control "no-store"
		redir @old_web https://sachkov.dev{uri} 302

		# Защищённые файлы (#1766): картинки и файлы материалов, задания, файлы Product и аватар.
		# Web и API проверяют доступ как обычно; с меткой API вместо перенаправления в хранилище
		# отвечает 204 с подписанным адресом объекта в служебном заголовке. Caddy принимает только
		# адрес protected bucket, сам читает объект и отдаёт байты с этого домена. Cookie,
		# Authorization и X-заголовки клиента в хранилище не уходят, служебные заголовки к клиенту тоже.
		@protected_delivery {
			method GET HEAD
			path_regexp ^/api/(?:materials/[^/]+/assets/[^/]+(?:/images/[^/]+)?|products/[^/]+/(?:artifacts|artifact-sources)/[^/]+/file|products/[^/]+/tasks/[^/]+/assets/[^/]+|account/profile/avatar/[^/]+/[^/]+)$
		}
		reverse_proxy @protected_delivery {$PLATFORM_WEB_UPSTREAM:127.0.0.1:13000} {
			header_up X-Inside-Storage-Delivery edge
			header_down -X-Inside-Storage-Location
			header_down -X-Inside-Storage-Cache-Control

			@protected_object header X-Inside-Storage-Location https://inside-production-protected.storage.yandexcloud.net/*
			handle_response @protected_object {
				# route сохраняет порядок: запасной ответ 502 ниже идёт, только если адрес не подошёл.
				route {
					# Значения ответа web фиксируются до запроса в хранилище: у него свои заголовки.
					vars storage_cache_control {rp.header.X-Inside-Storage-Cache-Control}
					@no_storage_cache_control vars storage_cache_control ""
					vars @no_storage_cache_control storage_cache_control "private, no-store"
					# Обновлённую BFF сессию браузер получает и вместе с файлом.
					copy_response_headers {
						include Set-Cookie
					}
					# Байты теперь с собственного origin: файл не исполняется как страница сайта.
					header X-Content-Type-Options nosniff
					header Content-Security-Policy "default-src 'none'; sandbox"
					header X-Robots-Tag "noindex, nofollow"

					@signed_object vars_regexp signed_object {rp.header.X-Inside-Storage-Location} ^https://inside-production-protected\.storage\.yandexcloud\.net((?:/[A-Za-z0-9][A-Za-z0-9._-]*)+)\?([A-Za-z0-9._~%=&-]+)$
					# rewrite кодирует подставленную строку запроса, а подпись требует её байт в байт:
					# строка подставляется заменой подстроки, которая её не перекодирует.
					rewrite @signed_object {re.signed_object.1}?~inside-signed-query~
					uri @signed_object replace ~inside-signed-query~ {re.signed_object.2}
					reverse_proxy @signed_object {$PLATFORM_PROTECTED_STORAGE_UPSTREAM:https://inside-production-protected.storage.yandexcloud.net} {
						method GET
						header_up Host inside-production-protected.storage.yandexcloud.net
						header_up -Cookie
						header_up -Authorization
						header_up -Proxy-Authorization
						header_up -X-*
						header_up -Forwarded
						header_up -Via
						header_up -Referer
						header_up -Origin
						header_up -Sec-*
						header_up -If-Match
						header_up -If-None-Match
						header_up -If-Modified-Since
						header_up -If-Unmodified-Since
						header_down -X-*
						header_down -Server
						header_down -Set-Cookie
						header_down -Strict-Transport-Security
						header_down Cache-Control {vars.storage_cache_control}
						transport http {
							dial_timeout 5s
							response_header_timeout 30s
						}

						# Ответ хранилища с ошибкой не уходит клиенту: ни XML, ни перенаправление, ни его заголовки.
						@storage_missing status 404
						handle_response @storage_missing {
							header Cache-Control "private, no-store"
							respond 404
						}
						@storage_range status 416
						handle_response @storage_range {
							header Cache-Control "private, no-store"
							respond 416
						}
						@storage_failed status 1xx 3xx 4xx 5xx
						handle_response @storage_failed {
							header Cache-Control "private, no-store"
							respond 502
						}
					}

					header Cache-Control "private, no-store"
					respond 502
				}
			}

			# Адрес чужого bucket или хранилища не перехватывается и не уходит клиенту.
			@foreign_object header X-Inside-Storage-Location *
			handle_response @foreign_object {
				header Cache-Control "private, no-store"
				respond 502
			}
		}

		reverse_proxy {$PLATFORM_WEB_UPSTREAM:127.0.0.1:13000} {
			# Служебные заголовки доставки не выходят наружу и с других путей web.
			header_down -X-Inside-Storage-Location
			header_down -X-Inside-Storage-Cache-Control
		}
	}
}

www.sachkov.dev {
	header Strict-Transport-Security "max-age=31536000"
	route {
		header Cache-Control "no-store"
		redir https://sachkov.dev{uri} 302
	}
}
