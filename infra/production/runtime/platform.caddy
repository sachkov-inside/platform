inside.sachkov.dev {
	route {
		@private_health path /health /health/* /_health/*
		respond @private_health 404

		@telegram_evidence path /integrations/telegram/v1/membership-evidence
		reverse_proxy @telegram_evidence {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@telegram_sign_in {
			method POST
			path /integrations/telegram/v1/sign-in/linked-identity
		}
		reverse_proxy @telegram_sign_in {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@kinescope_webhook path /integrations/kinescope/v1/webhook
		reverse_proxy @kinescope_webhook {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@kinescope_authorize path /integrations/kinescope/v1/authorize
		reverse_proxy @kinescope_authorize {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Уведомление банка об оплате и возврате; подлинность проверяет подпись терминала.
		@tbank_notification {
			method POST
			path /billing/tbank/notification
		}
		reverse_proxy @tbank_notification {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Событие Tribute; подлинность проверяет HMAC исходного тела.
		@tribute_webhook {
			method POST
			path /integrations/tribute/v1/webhook
		}
		reverse_proxy @tribute_webhook {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Активация подписки ботом Telegram: ровно четыре операции протокола; отдельный bearer активации.
		@telegram_activation {
			method POST
			path /integrations/telegram/v1/subscription-activation/binding /integrations/telegram/v1/subscription-activation/own-access /integrations/telegram/v1/subscription-activation/attempts /integrations/telegram/v1/subscription-activation/evidence
		}
		reverse_proxy @telegram_activation {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Служебные разрешения для Telegram: у каждого свой bearer, чужой credential получает 401.
		@community_dispatch {
			method POST
			path /internal/billing-dispatch/authorize
		}
		reverse_proxy @community_dispatch {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@notification_dispatch {
			method POST
			path /internal/notifications/dispatch/authorize
		}
		reverse_proxy @notification_dispatch {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		# Авторское меню бота: разрешение автора и проверка содержимого; bearer автора communications.
		@communications_authorize {
			method POST
			path /integrations/telegram/v1/communications/authorize
		}
		reverse_proxy @communications_authorize {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@communications_validate {
			method POST
			path /integrations/telegram/v1/communications/validate-content
		}
		reverse_proxy @communications_validate {$PLATFORM_API_UPSTREAM:127.0.0.1:13001}

		@mcp path /mcp
		reverse_proxy @mcp {$PLATFORM_MCP_UPSTREAM:127.0.0.1:13002}

		@mcp_metadata path /.well-known/oauth-protected-resource/mcp
		reverse_proxy @mcp_metadata {$PLATFORM_MCP_UPSTREAM:127.0.0.1:13002}

		@unknown_integration path /integrations/*
		respond @unknown_integration 404

		reverse_proxy {$PLATFORM_WEB_UPSTREAM:127.0.0.1:13000}
	}
}
