#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || ! "$1" =~ ^(deploy|rollback)$ || ! "$2" =~ ^v[1-9][0-9]*$ || ! "$3" =~ ^[1-9][0-9]*$ ]]; then
  echo "usage: deploy-release <deploy|rollback> <vN> <github-run-id>" >&2
  exit 1
fi
operation="$1"
version="$2"
github_run_id="$3"
readonly rollback_window_seconds=86400
readonly caddy_config_read_budget_seconds=5

if [[ -n "${INSIDE_DEPLOY_TEST_ROOT:-}" ]]; then
  if [[ "$EUID" -eq 0 ]]; then
    echo "Test root is forbidden for a root process" >&2
    exit 1
  fi
  host_root="${INSIDE_DEPLOY_TEST_ROOT%/}"
else
  if [[ "$EUID" -ne 0 ]]; then
    echo "deploy-release must run as root" >&2
    exit 1
  fi
  host_root=""
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
release_dir="$(cd "$script_dir/../.." && pwd)"
manifest="$release_dir/release-manifest.json"
compose_file="$release_dir/runtime/compose.production.yaml"
config_dir="$host_root/etc/inside/runtime"
state_dir="$host_root/var/lib/inside/deployments"
runtime_dir="$host_root/srv/inside/runtime"
state_file="$state_dir/state.json"
operation_file="$state_dir/operation.json"
maintenance_file="$state_dir/operation-maintenance.json"
previous_written_operation_json=null
operation_history_dir="$state_dir/operation-history"
release_env_dir="$state_dir/release-environments"
phase=preflight
completed=false
operation_started=false
defer_operation_start=false
accepted_rollback_recovery=false
recovery_phase=
repair_forward=false
repair_forward_initial=false
repair_forward_phase=
repair_forward_version=
repair_forward_run_id=
repair_forward_manifest=
maintenance_started_epoch=
maintenance_ended_epoch=
maintenance_confirmed=false
operation_maintenance_confirmed=false

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

write_private_file_atomically() {
  local destination="$1"
  local temporary="${destination}.tmp.$$"
  cat >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$destination"
}

write_operation() {
  local status="$1"
  local operation_phase="$2"
  local maintenance_duration=null
  if [[ -n "$maintenance_started_epoch" ]]; then
    local measured_end="${maintenance_ended_epoch:-$(now_epoch)}"
    maintenance_duration=$((measured_end - maintenance_started_epoch))
    if ((maintenance_duration < 0)); then maintenance_duration=0; fi
  fi
  local journal_json
  journal_json="$(jq --null-input \
    --arg schemaVersion inside.platform.deployment-operation.v1 \
    --arg status "$status" \
    --arg operation "$operation" \
    --arg version "$version" \
    --arg phase "$operation_phase" \
    --arg recoveryPhase "$recovery_phase" \
    --arg repairForwardVersion "$repair_forward_version" \
    --arg repairForwardPhase "$repair_forward_phase" \
    --arg recordedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson githubRunId "$github_run_id" \
    --argjson repairForwardRunId "${repair_forward_run_id:-null}" '
    {
      schemaVersion: $schemaVersion,
      status: $status,
      operation: $operation,
      version: $version,
      phase: (if $phase == "pre-pull" then "preflight" else $phase end),
      recoveryPhase: (if $recoveryPhase == "" or $recoveryPhase == "pre-pull" then null else $recoveryPhase end),
      repairForward: (
        if $repairForwardVersion == "" then null
        else {version: $repairForwardVersion, githubRunId: $repairForwardRunId, recoveryPhase: $repairForwardPhase}
        end
      ),
      githubRunId: $githubRunId,
      recordedAt: $recordedAt
    }')"
  # Publish timing first. Either journal snapshot binds it across an interruption between
  # the two atomic renames. An unrelated write by a legacy script makes this sidecar stale.
  jq --null-input \
    --argjson journal "$journal_json" \
    --argjson previousJournal "$previous_written_operation_json" \
    --arg phase "$operation_phase" \
    --argjson maintenanceStarted "${maintenance_started_epoch:-null}" \
    --argjson maintenanceEnded "${maintenance_ended_epoch:-null}" \
    --argjson maintenanceDuration "$maintenance_duration" \
    --argjson maintenanceConfirmed "$maintenance_confirmed" \
    --argjson operationMaintenanceConfirmed "$operation_maintenance_confirmed" '
    {
      schemaVersion: "inside.platform.deployment-maintenance.v1",
      journal: $journal,
      previousJournal: $previousJournal,
      phase: $phase,
      maintenanceConfirmed: $maintenanceConfirmed,
      operationMaintenanceConfirmed: $operationMaintenanceConfirmed,
      maintenance: (
        if $maintenanceStarted == null then null
        else {startedAtEpochSeconds: $maintenanceStarted, endedAtEpochSeconds: $maintenanceEnded, durationSeconds: $maintenanceDuration}
        end
      )
    }' | write_private_file_atomically "$maintenance_file"
  if [[ -n "${INSIDE_DEPLOY_TEST_ROOT:-}" &&
        "${INSIDE_DEPLOY_TEST_INTERRUPT_AFTER_MAINTENANCE:-}" == "$operation_phase" ]]; then
    kill -KILL "$$"
  fi
  printf '%s\n' "$journal_json" | write_private_file_atomically "$operation_file"
  previous_written_operation_json="$journal_json"
}

on_exit() {
  local status=$?
  trap - EXIT
  if ((status != 0)) && [[ "$completed" != true && "$operation_started" == true ]]; then
    write_operation failed "$phase" || true
  fi
  exit "$status"
}
trap on_exit EXIT

fail_if_requested() {
  local requested_phase="$1"
  if [[ -n "${INSIDE_DEPLOY_TEST_ROOT:-}" && "${INSIDE_DEPLOY_FAIL_PHASE:-}" == "$requested_phase" ]]; then
    echo "Injected deployment failure at $requested_phase" >&2
    return 1
  fi
}

now_epoch() {
  if [[ -n "${INSIDE_DEPLOY_TEST_ROOT:-}" && "${INSIDE_DEPLOY_TEST_NOW_EPOCH:-}" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "$INSIDE_DEPLOY_TEST_NOW_EPOCH"
  else
    date -u +%s
  fi
}

format_epoch() {
  local epoch="$1"
  date -u -r "$epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
    date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ
}

published_loopback_port() {
  local service="$1"
  local target_port="$2"
  jq --exit-status --raw-output \
    --arg service "$service" \
    --argjson targetPort "$target_port" '
      [
        .services[$service].ports[] |
        select(
          .host_ip == "127.0.0.1" and
          .target == $targetPort and
          .protocol == "tcp"
        ) |
        (.published | if type == "number" then . else tonumber end) |
        select(. >= 1 and . <= 65535)
      ] |
      if length == 1 then .[0] else error("expected one loopback port") end
    ' <<<"$compose_config"
}

load_release_environment() {
  local selected_manifest="$1"
  local backend_image web_image selected_version selected_source selected_schema
  backend_image="$(jq --raw-output .images.backend "$selected_manifest")"
  web_image="$(jq --raw-output .images.web "$selected_manifest")"
  export PLATFORM_BACKEND_IMAGE_REPOSITORY="${backend_image%@sha256:*}"
  export PLATFORM_BACKEND_IMAGE_DIGEST="${backend_image##*@sha256:}"
  export PLATFORM_WEB_IMAGE_REPOSITORY="${web_image%@sha256:*}"
  export PLATFORM_WEB_IMAGE_DIGEST="${web_image##*@sha256:}"
  selected_version="$(jq --raw-output .version "$selected_manifest")"
  selected_source="$(jq --raw-output .source.sha "$selected_manifest")"
  selected_schema="$(jq --raw-output .schema.identity "$selected_manifest")"
  export PLATFORM_RELEASE_VERSION="$selected_version"
  export PLATFORM_SOURCE_SHA="$selected_source"
  export INSIDE_DEPLOY_EXPECTED_SCHEMA="$selected_schema"
  local selected_env="$release_env_dir/$PLATFORM_RELEASE_VERSION.env"
  printf 'PLATFORM_RELEASE_VERSION=%s\nPLATFORM_SOURCE_SHA=%s\n' \
    "$PLATFORM_RELEASE_VERSION" "$PLATFORM_SOURCE_SHA" \
    | write_private_file_atomically "$selected_env"
  export PLATFORM_RELEASE_ENV_FILE="$selected_env"
  export PLATFORM_CONFIG_DIR="$config_dir"
}

worker_services=(material-assets-worker profile-avatars-worker video-deletions-worker billing-worker notifications-worker)
process_services=(api mcp material-assets-worker profile-avatars-worker video-deletions-worker billing-worker notifications-worker web)
# The pinned RabbitMQ image runs the broker as gid 101; it reads its TLS key and definitions by group.
readonly broker_group_id=101

# A release published before the broker declares fewer services. Every lifecycle command names only
# the requested services that the selected release's Compose file actually declares.
declared_services() {
  local selected_compose_file="$1"
  shift
  local declared service
  declared="$(docker compose --env-file "$config_dir/compose.env" --file "$selected_compose_file" config --services)"
  for service in "$@"; do
    if grep -Fqx "$service" <<<"$declared"; then
      printf '%s ' "$service"
    fi
  done
}

stop_workers() {
  local selected_compose_file="$1"
  local declared
  local services
  declared="$(declared_services "$selected_compose_file" "${worker_services[@]}")"
  if [[ -z "$declared" ]]; then
    return
  fi
  read -r -a services <<<"$declared"
  docker compose --env-file "$config_dir/compose.env" --file "$selected_compose_file" \
    stop --timeout 20 "${services[@]}"
}

activate_caddy() {
  local source="$1"
  local temporary="$runtime_dir/caddy/active.caddy.tmp.$$"
  install -m 644 "$source" "$temporary" || return 1
  mv "$temporary" "$runtime_dir/caddy/active.caddy" || return 1
  caddy reload --config "$host_root/etc/caddy/Caddyfile" --adapter caddyfile
}

# Adapt the complete host configuration with one expected immutable fragment, without
# changing active.caddy. Other applications' fragments remain part of the comparison.
expected_caddy_config() (
  local fragment="$1"
  local proof_dir source
  if [[ "$(grep -Fxc 'import /srv/inside/runtime/caddy/*.caddy' "$host_root/etc/caddy/Caddyfile")" != 1 ]]; then
    exit 1
  fi
  proof_dir="$(mktemp -d "$state_dir/caddy-proof.XXXXXX")" || exit 1
  trap 'rm -rf "$proof_dir"' EXIT
  for source in "$runtime_dir/caddy/"*.caddy; do
    if [[ -f "$source" ]]; then cp "$source" "$proof_dir/" || exit 1; fi
  done
  install -m 600 "$fragment" "$proof_dir/active.caddy" || exit 1
  sed "s|^import /srv/inside/runtime/caddy/\\*\\.caddy$|import $proof_dir/*.caddy|" \
    "$host_root/etc/caddy/Caddyfile" >"$proof_dir/Caddyfile" || exit 1
  caddy adapt --config "$proof_dir/Caddyfile" --adapter caddyfile 2>/dev/null
)

interrupted_caddy_mode() {
  local selected_version="$1"
  local live expected fragment
  live="$(curl --fail --silent --show-error --max-time "$caddy_config_read_budget_seconds" \
    http://127.0.0.1:2019/config/)" || return 1
  for fragment in maintenance platform; do
    expected="$(expected_caddy_config "$host_root/srv/inside/releases/$selected_version/runtime/caddy/$fragment.caddy")" || return 1
    if jq --slurp --exit-status \
      'length == 2 and (.[0] | type == "object") and (.[1] | type == "object") and .[0] == .[1]' \
      <<<"$live
$expected" >/dev/null; then
      printf '%s\n' "$fragment"
      return
    fi
  done
  return 1
}

archive_uncertain_maintenance() {
  local measured_operation measured_version measured_run_id measured_start archive
  measured_operation="$(jq --raw-output .operation <<<"$last_operation_json")"
  measured_version="$(jq --raw-output .version <<<"$last_operation_json")"
  measured_run_id="$(jq --raw-output .githubRunId <<<"$last_operation_json")"
  measured_start="$(jq --raw-output .maintenance.startedAtEpochSeconds <<<"$last_maintenance_json")"
  archive="$operation_history_dir/maintenance-$measured_operation-$measured_version-run-$measured_run_id-started-$measured_start-ended-unknown.json"
  if [[ ! -e "$archive" ]]; then
    jq --argjson observed "$(now_epoch)" '
      . + {
        schemaVersion: "inside.platform.deployment-maintenance-uncertain.v1",
        maintenance: (.maintenance + {endedAtEpochSeconds: null, durationSeconds: null}),
        restoration: {observedAtEpochSeconds: $observed, evidence: "live-caddy-config"}
      }
    ' <<<"$last_maintenance_json" | write_private_file_atomically "$archive"
  fi
  echo "Maintenance end is unknown; the uncertain interval is retained in $archive."
}

# Сторож production (#245) приходит в backend-образе выбранного выпуска: пакет выпуска на сервере
# закрыт перечнем файлов шлюза, а образ уже проверен по digest манифеста. Сбой установки не отменяет
# выпуск: прежняя версия сторожа продолжает работать, а предупреждение остаётся в журнале deploy.
install_watchdog() {
  local container source="$state_dir/watchdog-install.$$"
  rm -rf "$source"
  mkdir -m 700 "$source" || return 1
  container="$(docker create "$backend_image")" || return 1
  if ! docker cp "$container:/app/ops/watchdog/." "$source/"; then
    docker rm "$container" >/dev/null || true
    rm -rf "$source"
    return 1
  fi
  docker rm "$container" >/dev/null || true
  install -d -m 755 "$host_root/usr/local/libexec/inside" "$host_root/etc/systemd/system" &&
    install -m 755 "$source/inside-watchdog" "$host_root/usr/local/libexec/inside/inside-watchdog" &&
    install -m 644 "$source/inside-watchdog.service" "$host_root/etc/systemd/system/inside-watchdog.service" &&
    install -m 644 "$source/inside-watchdog.timer" "$host_root/etc/systemd/system/inside-watchdog.timer" &&
    systemctl daemon-reload &&
    systemctl enable --now inside-watchdog.timer
  local status=$?
  rm -rf "$source"
  return "$status"
}

assert_empty_initial_database() {
  local database_network postgres_container database_empty
  database_network="$(jq --exit-status --raw-output '.networks.database.name' <<<"$compose_config")"
  postgres_container="$(
    docker ps \
      --filter "network=$database_network" \
      --filter label=com.docker.compose.service=postgres \
      --quiet
  )"
  if [[ ! "$postgres_container" =~ ^[0-9a-f]{12,64}$ ]]; then
    echo "Expected exactly one running foundation PostgreSQL container" >&2
    exit 1
  fi
  database_empty="$(
    docker exec --env-file "$config_dir/migrations.env" "$postgres_container" \
      sh -c 'psql "$DATABASE_URL" --tuples-only --no-align --set ON_ERROR_STOP=1 --command "select not exists (select 1 from information_schema.tables where table_schema <> '\''information_schema'\'' and table_schema not like '\''pg_%'\'' and table_type = '\''BASE TABLE'\'');"' \
      | tr -d '[:space:]'
  )"
  if [[ "$database_empty" != t ]]; then
    echo "The first deployment requires an empty application database" >&2
    exit 1
  fi
}

verify_candidate_schema_for_retry() {
  case "$recovery_phase" in
    migrations)
      verify_schema_compatible "$compose_file"
      ;;
    start | readiness | smoke | routes | journal)
      verify_schema_identity "$compose_file" "$schema_identity"
      ;;
    *)
      return 1
      ;;
  esac
}

verify_schema_compatible() {
  local selected_compose_file="$1"
  docker compose --env-file "$config_dir/compose.env" --file "$selected_compose_file" \
    run --pull never --rm --no-deps migrations \
    node dist/migrations/migrate.js --verify-schema-compatible >/dev/null
}

verify_schema_identity() {
  local selected_compose_file="$1"
  local expected_identity="$2"
  docker compose --env-file "$config_dir/compose.env" --file "$selected_compose_file" \
    run --pull never --rm --no-deps migrations \
    node dist/migrations/migrate.js \
    --verify-schema-identity "$expected_identity" >/dev/null
}

archive_repair_forward_operation() {
  local archived_operation
  archived_operation="$operation_history_dir/deploy-$repair_forward_version-run-$repair_forward_run_id.json"
  if [[ "$repair_forward_initial" == true && -e "$archived_operation" ]]; then
    if [[ ! -f "$archived_operation" || -L "$archived_operation" ]] ||
      ! cmp -s "$operation_file" "$archived_operation"; then
      echo "Repair-forward operation history conflicts with the active journal" >&2
      exit 1
    fi
    return
  fi
  if [[ "$repair_forward_initial" == true ]]; then
    install -m 600 "$operation_file" "$archived_operation.tmp.$$"
    mv "$archived_operation.tmp.$$" "$archived_operation"
  elif [[ ! -f "$archived_operation" || -L "$archived_operation" ]] ||
    ! jq --exit-status \
      --arg version "$repair_forward_version" \
      --arg phase "$repair_forward_phase" \
      --argjson githubRunId "$repair_forward_run_id" '
        .schemaVersion == "inside.platform.deployment-operation.v1" and
        (.status == "failed" or .status == "running") and
        .operation == "deploy" and
        .version == $version and
        .githubRunId == $githubRunId and
        (.recoveryPhase // .phase) == $phase
      ' "$archived_operation" >/dev/null; then
    echo "Repair-forward operation history is missing or invalid" >&2
    exit 1
  fi
}

validate_operation_journal() {
  jq --exit-status '
    (keys == ["githubRunId", "operation", "phase", "recordedAt", "recoveryPhase", "repairForward", "schemaVersion", "status", "version"]) and
    .schemaVersion == "inside.platform.deployment-operation.v1" and
    (.status == "running" or .status == "failed" or .status == "succeeded") and
    (.operation == "deploy" or .operation == "rollback") and
    (.version | test("^v[1-9][0-9]*$")) and
    (.phase | test("^(preflight|maintenance|pull|schema|workers|migrations|start|readiness|smoke|routes|journal|complete)$")) and
    (
      .recoveryPhase == null or
      (.recoveryPhase | test("^(maintenance|pull|schema|workers|migrations|start|readiness|smoke|routes|journal)$"))
    ) and
    (
      .repairForward == null or
      (
        (.repairForward | keys == ["githubRunId", "recoveryPhase", "version"]) and
        .operation == "deploy" and
        (.repairForward.version | test("^v[1-9][0-9]*$")) and
        ((.version[1:] | tonumber) == ((.repairForward.version[1:] | tonumber) + 1)) and
        (.repairForward.githubRunId | type == "number") and
        .repairForward.githubRunId > 0 and
        (.repairForward.githubRunId | floor) == .repairForward.githubRunId and
        (.repairForward.recoveryPhase | test("^(migrations|start|readiness|smoke|routes|journal)$"))
      )
    ) and
    (.githubRunId | type == "number") and
    .githubRunId > 0 and
    (.githubRunId | floor) == .githubRunId and
    (.recordedAt | type == "string") and
    (.recordedAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
    (
      (
        .status == "succeeded" and
        .phase == "complete" and
        .recoveryPhase == null
      ) or (
        .status != "succeeded" and
        .phase != "complete" and
        (
          .operation == "deploy" or
          (.phase != "migrations" and .recoveryPhase != "migrations")
        ) and
        (
          .phase != "migrations" or
          (.operation == "deploy" and .recoveryPhase == "migrations")
        ) and
        (
          .phase as $phase |
          (["start", "readiness", "smoke", "routes", "journal"] | index($phase)) as $latePhase |
          $latePhase == null or .recoveryPhase == $phase
        )
      )
    )
  ' "$1" >/dev/null
}

validate_maintenance_journal() {
  jq --exit-status '
    ((keys == ["journal", "maintenance", "phase", "previousJournal", "schemaVersion"]) or
     (keys == ["journal", "maintenance", "maintenanceConfirmed", "phase", "previousJournal", "schemaVersion"]) or
     (keys == ["journal", "maintenance", "maintenanceConfirmed", "operationMaintenanceConfirmed", "phase", "previousJournal", "schemaVersion"])) and
    .schemaVersion == "inside.platform.deployment-maintenance.v1" and
    (.journal | type == "object") and
    (.previousJournal == null or (.previousJournal | type == "object")) and
    ((has("maintenanceConfirmed") | not) or (.maintenanceConfirmed | type == "boolean")) and
    ((has("operationMaintenanceConfirmed") | not) or (.operationMaintenanceConfirmed | type == "boolean")) and
    (.phase | test("^(preflight|pre-pull|maintenance|pull|schema|workers|migrations|start|readiness|smoke|routes|journal|complete)$")) and
    (
      .maintenance == null or
      (
        (.maintenance | keys == ["durationSeconds", "endedAtEpochSeconds", "startedAtEpochSeconds"]) and
        (.maintenance.startedAtEpochSeconds | type == "number") and
        .maintenance.startedAtEpochSeconds >= 0 and
        (.maintenance.startedAtEpochSeconds | floor) == .maintenance.startedAtEpochSeconds and
        (.maintenance.durationSeconds | type == "number") and
        .maintenance.durationSeconds >= 0 and
        (.maintenance.durationSeconds | floor) == .maintenance.durationSeconds and
        (
          .maintenance.endedAtEpochSeconds == null or
          (
            (.maintenance.endedAtEpochSeconds | type == "number") and
            .maintenance.endedAtEpochSeconds >= .maintenance.startedAtEpochSeconds and
            (.maintenance.endedAtEpochSeconds | floor) == .maintenance.endedAtEpochSeconds and
            .maintenance.durationSeconds == (.maintenance.endedAtEpochSeconds - .maintenance.startedAtEpochSeconds)
          )
        )
      )
    )
  ' "$1" >/dev/null
}

deployment_predecessor() {
  local ordinal="$1"
  jq --exit-status --compact-output --argjson ordinal "$ordinal" '
    if ((.current.version[1:] | tonumber) + 1) == $ordinal then .current
    elif .operation == "rollback" and
      .rolledBackFrom != null and
      (.rolledBackFrom.version | test("^v[1-9][0-9]*$")) and
      ((.rolledBackFrom.version[1:] | tonumber) + 1) == $ordinal and
      .rolledBackFrom.schemaIdentity == .current.schemaIdentity
    then .rolledBackFrom
    else error("Deployment must follow the current version or its recorded rollback source")
    end
  ' "$state_file"
}

verify_manifest_predecessor() {
  local candidate="$1"
  local predecessor="$2"
  jq --exit-status --argjson predecessor "$predecessor" '
    .rollback.previous != null and
    .rollback.previous.version == $predecessor.version and
    .rollback.previous.sourceSha == $predecessor.sourceSha and
    .rollback.previous.manifestSha256 == $predecessor.manifestSha256 and
    .rollback.previous.schemaIdentity == $predecessor.schemaIdentity and
    .rollback.previous.verifiedByWorkflowRunId == .publication.workflowRunId
  ' "$candidate" >/dev/null
}

verify_repair_lineage() {
  local journal candidate prior_manifest prior_json prior_version prior_run prior_phase
  local root_ordinal predecessor
  prior_version="$repair_forward_version"
  prior_run="$repair_forward_run_id"
  prior_phase="$repair_forward_phase"
  candidate="$manifest"
  if [[ "$repair_forward_initial" == true ]]; then
    journal="$operation_file"
  else
    journal="$operation_history_dir/deploy-$prior_version-run-$prior_run.json"
  fi
  while true; do
    if [[ ! -f "$journal" || -L "$journal" ]] ||
      ! validate_operation_journal "$journal" ||
      ! jq --exit-status --arg version "$prior_version" --arg phase "$prior_phase" \
        --argjson run "$prior_run" '
          (.status == "failed" or .status == "running") and
          .operation == "deploy" and .version == $version and .githubRunId == $run and
          (.recoveryPhase // .phase) == $phase
        ' "$journal" >/dev/null; then
      echo "Repair-forward operation lineage is missing or invalid" >&2
      exit 1
    fi
    prior_manifest="$host_root/srv/inside/releases/$prior_version/release-manifest.json"
    if [[ ! -f "$prior_manifest" || -L "$prior_manifest" ]]; then
      echo "Repair-forward lineage manifest is missing" >&2
      exit 1
    fi
    prior_json="$(jq --compact-output --arg digest "sha256:$(sha256_file "$prior_manifest")" '
      {version, sourceSha: .source.sha, manifestSha256: $digest, schemaIdentity: .schema.identity}
    ' "$prior_manifest")"
    if ! verify_manifest_predecessor "$candidate" "$prior_json"; then
      echo "Repair-forward manifest does not bind the exact failed release" >&2
      exit 1
    fi
    if [[ "$(jq --raw-output '.repairForward == null' "$journal")" == true ]]; then
      if [[ "$is_noop" == true ]]; then
        break # The exact committed state already attests the successful transition.
      fi
      root_ordinal="${prior_version#v}"
      if [[ -f "$state_file" ]]; then
        predecessor="$(deployment_predecessor "$root_ordinal")"
        if ! verify_manifest_predecessor "$prior_manifest" "$predecessor"; then
          echo "Repair-forward lineage does not bind the successful state" >&2
          exit 1
        fi
      elif [[ "$root_ordinal" -ne 1 || "$(jq --raw-output '.rollback.previous == null' "$prior_manifest")" != true ]]; then
        echo "Repair-forward lineage must start at the first deployment" >&2
        exit 1
      fi
      break
    fi
    prior_version="$(jq --raw-output .repairForward.version "$journal")"
    prior_run="$(jq --raw-output .repairForward.githubRunId "$journal")"
    prior_phase="$(jq --raw-output .repairForward.recoveryPhase "$journal")"
    candidate="$prior_manifest"
    journal="$operation_history_dir/deploy-$prior_version-run-$prior_run.json"
  done
}

install -d -m 700 "$state_dir" "$operation_history_dir" "$release_env_dir"
install -d -m 755 "$runtime_dir/caddy"
last_operation_json=null
if [[ -f "$operation_file" ]]; then
  if ! validate_operation_journal "$operation_file"; then
    echo "Deployment operation journal is invalid" >&2
    exit 1
  fi
  last_operation_json="$(jq --compact-output . "$operation_file")"
fi
previous_written_operation_json="$last_operation_json"
last_maintenance_json=null
if [[ -e "$maintenance_file" || -L "$maintenance_file" ]]; then
  if [[ ! -f "$maintenance_file" || -L "$maintenance_file" ]] ||
    ! validate_maintenance_journal "$maintenance_file"; then
    echo "Deployment maintenance journal is invalid" >&2
    exit 1
  fi
  last_maintenance_json="$(jq --compact-output --argjson journal "$last_operation_json" '
    if .journal == $journal or .previousJournal == $journal then . else null end
  ' "$maintenance_file")"
fi
if [[ "$(jq --raw-output 'has("maintenanceConfirmed")' <<<"$last_maintenance_json")" == false &&
      "$(jq --raw-output '.maintenance.endedAtEpochSeconds' <<<"$last_maintenance_json")" != null ]]; then
  last_maintenance_json="$(jq '. + {maintenanceConfirmed: true}' <<<"$last_maintenance_json")"
fi
if [[ "$last_maintenance_json" != null ]]; then
  last_maintenance_json="$(jq '
    . + {operationMaintenanceConfirmed: (
      .operationMaintenanceConfirmed == true or .maintenanceConfirmed == true or
      ((has("maintenanceConfirmed") | not) and
       ((.phase | test("^(schema|workers|migrations|start|readiness|smoke|routes|journal|complete)$")) or
        ((.journal.recoveryPhase // "") | test("^(migrations|start|readiness|smoke|routes|journal)$"))))
    )}
  ' <<<"$last_maintenance_json")"
fi
if [[ "$(jq --raw-output '.maintenance.startedAtEpochSeconds // empty' <<<"$last_maintenance_json")" != "" &&
      "$(jq --raw-output '.maintenance.endedAtEpochSeconds' <<<"$last_maintenance_json")" == null ]]; then
  interrupted_version="$(jq --raw-output .version <<<"$last_operation_json")"
  if ! live_caddy_mode="$(interrupted_caddy_mode "$interrupted_version")"; then
    echo "Cannot confirm interrupted maintenance from the live Caddy configuration" >&2
    exit 1
  fi
  if [[ "$live_caddy_mode" == maintenance ]]; then
    last_maintenance_json="$(jq '. + {maintenanceConfirmed: true, operationMaintenanceConfirmed: true}' <<<"$last_maintenance_json")"
  else
    # The live configuration proves restoration, but cannot recover the past reload's
    # completion time. Preserve that uncertainty instead of counting normal-route uptime.
    if [[ "$(jq --raw-output '.maintenanceConfirmed' <<<"$last_maintenance_json")" != false ]]; then
      if ! cmp -s "$runtime_dir/caddy/active.caddy" "$host_root/srv/inside/releases/$interrupted_version/runtime/caddy/platform.caddy" &&
        ! cmp -s "$runtime_dir/caddy/active.caddy" "$host_root/srv/inside/releases/$interrupted_version/runtime/caddy/maintenance.caddy"; then
        echo "Interrupted maintenance does not match the immutable release fragment" >&2
        exit 1
      fi
      archive_uncertain_maintenance
    fi
    last_maintenance_json="$(jq '.maintenance = null | .maintenanceConfirmed = false' <<<"$last_maintenance_json")"
  fi
fi
active_recovery_phase="$(jq --raw-output '
  if (.status == "failed" or .status == "running")
  then (.recoveryPhase // .phase)
  else empty
  end
' <<<"$last_operation_json" 2>/dev/null || true)"
if jq --exit-status \
  --arg operation "$operation" \
  --arg version "$version" '
    (.status == "failed" or .status == "running") and
    (.operation != $operation or .version != $version)
  ' <<<"$last_operation_json" >/dev/null 2>&1; then
  active_operation="$(jq --raw-output .operation <<<"$last_operation_json")"
  active_version="$(jq --raw-output .version <<<"$last_operation_json")"
  active_ordinal="${active_version#v}"
  requested_ordinal="${version#v}"
  if [[ "$active_recovery_phase" == preflight ]]; then
    : # Preflight has not changed the host and may be safely replaced.
  elif [[ "$operation" == deploy && "$active_operation" == deploy &&
          "$active_recovery_phase" =~ ^(migrations|start|readiness|smoke|routes|journal)$ &&
          "$requested_ordinal" -eq $((active_ordinal + 1)) ]]; then
    repair_forward=true
    repair_forward_initial=true
    repair_forward_phase="$active_recovery_phase"
    repair_forward_version="$active_version"
    repair_forward_run_id="$(jq --raw-output .githubRunId <<<"$last_operation_json")"
  else
    echo "An unfinished deployment operation must be retried with the same operation and version, or repaired by its next ordinal" >&2
    exit 1
  fi
fi
if jq --exit-status \
  --arg operation "$operation" \
  --arg version "$version" '
    (.status == "failed" or .status == "running") and
    .operation == $operation and
    .version == $version and
    .repairForward != null
  ' <<<"$last_operation_json" >/dev/null 2>&1; then
  repair_forward=true
  repair_forward_phase="$(jq --raw-output .repairForward.recoveryPhase <<<"$last_operation_json")"
  repair_forward_version="$(jq --raw-output .repairForward.version <<<"$last_operation_json")"
  repair_forward_run_id="$(jq --raw-output .repairForward.githubRunId <<<"$last_operation_json")"
fi
recovery_phase="$(jq --raw-output \
  --arg operation "$operation" \
  --arg version "$version" '
    if .schemaVersion == "inside.platform.deployment-operation.v1" and
       (.status == "failed" or .status == "running") and
       .operation == $operation and
       .version == $version and
       ((.recoveryPhase // .phase) as $phase |
         ["preflight", "maintenance", "pull", "schema", "workers", "migrations", "start", "readiness", "smoke", "routes", "journal"] |
         index($phase) != null)
    then (.recoveryPhase // .phase) else empty end
  ' <<<"$last_operation_json" 2>/dev/null || true)"
if [[ "$recovery_phase" == preflight ]]; then
  recovery_phase=
fi
if [[ "$operation" == rollback && -n "$recovery_phase" ]] &&
  { [[ "$last_maintenance_json" == null ]] ||
    jq --exit-status '.operationMaintenanceConfirmed == true' <<<"$last_maintenance_json" >/dev/null; }; then
  accepted_rollback_recovery=true
fi
# Carry an open interval across exact retries and repair forward. Completed measurements
# remain in state.json; every operation journal keeps the legacy closed shape.
if jq --exit-status --arg operation "$operation" --arg version "$version" '
  .operation == $operation and .version == $version
' <<<"$last_operation_json" >/dev/null 2>&1 ||
  [[ "$repair_forward" == true && "$(jq --raw-output '.maintenance.endedAtEpochSeconds' <<<"$last_maintenance_json")" == null ]]; then
  maintenance_started_epoch="$(jq --raw-output '.maintenance.startedAtEpochSeconds // empty' <<<"$last_maintenance_json")"
  maintenance_ended_epoch="$(jq --raw-output '.maintenance.endedAtEpochSeconds // empty' <<<"$last_maintenance_json")"
  maintenance_confirmed="$(jq --raw-output '.maintenanceConfirmed // (.maintenance.endedAtEpochSeconds != null)' <<<"$last_maintenance_json")"
  operation_maintenance_confirmed="$(jq --raw-output '.operationMaintenanceConfirmed // false' <<<"$last_maintenance_json")"
fi
if [[ "$accepted_rollback_recovery" == true ]]; then operation_maintenance_confirmed=true; fi
# A retry or repair can open another interval after routes succeeded but state failed.
# Archive the previous closed measurement even when repair does not carry it forward.
closed_interval_epoch="$(jq --raw-output '.maintenance.endedAtEpochSeconds // empty' <<<"$last_maintenance_json")"
if [[ -n "$closed_interval_epoch" ]] &&
  [[ "$(jq --raw-output .status <<<"$last_operation_json")" != succeeded ]]; then
  measured_run_id="$(jq --raw-output .githubRunId <<<"$last_operation_json")"
  measured_operation="$(jq --raw-output .operation <<<"$last_operation_json")"
  measured_version="$(jq --raw-output .version <<<"$last_operation_json")"
  measured_history="$operation_history_dir/maintenance-$measured_operation-$measured_version-run-$measured_run_id-ended-$closed_interval_epoch.json"
  if [[ ! -e "$measured_history" ]]; then
    install -m 600 "$maintenance_file" "$measured_history.tmp.$$"
    mv "$measured_history.tmp.$$" "$measured_history"
  fi
fi
if [[ "$repair_forward" != true ]]; then
  if [[ "$operation" == rollback && "$recovery_phase" == journal ]]; then
    defer_operation_start=true
  else
    write_operation running "$phase"
    operation_started=true
  fi
fi

for name in \
  compose.env \
  api.env \
  billing-worker.env \
  material-assets-worker.env \
  mcp.env \
  migrations.env \
  notifications-worker.env \
  profile-avatars-worker.env \
  video-deletions-worker.env \
  web.env; do
  path="$config_dir/$name"
  if [[ ! -r "$path" || -L "$path" ]]; then
    echo "Missing server-owned runtime configuration: $path" >&2
    exit 1
  fi
  if grep -q 'replace-with-' "$path"; then
    echo "Server-owned runtime configuration still contains a placeholder: $name" >&2
    exit 1
  fi
  if [[ -z "${INSIDE_DEPLOY_TEST_ROOT:-}" ]]; then
    file_mode="$(stat -c %a "$path")"
    file_owner="$(stat -c %u "$path")"
    if [[ "$file_mode" != 600 || "$file_owner" != 0 ]]; then
      echo "Server-owned runtime configuration must be root-owned mode 0600: $name" >&2
      exit 1
    fi
  fi
done

for name in definitions.json tls/ca.pem tls/server.pem tls/server-key.pem; do
  path="$config_dir/rabbitmq/$name"
  if [[ ! -r "$path" || -L "$path" ]]; then
    echo "Missing server-owned broker configuration: $path" >&2
    exit 1
  fi
  if [[ -z "${INSIDE_DEPLOY_TEST_ROOT:-}" ]]; then
    case "$name" in
      tls/ca.pem | tls/server.pem) expected_mode=644 ;;
      *) expected_mode=640 ;;
    esac
    if [[ "$(stat -c %u:%g "$path")" != "0:$broker_group_id" || "$(stat -c %a "$path")" != "$expected_mode" ]]; then
      echo "Server-owned broker configuration must be root:$broker_group_id mode 0$expected_mode: $name" >&2
      exit 1
    fi
  fi
done

manifest_digest="sha256:$(sha256_file "$manifest")"
bundle_digest="$(jq --raw-output .runtimeBundle.sha256 "$manifest")"
source_sha="$(jq --raw-output .source.sha "$manifest")"
schema_identity="$(jq --raw-output .schema.identity "$manifest")"
backend_image="$(jq --raw-output .images.backend "$manifest")"
web_image="$(jq --raw-output .images.web "$manifest")"

if [[ -f "$state_file" ]] && ! jq --exit-status '
  .schemaVersion == "inside.platform.deployment-state.v1" and
  .status == "succeeded" and
  (.current.version | test("^v[1-9][0-9]*$")) and
  (.current.manifestSha256 | test("^sha256:[0-9a-f]{64}$"))
' "$state_file" >/dev/null; then
  echo "Deployment state journal is invalid" >&2
  exit 1
fi

is_noop=false
if [[ "$operation" == deploy && -f "$state_file" && \
      "$(jq --raw-output .current.version "$state_file")" == "$version" ]]; then
  if [[ "$(jq --raw-output .current.manifestSha256 "$state_file")" != "$manifest_digest" ]]; then
    echo "The deployed ordinal has a different immutable manifest" >&2
    exit 1
  fi
  is_noop=true
elif [[ "$operation" == rollback && "$recovery_phase" == journal && -f "$state_file" ]]; then
  interrupted_run_id="$(jq --raw-output \
    'select(
      (.status == "failed" or .status == "running") and
      .operation == "rollback" and
      .version == $version and
      (.recoveryPhase // .phase) == "journal" and
      .repairForward == null
    ) | .githubRunId' \
    --arg version "$version" <<<"$last_operation_json")"
  if [[ "$interrupted_run_id" =~ ^[1-9][0-9]*$ ]] && jq --exit-status \
    --arg version "$version" \
    --arg sourceSha "$source_sha" \
    --arg backendImage "$backend_image" \
    --arg webImage "$web_image" \
    --arg manifestSha256 "$manifest_digest" \
    --arg bundleSha256 "$bundle_digest" \
    --arg schemaIdentity "$schema_identity" \
    --argjson interruptedRunId "$interrupted_run_id" '
      .operation == "rollback" and
      .current.version == $version and
      .current.sourceSha == $sourceSha and
      .current.backendImage == $backendImage and
      .current.webImage == $webImage and
      .current.manifestSha256 == $manifestSha256 and
      .current.bundleSha256 == $bundleSha256 and
      .current.schemaIdentity == $schemaIdentity and
      .current.githubRunId == $interruptedRunId and
      .previous == null and
      .rollback == null and
      .rolledBackFrom != null and
      (.rolledBackFrom.version | test("^v[1-9][0-9]*$")) and
      ((.rolledBackFrom.version[1:] | tonumber) == (($version[1:] | tonumber) + 1)) and
      .rolledBackFrom.schemaIdentity == $schemaIdentity
    ' "$state_file" >/dev/null; then
    is_noop=true
  fi
fi

previous_json=null
rollback_json=null
rolled_back_from_json=null
current_epoch="$(now_epoch)"
if [[ "$operation" == deploy ]]; then
  target_ordinal="${version#v}"
  if [[ "$is_noop" == true ]]; then
    : # The exact state was committed before its operation journal closed.
  elif [[ "$repair_forward" == true ]]; then
    repair_forward_release_dir="$host_root/srv/inside/releases/$repair_forward_version"
    repair_forward_manifest="$repair_forward_release_dir/release-manifest.json"
    if [[ ! -f "$repair_forward_manifest" || -L "$repair_forward_manifest" ]] ||
      ! jq --exit-status --arg version "$repair_forward_version" '
        .schemaVersion == "inside.platform.release-manifest.v2" and
        .version == $version
      ' "$repair_forward_manifest" >/dev/null; then
      echo "The failed release manifest required for repair forward is invalid" >&2
      exit 1
    fi
    verify_repair_lineage
    if [[ -f "$state_file" ]]; then
      previous_json="$(jq --compact-output .current "$state_file")"
    fi
    repair_forward_schema_identity="$(jq --raw-output .schema.identity "$repair_forward_manifest")"
  elif [[ ! -f "$state_file" ]]; then
    if [[ "$target_ordinal" -ne 1 || "$(jq --raw-output '.rollback.previous == null' "$manifest")" != true ]]; then
      echo "The first deployment must be v1 without a previous release" >&2
      exit 1
    fi
  elif [[ "$is_noop" != true ]]; then
    current_version="$(jq --raw-output .current.version "$state_file")"
    if ! predecessor_json="$(deployment_predecessor "$target_ordinal")"; then
      echo "A deployment must select the next ordinal after $current_version or its recorded rollback source" >&2
      exit 1
    fi
    previous_json="$(jq --compact-output .current "$state_file")"
    if ! verify_manifest_predecessor "$manifest" "$predecessor_json"; then
      echo "Candidate manifest does not bind the exact deployed previous release" >&2
      exit 1
    fi
    if [[ "$(jq --raw-output .version <<<"$predecessor_json")" == "$current_version" ]]; then
      rollback_json="$(jq --compact-output \
      '
        .rollback.previous | {
          targetVersion: .version,
          sourceSha,
          manifestSha256,
          schemaIdentity,
          compatible,
          verifiedByWorkflowRunId
        }
      ' "$manifest")"
    fi
  fi
else
  if [[ ! -f "$state_file" ]]; then
    echo "Rollback requires a successful current deployment" >&2
    exit 1
  fi
  if [[ "$is_noop" == true ]]; then
    : # The rollback state was committed before its operation journal closed.
  elif ! jq --exit-status \
    --arg version "$version" \
    --arg manifestSha256 "$manifest_digest" \
    --arg sourceSha "$source_sha" \
    --arg schemaIdentity "$schema_identity" \
    --argjson acceptedRecovery "$accepted_rollback_recovery" \
    --argjson now "$current_epoch" '
      .rollback != null and
      .rollback.compatible == true and
      .rollback.targetVersion == $version and
      .rollback.manifestSha256 == $manifestSha256 and
      .rollback.sourceSha == $sourceSha and
      .rollback.schemaIdentity == $schemaIdentity and
      ($acceptedRecovery or .rollback.expiresAtEpochSeconds >= $now) and
      .current.schemaIdentity == $schemaIdentity
    ' "$state_file" >/dev/null; then
    echo "Rollback target is unknown, incompatible or expired" >&2
    exit 1
  fi
  rolled_back_from_json="$(jq --compact-output .current "$state_file")"
fi

if [[ "$defer_operation_start" == true && "$is_noop" != true ]]; then
  write_operation running "$phase"
  operation_started=true
fi
fail_if_requested preflight
load_release_environment "$manifest"
compose_config="$(docker compose \
  --env-file "$config_dir/compose.env" \
  --file "$compose_file" \
  config --format json)"

if [[ "$repair_forward" == true && "$is_noop" == true ]]; then
  verify_repair_lineage
  archive_repair_forward_operation
fi
if [[ "$repair_forward" == true && "$is_noop" != true ]]; then
  repair_forward_compose_file="$repair_forward_release_dir/runtime/compose.production.yaml"
  if [[ "$repair_forward_initial" == true ||
        ! "$recovery_phase" =~ ^(migrations|start|readiness|smoke|routes|journal)$ ]]; then
    load_release_environment "$repair_forward_manifest"
    case "$repair_forward_phase" in
      migrations)
        verify_schema_compatible "$repair_forward_compose_file"
        ;;
      start | readiness | smoke | routes | journal)
        verify_schema_identity "$repair_forward_compose_file" "$repair_forward_schema_identity"
        ;;
      *)
        echo "The failed deployment phase cannot be repaired forward" >&2
        exit 1
        ;;
    esac
  else
    load_release_environment "$manifest"
    verify_candidate_schema_for_retry
  fi
  load_release_environment "$manifest"
  archive_repair_forward_operation
  write_operation running "$phase"
  operation_started=true
elif [[ ! -f "$state_file" ]]; then
  if ! verify_candidate_schema_for_retry; then
    assert_empty_initial_database
  fi
else
  current_version="$(jq --raw-output .current.version "$state_file")"
  current_schema_identity="$(jq --raw-output .current.schemaIdentity "$state_file")"
  current_release_dir="$host_root/srv/inside/releases/$current_version"
  current_manifest="$current_release_dir/release-manifest.json"
  current_compose_file="$current_release_dir/runtime/compose.production.yaml"
  load_release_environment "$current_manifest"
  if ! current_schema_error="$(
    docker compose --env-file "$config_dir/compose.env" --file "$current_compose_file" \
      run --pull never --rm --no-deps migrations \
      node dist/migrations/migrate.js \
      --verify-schema-identity "$current_schema_identity" 2>&1
  )"; then
    load_release_environment "$manifest"
    if ! verify_candidate_schema_for_retry; then
      printf '%s\n' "$current_schema_error" >&2
      exit 1
    fi
  fi
  load_release_environment "$manifest"
fi

if [[ "$is_noop" == true ]]; then
  phase=complete
  recovery_phase=
  write_operation succeeded "$phase"
  completed=true
  echo "$version is already active; no changes were made."
  exit 0
fi

phase=pre-pull
write_operation running "$phase"
fail_if_requested pre-pull
docker pull "$backend_image"
docker pull "$web_image"
for image in "$backend_image" "$web_image"; do
  if ! docker image inspect --format '{{json .RepoDigests}}' "$image" |
    jq --exit-status --arg image "$image" 'index($image) != null' >/dev/null; then
    echo "Pulled image does not match the manifest digest: $image" >&2
    exit 1
  fi
done
candidate_broker="$(declared_services "$compose_file" rabbitmq)"
if [[ -n "$candidate_broker" ]]; then
  docker compose --env-file "$config_dir/compose.env" --file "$compose_file" pull rabbitmq
fi

phase=maintenance
write_operation running "$phase"
fail_if_requested maintenance
prior_maintenance_started_epoch="$maintenance_started_epoch"
prior_maintenance_ended_epoch="$maintenance_ended_epoch"
prior_maintenance_confirmed="$maintenance_confirmed"
if [[ -z "$maintenance_started_epoch" || -n "$maintenance_ended_epoch" ]]; then
  maintenance_started_epoch="$(now_epoch)"
  maintenance_ended_epoch=
  maintenance_confirmed=false
fi
write_operation running "$phase"
if ! activate_caddy "$release_dir/runtime/caddy/maintenance.caddy"; then
  maintenance_started_epoch="$prior_maintenance_started_epoch"
  maintenance_ended_epoch="$prior_maintenance_ended_epoch"
  maintenance_confirmed="$prior_maintenance_confirmed"
  exit 1
fi
maintenance_confirmed=true
operation_maintenance_confirmed=true
write_operation running "$phase"

phase=schema
write_operation running "$phase"
fail_if_requested schema
docker compose --env-file "$config_dir/compose.env" --file "$compose_file" \
  run --pull never --rm --no-deps migrations \
  node dist/migrations/migrate.js --verify-schema-compatible >/dev/null

phase=workers
write_operation running "$phase"
fail_if_requested workers
if [[ "$recovery_phase" =~ ^(start|readiness|smoke|routes|journal)$ ]]; then
  load_release_environment "$manifest"
  stop_workers "$compose_file"
fi
if [[ "$repair_forward" == true ]]; then
  load_release_environment "$repair_forward_manifest"
  stop_workers "$repair_forward_compose_file"
fi
if [[ -f "$state_file" ]]; then
  old_version="$(jq --raw-output .current.version "$state_file")"
  old_release_dir="$host_root/srv/inside/releases/$old_version"
  load_release_environment "$old_release_dir/release-manifest.json"
  stop_workers "$old_release_dir/runtime/compose.production.yaml"
fi
load_release_environment "$manifest"

if [[ "$operation" == deploy ]]; then
  phase=migrations
  recovery_phase="$phase"
  write_operation running "$phase"
  fail_if_requested migrations
  docker compose --env-file "$config_dir/compose.env" --file "$compose_file" \
    run --rm --pull never migrations
fi

phase=start
recovery_phase="$phase"
write_operation running "$phase"
fail_if_requested start
# The broker outlives releases; it is healthy before notifications-worker connects to it.
candidate_broker="$(declared_services "$compose_file" rabbitmq)"
if [[ -n "$candidate_broker" ]]; then
  docker compose --env-file "$config_dir/compose.env" --file "$compose_file" \
    up --detach --wait --pull never --no-deps rabbitmq
fi
# An assignment keeps a failed service listing fatal; an empty list would otherwise start everything.
candidate_process_list="$(declared_services "$compose_file" "${process_services[@]}")"
if [[ -z "$candidate_process_list" ]]; then
  echo "The release Compose file declares no application processes" >&2
  exit 1
fi
read -r -a candidate_processes <<<"$candidate_process_list"
docker compose --env-file "$config_dir/compose.env" --file "$compose_file" \
  up --detach --wait --pull never --no-deps "${candidate_processes[@]}"

phase=readiness
recovery_phase="$phase"
write_operation running "$phase"
fail_if_requested readiness
api_port="$(published_loopback_port api 3001)"
web_port="$(published_loopback_port web 3000)"
api_readiness="$(curl --fail --silent --show-error "http://127.0.0.1:$api_port/health/ready")"
web_readiness="$(curl --fail --silent --show-error "http://127.0.0.1:$web_port/_health/ready")"
for readiness in "$api_readiness" "$web_readiness"; do
  if ! jq --exit-status \
    --arg version "$version" \
    --arg sourceSha "$source_sha" \
    --arg schemaIdentity "$schema_identity" '
      .status == "ready" and
      .release.release == $version and
      .release.sourceSha == $sourceSha and
      .schema.identity == $schemaIdentity
    ' <<<"$readiness" >/dev/null; then
    echo "Runtime readiness does not match the selected release and schema" >&2
    exit 1
  fi
done

phase=smoke
recovery_phase="$phase"
write_operation running "$phase"
fail_if_requested smoke
curl --fail --silent --show-error "http://127.0.0.1:$web_port/" >/dev/null

phase=routes
recovery_phase="$phase"
write_operation running "$phase"
fail_if_requested routes
activate_caddy "$release_dir/runtime/caddy/platform.caddy"
maintenance_ended_epoch="$(now_epoch)"
if ((maintenance_ended_epoch < maintenance_started_epoch)); then
  maintenance_ended_epoch="$maintenance_started_epoch"
fi
write_operation running "$phase"
echo "Maintenance duration: $((maintenance_ended_epoch - maintenance_started_epoch)) seconds."

successful_epoch="$(now_epoch)"
deployed_at="$(format_epoch "$successful_epoch")"
if [[ "$rollback_json" != null ]]; then
  expires_epoch=$((successful_epoch + rollback_window_seconds))
  rollback_json="$(jq --compact-output \
    --arg expiresAt "$(format_epoch "$expires_epoch")" \
    --argjson expiresAtEpochSeconds "$expires_epoch" '
      . + {
        expiresAt: $expiresAt,
        expiresAtEpochSeconds: $expiresAtEpochSeconds
      }
    ' <<<"$rollback_json")"
fi
phase=journal
recovery_phase="$phase"
write_operation running "$phase"
fail_if_requested journal
jq --null-input \
  --arg schemaVersion inside.platform.deployment-state.v1 \
  --arg operation "$operation" \
  --arg version "$version" \
  --arg sourceSha "$source_sha" \
  --arg backendImage "$backend_image" \
  --arg webImage "$web_image" \
  --arg manifestSha256 "$manifest_digest" \
  --arg bundleSha256 "$bundle_digest" \
  --arg schemaIdentity "$schema_identity" \
  --arg deployedAt "$deployed_at" \
  --argjson deployedAtEpochSeconds "$successful_epoch" \
  --argjson githubRunId "$github_run_id" \
  --argjson previous "$previous_json" \
  --argjson rollback "$rollback_json" \
  --argjson rolledBackFrom "$rolled_back_from_json" \
  --argjson maintenance "$(jq --compact-output .maintenance "$maintenance_file")" '
    {
      schemaVersion: $schemaVersion,
      status: "succeeded",
      operation: $operation,
      current: {
        version: $version,
        sourceSha: $sourceSha,
        backendImage: $backendImage,
        webImage: $webImage,
        manifestSha256: $manifestSha256,
        bundleSha256: $bundleSha256,
        schemaIdentity: $schemaIdentity,
        deployedAt: $deployedAt,
        deployedAtEpochSeconds: $deployedAtEpochSeconds,
        githubRunId: $githubRunId
      },
      previous: $previous,
      rollback: $rollback,
      rolledBackFrom: $rolledBackFrom,
      maintenance: $maintenance
    }
  ' | write_private_file_atomically "$state_file"

if [[ -n "${INSIDE_DEPLOY_TEST_ROOT:-}" &&
      "${INSIDE_DEPLOY_TEST_INTERRUPT_AFTER_STATE:-}" == true ]]; then
  kill -KILL "$$"
fi

phase=complete
recovery_phase=
write_operation succeeded "$phase"
completed=true
if ! install_watchdog; then
  echo "Warning: the production watchdog from $version was not installed; the previous one stays active." >&2
fi
echo "$operation $version completed successfully."
