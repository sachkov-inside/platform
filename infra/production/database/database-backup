#!/usr/bin/env bash
set -euo pipefail

backup_type="${1:-}"
repository="${INSIDE_BACKUP_REPOSITORY:-1}"
case "$backup_type" in
  full | diff | incr) ;;
  *)
    echo "Backup type must be full, diff, or incr" >&2
    exit 64
    ;;
esac
case "$repository" in
  1 | 2) ;;
  *)
    echo "Backup repository must be 1 or 2" >&2
    exit 64
    ;;
esac
if [ "$#" -ne 1 ]; then
  echo "Usage: database-backup full|diff|incr" >&2
  exit 64
fi

foundation_root="${INSIDE_FOUNDATION_ROOT:-/opt/inside/foundation/infra/production}"
foundation_config_dir="${FOUNDATION_CONFIG_DIR:-/etc/inside/foundation}"

exec docker compose \
  --env-file "$foundation_config_dir/compose.env" \
  --file "$foundation_root/database/compose.yaml" \
  --profile operations \
  run --rm pgbackrest \
  --stanza=production \
  --repo="$repository" \
  --no-expire-auto \
  --type="$backup_type" \
  backup
