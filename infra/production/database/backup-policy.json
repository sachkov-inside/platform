{
  "schemaVersion": 1,
  "archiveMode": "continuous",
  "clientEncryption": "aes-256-cbc",
  "retentionFullBackups": 4,
  "schedule": {
    "differential": "Mon..Sat *-*-* 01:00:00 UTC",
    "full": "Sun *-*-* 01:00:00 UTC",
    "incremental": "*-*-* 00,06,12,18:00:00 UTC"
  },
  "targets": {
    "databases": ["inside", "logto"],
    "rpoSeconds": 3600,
    "rtoSeconds": 14400
  }
}
