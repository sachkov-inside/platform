[Unit]
Description=Inside production watchdog
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/inside/inside-watchdog
TimeoutStartSec=50s
Nice=10
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/inside/watchdog
UMask=0077
