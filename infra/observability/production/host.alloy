// Linux only. This privileged agent has no query listener, application or ingress network.
logging { level = "error" }
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path = "/sys"
  rootfs_path = "/rootfs"
  set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "stat", "time", "vmstat", "textfile"]
  textfile { directory = "/watchdog-metrics" }
  filesystem {
    mount_points_exclude = "^/(dev|proc|sys|run|var/lib/docker)($|/)"
  }
}
prometheus.exporter.cadvisor "containers" {
  docker_only = true
  store_container_labels = false
  allowlisted_container_labels = ["com.docker.compose.service", "com.docker.compose.project"]
  env_metadata_allowlist = []
  enabled_metrics = ["cpu", "memory", "diskIO", "network", "oom_event"]
  storage_duration = "30s"
}
prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  scrape_timeout = "5s"
  forward_to = [prometheus.relabel.host.receiver]
}
prometheus.relabel "host" {
  forward_to = [prometheus.remote_write.host.receiver]
  rule {
    source_labels = ["__name__", "check"]
    regex = "inside_watchdog_completed_at_seconds;|inside_watchdog_(value|observed_at_seconds);(purchases|fulfillment|notification_outbox|email_effects|billing_queue_idle|web_telemetry_(growth|digest|size|dropped|retention)|community_operations|telegram_(ready|community_oldest_due_seconds|activation_oldest_pending_seconds|update_failed_total|delivery_rejected_total|update_failed_reset|delivery_rejected_reset|webhook_pending|webhook_last_error_timestamp_seconds)|backup_(last_success_timestamp_seconds|timer_(incr|diff|full)|success_(incr|diff|full))|host_available_memory_bytes|host_disk_used_percent|container_(down|unhealthy|oom)|source_(containers|backups|platform_database|telegram_database|telegram_metrics|telegram_webhook))|up;|node_.+;"
    action = "keep"
  }
  rule {
    source_labels = ["__name__"]
    regex = "inside_watchdog_(value|observed_at_seconds|completed_at_seconds)|up|node_(cpu_seconds_total|memory_(MemTotal|MemAvailable|Cached|Buffers)_bytes|filesystem_((size|avail|free)_bytes|files|files_free|readonly)|disk_(reads_completed_total|writes_completed_total|io_time_seconds_total)|network_(receive|transmit)_bytes_total|load(1|5|15)|boot_time_seconds|vmstat_oom_kill)"
    action = "keep"
  }
  rule {
    target_label = "instance"
    replacement = "production-host"
  }
  rule {
    target_label = "job"
    replacement = "platform-host"
  }
  rule {
    action = "labelkeep"
    regex = "__name__|instance|job|cpu|mode|device|mountpoint|fstype|check"
  }
}
prometheus.scrape "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets
  scrape_interval = "15s"
  scrape_timeout = "5s"
  forward_to = [prometheus.relabel.containers.receiver]
}
prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.host.receiver]
  rule {
    source_labels = ["__name__", "container_label_com_docker_compose_service", "container_label_com_docker_compose_project"]
    regex = "up;;|container_.+;(api|mcp|web|material-assets-worker|profile-avatars-worker|video-deletions-worker|billing-worker|notifications-worker|rabbitmq|postgres|pgbackrest|logto|logto-migrations|app|metrics|logs|traces|alloy|vmauth|gateway|grafana|host-agent|umami|query|umami-query|umami-ingest);[a-z][a-z0-9-]{0,63}"
    action = "keep"
  }
  rule {
    source_labels = ["__name__"]
    regex = "up|container_(cpu_usage_seconds_total|cpu_cfs_(periods|throttled_periods|throttled_seconds)_total|memory_(usage_bytes|working_set_bytes|rss|cache|failcnt)|network_(receive|transmit)_bytes_total|fs_(reads|writes)_total|oom_events_total|start_time_seconds|last_seen)"
    action = "keep"
  }
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    target_label = "project"
  }
  rule {
    target_label = "instance"
    replacement = "production-host"
  }
  rule {
    target_label = "job"
    replacement = "platform-containers"
  }
  rule {
    action = "labelkeep"
    regex = "__name__|instance|job|service|project|interface|device"
  }
}
prometheus.remote_write "host" {
  endpoint {
    url = "http://metrics:8428/api/v1/write"
    queue_config {
      capacity = 1000
      max_shards = 1
      max_samples_per_send = 200
    }
  }
  wal { max_keepalive_time = "5m" }
}
