// Web process only. Fixed telemetry-network alias, no public/host listener.
prometheus.scrape "web_http" {
  targets = [{"__address__" = "inside-web-http:9420"}]
  job_name = "platform-web-http"
  scrape_interval = "5s"
  scrape_timeout = "1s"
  body_size_limit = "2MiB"
  sample_limit = 20000
  forward_to = [prometheus.relabel.web_http.receiver]
}
prometheus.relabel "web_http" {
  forward_to = [prometheus.remote_write.collector_health.receiver]
  rule {
    source_labels = ["__name__", "service"]
    regex = "up;|inside_web_http_(source_info|process_start_time_seconds|observed_at_seconds|registry_overflow|started_total|requests_total|active_requests|duration_seconds_(bucket|sum|count));platform-web"
    action = "keep"
  }
  rule {
    source_labels = ["source_sha"]
    regex = "(|[0-9a-f]{40})"
    action = "keep"
  }
  rule {
    source_labels = ["method"]
    regex = "(|GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS|CONNECT|TRACE|OTHER)"
    action = "keep"
  }
  rule {
    source_labels = ["code"]
    regex = "(|0|[1-5][0-9]{2})"
    action = "keep"
  }
  rule {
    source_labels = ["outcome"]
    regex = "(|completed|aborted)"
    action = "keep"
  }
  rule {
    target_label = "instance"
    replacement = "web"
  }
  rule {
    action = "labelkeep"
    regex = "__name__|instance|job|service|environment|source_sha|route|method|code|outcome|le"
  }
}
