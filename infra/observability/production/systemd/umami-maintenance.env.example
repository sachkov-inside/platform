# Explicitly opt in only after configuring the dedicated database, private journal
# and credentials, and authorizing rollout. Never add a database password here.
INSIDE_UMAMI_MAINTENANCE_ENABLED=false
# Fixed local Unix Docker endpoint. SQL is executed only in the uniquely verified
# running postgres service of this exact existing foundation project.
INSIDE_UMAMI_SQL_TRANSPORT=docker
INSIDE_UMAMI_DATABASE_PROJECT=inside-production-database
INSIDE_UMAMI_DOCKER_ENDPOINT=unix:///var/run/docker.sock
