  "methods": [
    "GET",
    "POST",
    "PUT",
    "PATCH",
    "DELETE",
    "HEAD",
    "OPTIONS",
    "_OTHER"
  ],
  "queues": [
    "material-assets.cleanup",
    "profile-avatars.cleanup",
    "videos.deletions",
    "web-telemetry.retention",
    "billing.payment-recovery",
    "billing.subscription-renewal",
    "billing.subscription-notices",
    "tribute.source-reconciliation",
    "community.entitlement-delivery",
    "_OTHER"
  ],
  "operations": [
    "send",
    "insert",
    "upsert",
    "flow",
    "publish",
    "receive",
    "process",
    "complete",
    "fail",
    "cancel",
    "delete",
    "_OTHER"
  ],
  "metrics": [
    "pilot_requests",
    "http.server.request.count",
    "http.server.active_requests",
    "http.server.request.duration",
    "telemetry.trace.dropped",
    "telemetry.trace.export.failures",
    "telemetry.metric.export.failures",
    "telemetry.trace.sampling.ratio",
    "messaging.client.operation.duration",
    "messaging.client.sent.messages",
    "messaging.client.consumed.messages",
    "messaging.process.duration",
    "pgboss.queue.jobs"
  ],
  "notifications": {
    "system": "rabbitmq",
    "destination": "inside.events.materials.v1",
    "operations": ["publish", "receive", "audience"],
    "outcomes": ["completed", "failed"],
    "metrics": [
      "inside.notification.operations",
      "inside.notification.duration"
    ],
    "error": "notification_operation_failed"
  },
  "dependencies": {
    "names": ["kinescope", "postgresql", "tbank", "logto", "telegram", "s3"],
    "operations": [
      "delete",
      "find",
      "initUpload",
      "query",
      "acquire",
      "material-slug-lock",
      "Init",
      "GetState",
      "CheckOrder",
      "Charge",
      "Cancel",
      "AddCard",
      "GetAddCardState",
      "jwks",
      "community.set",
      "community.status",
      "communications.execute",
      "link.register",
      "link.confirm",
      "contacts.read",
      "signin.bindAccount"
    ],
    "outcomes": ["completed", "failed"],
    "metrics": ["inside.dependency.operations", "inside.dependency.duration"]
  },
  "s3": {
    "operations": ["http.GET", "http.PUT", "http.DELETE", "getObject.read"]
  },
  "postgresql": {
    "metrics": [
      "inside.postgresql.pool.available",
      "inside.postgresql.pool.total",
      "inside.postgresql.pool.idle",
      "inside.postgresql.pool.waiting",
      "inside.postgresql.pool.registry_overflow"
    ]
  },
  "email": {
    "operations": [
      "publishMaterial",
      "receiveMaterial",
      "dispatchMaterial",
      "publishSubscription",
      "receiveSubscription",
      "dispatchSubscription",
      "publishResult",
      "receiveResult",
      "projectResult"
    ],
    "lanes": ["emailMaterial", "emailSubscription", "emailResult"],
    "destinations": [
      "inside.notifications.email.v1",
      "inside.results.email.v1"
    ],
    "smtp_outcomes": ["sent", "not_sent", "failed", "unknown"],
    "metrics": ["inside.email.operations", "inside.email.duration"]
  },
  "tracking": {
    "operations": ["deliver"],
    "outcomes": ["completed", "failed"],
    "metrics": ["inside.tracking.operations", "inside.tracking.duration"]
  }
}
