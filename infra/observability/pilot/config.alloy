// Generated by scripts/observability-pilot/privacy_config.py; candidate, not production rollout.
// Link metadata is removed by the pinned VictoriaTraces ingestion filter, not OTTL.
// OTLP JSON/protobuf remain supported. Raw collector diagnostics are not retained by Docker.
logging {
  level = "error"
}

otelcol.receiver.otlp "pilot" {
  http {
    endpoint = "0.0.0.0:4318"
    include_metadata = false
  }
  output {
    metrics = [otelcol.processor.filter.catalog.input]
    logs = [otelcol.processor.filter.catalog.input]
    traces = [otelcol.processor.filter.catalog.input]
  }
}

otelcol.processor.filter "catalog" {
  error_mode = "propagate"
  metrics {
    metric = [`not IsMatch(name, "^(pilot_requests|http\\.server\\.request\\.count|http\\.server\\.active_requests|http\\.server\\.request\\.duration|telemetry\\.trace\\.dropped|telemetry\\.trace\\.export\\.failures|telemetry\\.metric\\.export\\.failures|telemetry\\.trace\\.sampling\\.ratio|messaging\\.client\\.operation\\.duration|messaging\\.client\\.sent\\.messages|messaging\\.client\\.consumed\\.messages|messaging\\.process\\.duration|pgboss\\.queue\\.jobs|inside\\.notification\\.operations|inside\\.notification\\.duration|inside\\.dependency\\.operations|inside\\.dependency\\.duration|inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$")`]
  }
  output {
    metrics = [otelcol.processor.transform.privacy.input]
    logs = [otelcol.processor.transform.privacy.input]
    traces = [otelcol.processor.transform.privacy.input]
  }
}

otelcol.processor.transform "privacy" {
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name", "deployment.environment.name", "service.version"])`,
      `set(attributes["service.name"], "_OTHER") where attributes["service.name"] != nil and not IsMatch(attributes["service.name"], "^(platform\\-api|platform\\-mcp|platform\\-material\\-assets\\-worker|platform\\-pilot|platform\\-profile\\-avatars\\-worker|platform\\-video\\-deletions\\-worker|platform\\-billing\\-worker|platform\\-notifications\\-worker)$")`,
      `set(attributes["deployment.environment.name"], "_OTHER") where attributes["deployment.environment.name"] != nil and not IsMatch(attributes["deployment.environment.name"], "^(development|test|production|isolated\\-pilot)$")`,
      `set(attributes["service.version"], "_OTHER") where attributes["service.version"] != nil and not IsMatch(attributes["service.version"], "^([0-9a-f]{40}|[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,4})$")`,
    ]
  }
  trace_statements {
    context = "scope"
    statements = [
      `set(name, "inside-collector")`,
      `set(version, "")`,
      `keep_keys(attributes, [])`,
    ]
  }
  metric_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name", "deployment.environment.name", "service.version"])`,
      `set(attributes["service.name"], "_OTHER") where attributes["service.name"] != nil and not IsMatch(attributes["service.name"], "^(platform\\-api|platform\\-mcp|platform\\-material\\-assets\\-worker|platform\\-pilot|platform\\-profile\\-avatars\\-worker|platform\\-video\\-deletions\\-worker|platform\\-billing\\-worker|platform\\-notifications\\-worker)$")`,
      `set(attributes["deployment.environment.name"], "_OTHER") where attributes["deployment.environment.name"] != nil and not IsMatch(attributes["deployment.environment.name"], "^(development|test|production|isolated\\-pilot)$")`,
      `set(attributes["service.version"], "_OTHER") where attributes["service.version"] != nil and not IsMatch(attributes["service.version"], "^([0-9a-f]{40}|[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,4})$")`,
    ]
  }
  metric_statements {
    context = "scope"
    statements = [
      `set(name, "inside-collector")`,
      `set(version, "")`,
      `keep_keys(attributes, [])`,
    ]
  }
  log_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name", "deployment.environment.name", "service.version"])`,
      `set(attributes["service.name"], "_OTHER") where attributes["service.name"] != nil and not IsMatch(attributes["service.name"], "^(platform\\-api|platform\\-mcp|platform\\-material\\-assets\\-worker|platform\\-pilot|platform\\-profile\\-avatars\\-worker|platform\\-video\\-deletions\\-worker|platform\\-billing\\-worker|platform\\-notifications\\-worker)$")`,
      `set(attributes["deployment.environment.name"], "_OTHER") where attributes["deployment.environment.name"] != nil and not IsMatch(attributes["deployment.environment.name"], "^(development|test|production|isolated\\-pilot)$")`,
      `set(attributes["service.version"], "_OTHER") where attributes["service.version"] != nil and not IsMatch(attributes["service.version"], "^([0-9a-f]{40}|[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,4})$")`,
    ]
  }
  log_statements {
    context = "scope"
    statements = [
      `set(name, "inside-collector")`,
      `set(version, "")`,
      `keep_keys(attributes, [])`,
    ]
  }
  trace_statements {
    context = "span"
    statements = [
      `keep_keys(attributes, ["http.route", "http.request.method", "http.request.outcome", "http.response.status_code", "messaging.system", "messaging.destination.name", "messaging.operation.name", "messaging.operation.type", "pgboss.job.state", "error.type", "dependency.name", "dependency.operation", "dependency.outcome", "messaging.message.id", "pgboss.job.retry_count", "messaging.batch.message_count"])`,
      `set(attributes["http.route"], "_OTHER") where attributes["http.route"] != nil and not IsMatch(attributes["http.route"], "^(/account/profile|/account/profile/avatar|/account/profile/avatar/:avatarId/:size|/account/profile/avatar/\\{avatarId\\}/\\{size\\}|/accounts|/accounts/current|/accounts/current/billing|/accounts/current/billing/consents|/accounts/current/billing/consents/:evidenceRef|/accounts/current/billing/consents/\\{evidenceRef\\}|/accounts/current/billing/contact|/accounts/current/billing/contact/confirm|/accounts/current/billing/contact/start|/accounts/current/billing/enrollments|/accounts/current/billing/payment\\-method/change|/accounts/current/billing/payment\\-method/revoke|/accounts/current/billing/products/:productId/purchase|/accounts/current/billing/products/\\{productId\\}/purchase|/accounts/current/billing/purchase|/accounts/current/billing/purchases/:purchaseRef|/accounts/current/billing/purchases/\\{purchaseRef\\}|/accounts/current/billing/quote|/accounts/current/billing/subscription/cancel|/accounts/current/billing/subscription/change|/accounts/current/billing/subscription/change/cancel|/accounts/current/billing/subscription/change/quote|/accounts/current/billing/subscription/resume|/accounts/current/community\\-admission|/accounts/current/community\\-entry|/accounts/current/legal\\-acceptances|/accounts/current/legal\\-acceptances/terms|/accounts/current/notifications/deliveries|/accounts/current/notifications/preferences|/accounts/current/product\\-tasks/:code/submissions|/accounts/current/product\\-tasks/\\{code\\}/submissions|/accounts/current/products/:productId/access|/accounts/current/products/\\{productId\\}/access|/accounts/current/telegram\\-activation/:attemptId|/accounts/current/telegram\\-activation/\\{attemptId\\}|/accounts/current/telegram\\-link|/accounts/current/telegram\\-link/:linkRef/confirm|/accounts/current/telegram\\-link/\\{linkRef\\}/confirm|/accounts/current/telegram\\-membership|/accounts/current/telegram\\-sign\\-in/resume|/admin/access/products/preview\\-revoke|/admin/access/products/revoke|/admin/products/:productId/community|/admin/products/\\{productId\\}/community|/authoring/collections|/authoring/collections/:collectionId|/authoring/collections/:collectionId/archive|/authoring/collections/\\{collectionId\\}|/authoring/collections/\\{collectionId\\}/archive|/authoring/content\\-covers/:ownerKind/:ownerId|/authoring/content\\-covers/\\{ownerKind\\}/\\{ownerId\\}|/authoring/home\\-pin|/authoring/import/content\\-covers/:ownerKind/:ownerId|/authoring/import/content\\-covers/\\{ownerKind\\}/\\{ownerId\\}|/authoring/import/materials/apply|/authoring/import/materials/environment|/authoring/import/materials/reserve|/authoring/import/materials/validate|/authoring/import/practices/apply|/authoring/import/practices/validate|/authoring/import/products/:productId/artifacts|/authoring/import/products/:productId/artifacts/:artifactId/materials|/authoring/import/products/composition|/authoring/import/products/reserve|/authoring/import/products/update|/authoring/import/products/validate|/authoring/import/products/\\{productId\\}/artifacts|/authoring/import/products/\\{productId\\}/artifacts/\\{artifactId\\}/materials|/authoring/import/tasks/apply|/authoring/import/tasks/validate|/authoring/materials|/authoring/materials/:materialId|/authoring/materials/:materialId/assets|/authoring/materials/:materialId/preview|/authoring/materials/:materialId/publication|/authoring/materials/:materialId/validation|/authoring/materials/:materialId/videos/attach|/authoring/materials/:materialId/videos/uploads|/authoring/materials/references|/authoring/materials/\\{materialId\\}|/authoring/materials/\\{materialId\\}/assets|/authoring/materials/\\{materialId\\}/preview|/authoring/materials/\\{materialId\\}/publication|/authoring/materials/\\{materialId\\}/validation|/authoring/materials/\\{materialId\\}/videos/attach|/authoring/materials/\\{materialId\\}/videos/uploads|/authoring/product\\-artifacts|/authoring/product\\-artifacts/:artifactId|/authoring/product\\-artifacts/:artifactId/archive|/authoring/product\\-artifacts/:artifactId/link|/authoring/product\\-artifacts/:artifactId/materials|/authoring/product\\-artifacts/:artifactId/products|/authoring/product\\-artifacts/file|/authoring/product\\-artifacts/files|/authoring/product\\-artifacts/links|/authoring/product\\-artifacts/\\{artifactId\\}|/authoring/product\\-artifacts/\\{artifactId\\}/archive|/authoring/product\\-artifacts/\\{artifactId\\}/link|/authoring/product\\-artifacts/\\{artifactId\\}/materials|/authoring/product\\-artifacts/\\{artifactId\\}/products|/authoring/product\\-tasks/submissions|/authoring/product\\-tasks/submissions/:submissionId/feedback|/authoring/product\\-tasks/submissions/\\{submissionId\\}/feedback|/authoring/products/:productId/artifacts|/authoring/products/:productId/chapters/:chapterId/attachments|/authoring/products/:productId/order|/authoring/products/\\{productId\\}/artifacts|/authoring/products/\\{productId\\}/chapters/\\{chapterId\\}/attachments|/authoring/products/\\{productId\\}/order|/authoring/series/:seriesId/order|/authoring/series/\\{seriesId\\}/order|/authoring/videos/:videoId/deletion\\-retries|/authoring/videos/:videoId/reconcile|/authoring/videos/\\{videoId\\}/deletion\\-retries|/authoring/videos/\\{videoId\\}/reconcile|/billing/admin|/billing/cohorts|/billing/offers|/billing/payment\\-links/:id|/billing/payment\\-links/\\{id\\}|/billing/tbank/notification|/bookmarks/materials/:materialId|/bookmarks/materials/query|/bookmarks/materials/\\{materialId\\}|/bookmarks/query|/communications|/communications/templates/resolve|/communications/tracking/resolve|/community\\-entitlements/:accountId|/community\\-entitlements/members\\-without\\-right|/community\\-entitlements/\\{accountId\\}|/content\\-covers/:coverId/:width|/content\\-covers/\\{coverId\\}/\\{width\\}|/health|/health/live|/health/ready|/integrations/kinescope/v1/authorize|/integrations/kinescope/v1/webhook|/integrations/telegram/v1/communications/authorize|/integrations/telegram/v1/communications/validate\\-content|/integrations/telegram/v1/communications/waitlist|/integrations/telegram/v1/invitations/redeem|/integrations/telegram/v1/membership\\-evidence|/integrations/telegram/v1/sales\\-funnel/events|/integrations/telegram/v1/sign\\-in/complete|/integrations/telegram/v1/sign\\-in/linked\\-identity|/integrations/telegram/v1/subscription\\-activation/announcement|/integrations/telegram/v1/subscription\\-activation/attempts|/integrations/telegram/v1/subscription\\-activation/binding|/integrations/telegram/v1/subscription\\-activation/evidence|/integrations/telegram/v1/subscription\\-activation/own\\-access|/integrations/tribute/v1/webhook|/internal/billing\\-dispatch/authorize|/internal/notifications/dispatch/authorize|/library/home|/library/materials|/library/materials/:materialId/task|/library/materials/:slug/practices|/library/materials/:slug/related|/library/materials/\\{materialId\\}/task|/library/materials/\\{slug\\}/practices|/library/materials/\\{slug\\}/related|/library/products/:slug|/library/products/:slug/tasks/:code|/library/products/:slug/tasks/:code/assets/:assetId|/library/products/sale\\-availability|/library/products/\\{slug\\}|/library/products/\\{slug\\}/tasks/\\{code\\}|/library/products/\\{slug\\}/tasks/\\{code\\}/assets/\\{assetId\\}|/library/series/:slug|/library/series/\\{slug\\}|/library/site\\-index|/library/topics/:slug|/library/topics/\\{slug\\}|/materials/:materialId/assets/:assetId|/materials/:materialId/assets/:assetId/images/:width|/materials/:materialId/videos/:videoId/playback|/materials/:materialId/videos/:videoId/progress|/materials/:slug|/materials/\\{materialId\\}/assets/\\{assetId\\}|/materials/\\{materialId\\}/assets/\\{assetId\\}/images/\\{width\\}|/materials/\\{materialId\\}/videos/\\{videoId\\}/playback|/materials/\\{materialId\\}/videos/\\{videoId\\}/progress|/materials/\\{slug\\}|/mcp|/operations/notifications/accounts/:accountId/deliveries|/operations/notifications/accounts/\\{accountId\\}/deliveries|/operations/notifications/unknown/resolve|/pilot|/product\\-waitlists/:productId/intake|/product\\-waitlists/:productId/membership|/product\\-waitlists/join|/product\\-waitlists/withdraw|/product\\-waitlists/\\{productId\\}/intake|/product\\-waitlists/\\{productId\\}/membership|/products/:productId/artifacts|/products/:productId/artifacts/:artifactId/file|/products/\\{productId\\}/artifacts|/products/\\{productId\\}/artifacts/\\{artifactId\\}/file|/reading\\-activity/continue|/reading\\-activity/learning\\-home|/reading\\-activity/materials/:materialId|/reading\\-activity/materials/query|/reading\\-activity/materials/\\{materialId\\}|/reading\\-activity/opens|/reading\\-activity/product\\-continuation/:slug|/reading\\-activity/product\\-continuation/\\{slug\\}|/reading\\-activity/product\\-mode|/reading\\-activity/products/:productId|/reading\\-activity/products/\\{productId\\}|/reading\\-activity/series\\-continuation/:slug|/reading\\-activity/series\\-continuation/\\{slug\\}|/reading\\-activity/series/:seriesId|/reading\\-activity/series/\\{seriesId\\}|/sales\\-funnel/report|/telegram\\-activation\\-intents/:attemptId|/telegram\\-activation\\-intents/\\{attemptId\\}|unmatched)$")`,
      `set(attributes["http.request.method"], "_OTHER") where attributes["http.request.method"] != nil and not IsMatch(attributes["http.request.method"], "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|_OTHER)$")`,
      `set(attributes["http.request.outcome"], "_OTHER") where attributes["http.request.outcome"] != nil and not IsMatch(attributes["http.request.outcome"], "^(completed|aborted|timeout)$")`,
      `set(attributes["messaging.system"], "_OTHER") where attributes["messaging.system"] != nil and not IsMatch(attributes["messaging.system"], "^(pg\\-boss|rabbitmq)$")`,
      `set(attributes["messaging.destination.name"], "_OTHER") where (not (attributes["messaging.system"] == "rabbitmq")) and (attributes["messaging.destination.name"] != nil and not IsMatch(attributes["messaging.destination.name"], "^(material\\-assets\\.cleanup|profile\\-avatars\\.cleanup|videos\\.deletions|web\\-telemetry\\.retention|billing\\.payment\\-recovery|billing\\.subscription\\-renewal|billing\\.subscription\\-notices|tribute\\.source\\-reconciliation|community\\.entitlement\\-delivery|_OTHER)$"))`,
      `set(attributes["messaging.destination.name"], "_OTHER") where (attributes["messaging.system"] == "rabbitmq") and (attributes["messaging.destination.name"] != nil and not IsMatch(attributes["messaging.destination.name"], "^(inside\\.events\\.materials\\.v1)$"))`,
      `set(attributes["messaging.operation.name"], "_OTHER") where (not (attributes["messaging.system"] == "rabbitmq")) and (attributes["messaging.operation.name"] != nil and not IsMatch(attributes["messaging.operation.name"], "^(send|insert|upsert|flow|publish|receive|process|complete|fail|cancel|delete|_OTHER)$"))`,
      `set(attributes["messaging.operation.name"], "_OTHER") where (attributes["messaging.system"] == "rabbitmq") and (attributes["messaging.operation.name"] != nil and not IsMatch(attributes["messaging.operation.name"], "^(publish|receive|audience)$"))`,
      `set(attributes["messaging.operation.type"], "_OTHER") where attributes["messaging.operation.type"] != nil and not IsMatch(attributes["messaging.operation.type"], "^(send|receive|process|settle)$")`,
      `set(attributes["pgboss.job.state"], "_OTHER") where attributes["pgboss.job.state"] != nil and not IsMatch(attributes["pgboss.job.state"], "^(deferred|ready|blocked|active|failed)$")`,
      `set(attributes["error.type"], "_OTHER") where attributes["error.type"] != nil and not IsMatch(attributes["error.type"], "^(aborted|timeout|job_error|notification_operation_failed)$")`,
      `delete_key(attributes, "http.response.status_code") where attributes["http.response.status_code"] != nil and (not IsInt(attributes["http.response.status_code"]) or attributes["http.response.status_code"] < 100 or attributes["http.response.status_code"] > 599)`,
      `set(attributes["dependency.name"], "_OTHER") where attributes["dependency.name"] != nil and not IsString(attributes["dependency.name"])`,
      `set(attributes["dependency.name"], "_OTHER") where attributes["dependency.name"] != nil and not IsMatch(attributes["dependency.name"], "^(kinescope|postgresql|tbank|logto|telegram)$")`,
      `set(attributes["dependency.operation"], "_OTHER") where attributes["dependency.operation"] != nil and not IsString(attributes["dependency.operation"])`,
      `set(attributes["dependency.operation"], "_OTHER") where attributes["dependency.operation"] != nil and not IsMatch(attributes["dependency.operation"], "^(delete|find|initUpload|query|acquire|material\\-slug\\-lock|Init|GetState|CheckOrder|Charge|Cancel|AddCard|GetAddCardState|jwks|community\\.set|community\\.status|communications\\.execute)$")`,
      `set(attributes["dependency.outcome"], "_OTHER") where attributes["dependency.outcome"] != nil and not IsString(attributes["dependency.outcome"])`,
      `set(attributes["dependency.outcome"], "_OTHER") where attributes["dependency.outcome"] != nil and not IsMatch(attributes["dependency.outcome"], "^(completed|failed)$")`,
      `delete_key(attributes, "messaging.message.id") where attributes["messaging.message.id"] != nil and not IsMatch(attributes["messaging.message.id"], "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")`,
      `delete_key(attributes, "pgboss.job.retry_count") where attributes["pgboss.job.retry_count"] != nil and (not IsInt(attributes["pgboss.job.retry_count"]) or attributes["pgboss.job.retry_count"] < 0 or attributes["pgboss.job.retry_count"] > 1000000)`,
      `delete_key(attributes, "messaging.batch.message_count") where attributes["messaging.batch.message_count"] != nil and (not IsInt(attributes["messaging.batch.message_count"]) or attributes["messaging.batch.message_count"] < 0 or attributes["messaging.batch.message_count"] > 1000000)`,
      `set(trace_state, "")`,
      `set(status.message, "")`,
      `set(events, nil)`,
      `set(name, "operation") where not IsMatch(name, "^(HTTP GET /pilot|queue[.]publish|worker[.]attempt|worker[.]retry|dependency[.]http)$")`,
      `set(name, Concat([attributes["http.request.method"], attributes["http.route"]], " ")) where attributes["http.request.method"] != nil and attributes["http.route"] != nil`,
      `set(name, Concat([attributes["messaging.operation.name"], attributes["messaging.destination.name"]], " ")) where attributes["messaging.operation.name"] != nil and attributes["messaging.destination.name"] != nil`,
      `set(name, Concat([attributes["dependency.name"], attributes["dependency.operation"]], " ")) where attributes["dependency.name"] != nil and attributes["dependency.operation"] != nil`,
    ]
  }
  metric_statements {
    context = "metric"
    statements = [
      `set(description, "")`,
      `set(unit, "")`,
      `set(unit, "s") where IsMatch(name, "duration$")`,
    ]
  }
  metric_statements {
    context = "datapoint"
    statements = [
      `keep_keys(attributes, ["http.route", "http.request.method", "http.request.outcome", "http.response.status_code", "messaging.system", "messaging.destination.name", "messaging.operation.name", "messaging.operation.type", "pgboss.job.state", "error.type"]) where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$")))`,
      `set(attributes["http.route"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["http.route"] != nil and not IsMatch(attributes["http.route"], "^(/account/profile|/account/profile/avatar|/account/profile/avatar/:avatarId/:size|/account/profile/avatar/\\{avatarId\\}/\\{size\\}|/accounts|/accounts/current|/accounts/current/billing|/accounts/current/billing/consents|/accounts/current/billing/consents/:evidenceRef|/accounts/current/billing/consents/\\{evidenceRef\\}|/accounts/current/billing/contact|/accounts/current/billing/contact/confirm|/accounts/current/billing/contact/start|/accounts/current/billing/enrollments|/accounts/current/billing/payment\\-method/change|/accounts/current/billing/payment\\-method/revoke|/accounts/current/billing/products/:productId/purchase|/accounts/current/billing/products/\\{productId\\}/purchase|/accounts/current/billing/purchase|/accounts/current/billing/purchases/:purchaseRef|/accounts/current/billing/purchases/\\{purchaseRef\\}|/accounts/current/billing/quote|/accounts/current/billing/subscription/cancel|/accounts/current/billing/subscription/change|/accounts/current/billing/subscription/change/cancel|/accounts/current/billing/subscription/change/quote|/accounts/current/billing/subscription/resume|/accounts/current/community\\-admission|/accounts/current/community\\-entry|/accounts/current/legal\\-acceptances|/accounts/current/legal\\-acceptances/terms|/accounts/current/notifications/deliveries|/accounts/current/notifications/preferences|/accounts/current/product\\-tasks/:code/submissions|/accounts/current/product\\-tasks/\\{code\\}/submissions|/accounts/current/products/:productId/access|/accounts/current/products/\\{productId\\}/access|/accounts/current/telegram\\-activation/:attemptId|/accounts/current/telegram\\-activation/\\{attemptId\\}|/accounts/current/telegram\\-link|/accounts/current/telegram\\-link/:linkRef/confirm|/accounts/current/telegram\\-link/\\{linkRef\\}/confirm|/accounts/current/telegram\\-membership|/accounts/current/telegram\\-sign\\-in/resume|/admin/access/products/preview\\-revoke|/admin/access/products/revoke|/admin/products/:productId/community|/admin/products/\\{productId\\}/community|/authoring/collections|/authoring/collections/:collectionId|/authoring/collections/:collectionId/archive|/authoring/collections/\\{collectionId\\}|/authoring/collections/\\{collectionId\\}/archive|/authoring/content\\-covers/:ownerKind/:ownerId|/authoring/content\\-covers/\\{ownerKind\\}/\\{ownerId\\}|/authoring/home\\-pin|/authoring/import/content\\-covers/:ownerKind/:ownerId|/authoring/import/content\\-covers/\\{ownerKind\\}/\\{ownerId\\}|/authoring/import/materials/apply|/authoring/import/materials/environment|/authoring/import/materials/reserve|/authoring/import/materials/validate|/authoring/import/practices/apply|/authoring/import/practices/validate|/authoring/import/products/:productId/artifacts|/authoring/import/products/:productId/artifacts/:artifactId/materials|/authoring/import/products/composition|/authoring/import/products/reserve|/authoring/import/products/update|/authoring/import/products/validate|/authoring/import/products/\\{productId\\}/artifacts|/authoring/import/products/\\{productId\\}/artifacts/\\{artifactId\\}/materials|/authoring/import/tasks/apply|/authoring/import/tasks/validate|/authoring/materials|/authoring/materials/:materialId|/authoring/materials/:materialId/assets|/authoring/materials/:materialId/preview|/authoring/materials/:materialId/publication|/authoring/materials/:materialId/validation|/authoring/materials/:materialId/videos/attach|/authoring/materials/:materialId/videos/uploads|/authoring/materials/references|/authoring/materials/\\{materialId\\}|/authoring/materials/\\{materialId\\}/assets|/authoring/materials/\\{materialId\\}/preview|/authoring/materials/\\{materialId\\}/publication|/authoring/materials/\\{materialId\\}/validation|/authoring/materials/\\{materialId\\}/videos/attach|/authoring/materials/\\{materialId\\}/videos/uploads|/authoring/product\\-artifacts|/authoring/product\\-artifacts/:artifactId|/authoring/product\\-artifacts/:artifactId/archive|/authoring/product\\-artifacts/:artifactId/link|/authoring/product\\-artifacts/:artifactId/materials|/authoring/product\\-artifacts/:artifactId/products|/authoring/product\\-artifacts/file|/authoring/product\\-artifacts/files|/authoring/product\\-artifacts/links|/authoring/product\\-artifacts/\\{artifactId\\}|/authoring/product\\-artifacts/\\{artifactId\\}/archive|/authoring/product\\-artifacts/\\{artifactId\\}/link|/authoring/product\\-artifacts/\\{artifactId\\}/materials|/authoring/product\\-artifacts/\\{artifactId\\}/products|/authoring/product\\-tasks/submissions|/authoring/product\\-tasks/submissions/:submissionId/feedback|/authoring/product\\-tasks/submissions/\\{submissionId\\}/feedback|/authoring/products/:productId/artifacts|/authoring/products/:productId/chapters/:chapterId/attachments|/authoring/products/:productId/order|/authoring/products/\\{productId\\}/artifacts|/authoring/products/\\{productId\\}/chapters/\\{chapterId\\}/attachments|/authoring/products/\\{productId\\}/order|/authoring/series/:seriesId/order|/authoring/series/\\{seriesId\\}/order|/authoring/videos/:videoId/deletion\\-retries|/authoring/videos/:videoId/reconcile|/authoring/videos/\\{videoId\\}/deletion\\-retries|/authoring/videos/\\{videoId\\}/reconcile|/billing/admin|/billing/cohorts|/billing/offers|/billing/payment\\-links/:id|/billing/payment\\-links/\\{id\\}|/billing/tbank/notification|/bookmarks/materials/:materialId|/bookmarks/materials/query|/bookmarks/materials/\\{materialId\\}|/bookmarks/query|/communications|/communications/templates/resolve|/communications/tracking/resolve|/community\\-entitlements/:accountId|/community\\-entitlements/members\\-without\\-right|/community\\-entitlements/\\{accountId\\}|/content\\-covers/:coverId/:width|/content\\-covers/\\{coverId\\}/\\{width\\}|/health|/health/live|/health/ready|/integrations/kinescope/v1/authorize|/integrations/kinescope/v1/webhook|/integrations/telegram/v1/communications/authorize|/integrations/telegram/v1/communications/validate\\-content|/integrations/telegram/v1/communications/waitlist|/integrations/telegram/v1/invitations/redeem|/integrations/telegram/v1/membership\\-evidence|/integrations/telegram/v1/sales\\-funnel/events|/integrations/telegram/v1/sign\\-in/complete|/integrations/telegram/v1/sign\\-in/linked\\-identity|/integrations/telegram/v1/subscription\\-activation/announcement|/integrations/telegram/v1/subscription\\-activation/attempts|/integrations/telegram/v1/subscription\\-activation/binding|/integrations/telegram/v1/subscription\\-activation/evidence|/integrations/telegram/v1/subscription\\-activation/own\\-access|/integrations/tribute/v1/webhook|/internal/billing\\-dispatch/authorize|/internal/notifications/dispatch/authorize|/library/home|/library/materials|/library/materials/:materialId/task|/library/materials/:slug/practices|/library/materials/:slug/related|/library/materials/\\{materialId\\}/task|/library/materials/\\{slug\\}/practices|/library/materials/\\{slug\\}/related|/library/products/:slug|/library/products/:slug/tasks/:code|/library/products/:slug/tasks/:code/assets/:assetId|/library/products/sale\\-availability|/library/products/\\{slug\\}|/library/products/\\{slug\\}/tasks/\\{code\\}|/library/products/\\{slug\\}/tasks/\\{code\\}/assets/\\{assetId\\}|/library/series/:slug|/library/series/\\{slug\\}|/library/site\\-index|/library/topics/:slug|/library/topics/\\{slug\\}|/materials/:materialId/assets/:assetId|/materials/:materialId/assets/:assetId/images/:width|/materials/:materialId/videos/:videoId/playback|/materials/:materialId/videos/:videoId/progress|/materials/:slug|/materials/\\{materialId\\}/assets/\\{assetId\\}|/materials/\\{materialId\\}/assets/\\{assetId\\}/images/\\{width\\}|/materials/\\{materialId\\}/videos/\\{videoId\\}/playback|/materials/\\{materialId\\}/videos/\\{videoId\\}/progress|/materials/\\{slug\\}|/mcp|/operations/notifications/accounts/:accountId/deliveries|/operations/notifications/accounts/\\{accountId\\}/deliveries|/operations/notifications/unknown/resolve|/pilot|/product\\-waitlists/:productId/intake|/product\\-waitlists/:productId/membership|/product\\-waitlists/join|/product\\-waitlists/withdraw|/product\\-waitlists/\\{productId\\}/intake|/product\\-waitlists/\\{productId\\}/membership|/products/:productId/artifacts|/products/:productId/artifacts/:artifactId/file|/products/\\{productId\\}/artifacts|/products/\\{productId\\}/artifacts/\\{artifactId\\}/file|/reading\\-activity/continue|/reading\\-activity/learning\\-home|/reading\\-activity/materials/:materialId|/reading\\-activity/materials/query|/reading\\-activity/materials/\\{materialId\\}|/reading\\-activity/opens|/reading\\-activity/product\\-continuation/:slug|/reading\\-activity/product\\-continuation/\\{slug\\}|/reading\\-activity/product\\-mode|/reading\\-activity/products/:productId|/reading\\-activity/products/\\{productId\\}|/reading\\-activity/series\\-continuation/:slug|/reading\\-activity/series\\-continuation/\\{slug\\}|/reading\\-activity/series/:seriesId|/reading\\-activity/series/\\{seriesId\\}|/sales\\-funnel/report|/telegram\\-activation\\-intents/:attemptId|/telegram\\-activation\\-intents/\\{attemptId\\}|unmatched)$"))`,
      `set(attributes["http.request.method"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["http.request.method"] != nil and not IsMatch(attributes["http.request.method"], "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|_OTHER)$"))`,
      `set(attributes["http.request.outcome"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["http.request.outcome"] != nil and not IsMatch(attributes["http.request.outcome"], "^(completed|aborted|timeout)$"))`,
      `set(attributes["messaging.system"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["messaging.system"] != nil and not IsMatch(attributes["messaging.system"], "^(pg\\-boss)$"))`,
      `set(attributes["messaging.destination.name"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["messaging.destination.name"] != nil and not IsMatch(attributes["messaging.destination.name"], "^(material\\-assets\\.cleanup|profile\\-avatars\\.cleanup|videos\\.deletions|web\\-telemetry\\.retention|billing\\.payment\\-recovery|billing\\.subscription\\-renewal|billing\\.subscription\\-notices|tribute\\.source\\-reconciliation|community\\.entitlement\\-delivery|_OTHER)$"))`,
      `set(attributes["messaging.operation.name"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["messaging.operation.name"] != nil and not IsMatch(attributes["messaging.operation.name"], "^(send|insert|upsert|flow|publish|receive|process|complete|fail|cancel|delete|_OTHER)$"))`,
      `set(attributes["messaging.operation.type"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["messaging.operation.type"] != nil and not IsMatch(attributes["messaging.operation.type"], "^(send|receive|process|settle)$"))`,
      `set(attributes["pgboss.job.state"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["pgboss.job.state"] != nil and not IsMatch(attributes["pgboss.job.state"], "^(deferred|ready|blocked|active|failed)$"))`,
      `set(attributes["error.type"], "_OTHER") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["error.type"] != nil and not IsMatch(attributes["error.type"], "^(aborted|timeout|job_error)$"))`,
      `delete_key(attributes, "http.response.status_code") where (not (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and not (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))) and (attributes["http.response.status_code"] != nil and (not IsInt(attributes["http.response.status_code"]) or attributes["http.response.status_code"] < 100 or attributes["http.response.status_code"] > 599))`,
      `keep_keys(attributes, ["operation", "outcome"]) where (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$"))`,
      `set(attributes["operation"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and (not IsString(attributes["operation"]))`,
      `set(attributes["operation"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and (attributes["operation"] != nil and not IsMatch(attributes["operation"], "^(publish|receive|audience)$"))`,
      `set(attributes["outcome"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and (not IsString(attributes["outcome"]))`,
      `set(attributes["outcome"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.notification\\.operations|inside\\.notification\\.duration)$")) and (attributes["outcome"] != nil and not IsMatch(attributes["outcome"], "^(completed|failed)$"))`,
      `keep_keys(attributes, []) where (IsMatch(metric.name, "^(inside\\.postgresql\\.pool\\.available|inside\\.postgresql\\.pool\\.total|inside\\.postgresql\\.pool\\.idle|inside\\.postgresql\\.pool\\.waiting|inside\\.postgresql\\.pool\\.registry_overflow)$"))`,
      `keep_keys(attributes, ["dependency", "operation", "outcome"]) where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$"))`,
      `set(attributes["dependency"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and (not IsString(attributes["dependency"]))`,
      `set(attributes["dependency"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and (attributes["dependency"] != nil and not IsMatch(attributes["dependency"], "^(kinescope|postgresql|tbank|logto|telegram)$"))`,
      `set(attributes["operation"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and (not IsString(attributes["operation"]))`,
      `set(attributes["operation"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and (attributes["operation"] != nil and not IsMatch(attributes["operation"], "^(delete|find|initUpload|query|acquire|material\\-slug\\-lock|Init|GetState|CheckOrder|Charge|Cancel|AddCard|GetAddCardState|jwks|community\\.set|community\\.status|communications\\.execute)$"))`,
      `set(attributes["outcome"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and (not IsString(attributes["outcome"]))`,
      `set(attributes["outcome"], "_OTHER") where (IsMatch(metric.name, "^(inside\\.dependency\\.operations|inside\\.dependency\\.duration)$")) and (attributes["outcome"] != nil and not IsMatch(attributes["outcome"], "^(completed|failed)$"))`,
      `set(exemplars, nil)`,
    ]
  }
  log_statements {
    context = "log"
    statements = [
      `keep_keys(attributes, [])`,
      `set(body, "telemetry.redacted") where not IsString(body) or body != "pilot.known_failure"`,
      `set(event_name, "")`,
      `set(severity_text, "")`,
    ]
  }
  output {
    metrics = [otelcol.exporter.otlphttp.metrics.input]
    logs = [otelcol.exporter.otlphttp.logs.input]
    traces = [otelcol.exporter.otlphttp.traces.input]
  }
}

otelcol.exporter.otlphttp "metrics" {
  client {
    endpoint = "http://metrics:8428/opentelemetry"
    timeout = "5s"
  }
  sending_queue {
    queue_size = 64
    num_consumers = 1
  }
  retry_on_failure {
    max_elapsed_time = "30s"
  }
}

otelcol.exporter.otlphttp "logs" {
  client {
    endpoint = "http://logs:9428/insert/opentelemetry"
    timeout = "5s"
  }
  sending_queue {
    queue_size = 64
    num_consumers = 1
  }
  retry_on_failure {
    max_elapsed_time = "30s"
  }
}

otelcol.exporter.otlphttp "traces" {
  client {
    endpoint = "http://traces:10428/insert/opentelemetry"
    headers = {"VT-Ignore-Fields" = "link:link_attr:*,link:link_trace_state:*"}
    timeout = "5s"
  }
  sending_queue {
    queue_size = 64
    num_consumers = 1
  }
  retry_on_failure {
    max_elapsed_time = "30s"
  }
}

// Raw diagnostics are discarded; retain a closed operational health/counter surface instead.
prometheus.scrape "collector_health" {
  targets = [{"__address__" = "127.0.0.1:12345"}]
  scrape_interval = "5s"
  scrape_timeout = "2s"
  body_size_limit = "1MiB"
  sample_limit = 2000
  forward_to = [prometheus.relabel.collector_health.receiver]
}
prometheus.relabel "collector_health" {
  forward_to = [prometheus.remote_write.collector_health.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up|otelcol_receiver_(accepted|refused)_(spans|metric_points|log_records)(_total)?|otelcol_exporter_(sent|send_failed|enqueue_failed)_(spans|metric_points|log_records)(_total)?|otelcol_exporter_queue_(size|capacity)"
    action = "keep"
  }
  rule {
    source_labels = ["receiver"]
    regex = "(|otlp|otlp/pilot|(otlp/)?otelcol[.]receiver[.]otlp[.]pilot)"
    action = "keep"
  }
  rule {
    source_labels = ["exporter"]
    regex = "(|otlphttp|otlphttp/(metrics|logs|traces)|(otlp_http/)?otelcol[.]exporter[.]otlphttp[.](metrics|logs|traces))"
    action = "keep"
  }
  rule {
    source_labels = ["data_type"]
    regex = "(|traces|metrics|logs)"
    action = "keep"
  }
  rule {
    target_label = "job"
    replacement = "platform-collector"
  }
  rule {
    target_label = "instance"
    replacement = "pilot"
  }
  rule {
    regex = "__name__|job|instance|receiver|exporter|data_type"
    action = "labelkeep"
  }
}
prometheus.remote_write "collector_health" {
  endpoint {
    url = "http://metrics:8428/api/v1/write"
  }
}

prometheus.scrape "trace_store_health" {
  targets = [{"__address__" = "traces:10428"}]
  scrape_interval = "5s"
  scrape_timeout = "2s"
  body_size_limit = "1MiB"
  sample_limit = 2000
  forward_to = [prometheus.relabel.trace_store_health.receiver]
}
prometheus.relabel "trace_store_health" {
  forward_to = [prometheus.remote_write.collector_health.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up|vt_http_requests_total|vt_http_errors_total|vt_rows_ingested_total|vt_rows_dropped_total|vt_traceid_index_push_error_total"
    action = "keep"
  }
  rule {
    source_labels = ["path"]
    regex = "(|/insert/opentelemetry/v1/traces)"
    action = "keep"
  }
  rule {
    source_labels = ["format"]
    regex = "(|protobuf)"
    action = "keep"
  }
  rule {
    source_labels = ["type"]
    regex = "(|opentelemetry_traces_otlphttp_protobuf)"
    action = "keep"
  }
  rule {
    source_labels = ["reason"]
    regex = "(|debug|too_many_fields)"
    action = "keep"
  }
  rule {
    target_label = "job"
    replacement = "platform-trace-store"
  }
  rule {
    target_label = "instance"
    replacement = "pilot"
  }
  rule {
    regex = "__name__|job|instance|path|format|type|reason"
    action = "labelkeep"
  }
}
