+
+// Fixed project admission limits apply before parser recursion and before expansion allocation.
+// Bytes charge cumulative copies (including backing-array growth and map overhead), not merely
+// the final tree. Each HTTP request has its own budget; no mutable global accounting is used.
+var errInsideComplexity = fmt.Errorf("MetricsQL project complexity budget exceeded")
+type insideBudget struct { work, bytes, depth int }
+func (b *insideBudget) take(work, bytes int) {
+    if b == nil { return }
+    if work < 0 || bytes < 0 || work > 4096-b.work || bytes > (1<<20)-b.bytes { panic(errInsideComplexity) }
+    b.work += work; b.bytes += bytes
+}
+func (b *insideBudget) filters(filters []LabelFilter) {
+    if b == nil { return }
+    b.take(len(filters)+1, 256*len(filters))
+    for _, f := range filters { b.take(0, 4*(len(f.Label)+len(f.Value))) }
+}
+func (b *insideBudget) enter(e Expr, scope int) {
+    b.take(1, 256 + 32*scope)
+    b.depth++; if b.depth > 128 { panic(errInsideComplexity) }
+    switch t := e.(type) {
+    case *StringExpr:
+        b.take(0, 4*len(t.S) + 32*len(t.tokens))
+        for _, token := range t.tokens { b.take(0, 4*len(token)) }
+    case *MetricExpr:
+        for _, filters := range t.LabelFilterss { b.filters(filters) }
+        for _, filters := range t.labelFilterss {
+            b.take(len(filters), 256*len(filters))
+            for _, f := range filters { b.take(0, 4*len(f.Label)) }
+        }
+    }
+}
+func (b *insideBudget) leave() { b.depth-- }
+func (b *insideBudget) tree(e Expr) {
+    if e == nil { return }
+    b.enter(e, 0); defer b.leave()
+    switch t := e.(type) {
+    case *BinaryOpExpr:
+        b.tree(t.Left); b.tree(t.Right)
+        b.take(len(t.GroupModifier.Args)+len(t.JoinModifier.Args), 64*(len(t.GroupModifier.Args)+len(t.JoinModifier.Args)))
+        if t.JoinModifierPrefix != nil { b.tree(t.JoinModifierPrefix) }
+    case *FuncExpr:
+        for _, arg := range t.Args { b.tree(arg) }
+    case *AggrFuncExpr:
+        b.take(len(t.Modifier.Args), 64*len(t.Modifier.Args))
+        for _, arg := range t.Args { b.tree(arg) }
+    case *parensExpr:
+        for _, arg := range *t { b.tree(arg) }
+    case *RollupExpr:
+        b.tree(t.Expr)
+        if t.At != nil { b.tree(t.At) }
+    }
+}
+func insideSyntax(s string) {
+    if len(s) > 65536 { panic(errInsideComplexity) }
+    var lex lexer
+    lex.Init(s)
+    depth := 0
+    for tokens := 0; ; tokens++ {
+        if tokens > 1024 { panic(errInsideComplexity) }
+        if err := lex.Next(); err != nil { return } // The unchanged vendor parser reports syntax errors.
+        if isEOF(lex.Token) { return }
+        switch lex.Token {
+        case "(", "{", "[": depth++
+        case ")", "}", "]": depth--
+        }
+        if depth > 64 { panic(errInsideComplexity) }
+    }
+}
