+// ParseBounded is the Inside project security patch, not an upstream API.
+func ParseBounded(s string) (result Expr, err error) {
+	defer func() {
+		if failure := recover(); failure != nil {
+			if failure == errInsideComplexity {
+				result, err = nil, errInsideComplexity
+			} else {
+				panic(failure)
+			}
+		}
+	}()
+	insideSyntax(s)
+	return parseWithBudget(s, &insideBudget{})
+}
