# Optional local-development overrides. Copy to .env; never add real secrets here.
NODE_ENV=development
POSTGRES_DB=inside
POSTGRES_USER=inside
POSTGRES_PASSWORD=inside
DATABASE_URL=postgresql://inside:inside@127.0.0.1:5432/inside
API_HOST=127.0.0.1
API_PORT=3001
BACKEND_BASE_URL=http://127.0.0.1:3001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_ACCESS_KEY_ID=inside-local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=inside-local-secret-key
OBJECT_STORAGE_PUBLIC_BUCKET=inside-local-public
OBJECT_STORAGE_PROTECTED_BUCKET=inside-local-protected
OBJECT_STORAGE_QUARANTINE_BUCKET=inside-local-quarantine
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_SIGNED_GET_TTL_SECONDS=60
MATERIAL_ASSET_ORPHAN_GRACE_SECONDS=86400
PROFILE_AVATAR_ORPHAN_GRACE_SECONDS=86400
KINESCOPE_PROVIDER_MODE=test
KINESCOPE_API_BASE_URL=https://api.kinescope.io
KINESCOPE_UPLOADER_BASE_URL=https://uploader.kinescope.io
KINESCOPE_API_TOKEN=inside-local-kinescope-api-token
KINESCOPE_PUBLIC_PROJECT_ID=inside-local-public-project
KINESCOPE_MEMBERSHIP_PROJECT_ID=inside-local-membership-project
KINESCOPE_CALLBACK_USERNAME=inside-local-callback
KINESCOPE_CALLBACK_PASSWORD=inside-local-callback-password
KINESCOPE_WEBHOOK_USERNAME=inside-local-webhook
KINESCOPE_WEBHOOK_PASSWORD=inside-local-webhook-password
KINESCOPE_PLAYBACK_JWT_SECRET=inside-local-kinescope-playback-secret
KINESCOPE_PLAYBACK_JWT_TTL_SECONDS=60
MCP_HOST=127.0.0.1
MCP_PORT=3002
MCP_SERVER_URL=http://127.0.0.1:3002/mcp
LOGTO_ISSUER=https://identity.inside.localhost:3301/oidc
LOGTO_ENDPOINT=https://identity.inside.localhost:3301
LOGTO_AUDIENCE=http://127.0.0.1:3001
LOGTO_JWKS_URL=https://identity.inside.localhost:3301/oidc/jwks
IDENTITY_EMAIL_FINGERPRINT_KEY=inside-local-email-fingerprint-key
MEMBERSHIP_ACQUISITION_URL=https://t.me/tribute
MEMBERSHIP_SUPPORT_URL=
TELEGRAM_BOT_START_URL=https://t.me/inside_local_bot
TELEGRAM_LINKING_ENDPOINT=http://127.0.0.1:3002/integrations/platform/v1/identity-links
TELEGRAM_LINKING_SECRET=inside-local-telegram-link-secret
TELEGRAM_EVIDENCE_INGRESS_SECRET=inside-local-telegram-evidence-secret
TELEGRAM_LINK_LIFETIME_SECONDS=300
# Release-only owner bootstrap inputs; copy the exact existing Logto issuer and subject.
OWNER_LOGTO_ISSUER=
OWNER_LOGTO_SUBJECT=
LOGTO_APP_ID=inside-web-local
LOGTO_APP_SECRET=inside-web-local-confidential-secret
LOGTO_COOKIE_SECRET=inside-local-logto-cookie-secret-key
WEB_BASE_URL=http://127.0.0.1:3000
