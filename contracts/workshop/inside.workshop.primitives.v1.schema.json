{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json",
  "title": "Inside Workshop shared primitives v1",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "opaqueVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "opaqueSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,512}$"
    }
  }
}
