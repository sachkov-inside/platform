{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.assignment-manifest.v1.schema.json",
  "title": "Inside Workshop assignment manifest v1",
  "x-inside-byte-limits": {
    "document": 262144
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformOrigin",
    "assignmentId",
    "caseId",
    "caseVersion",
    "variantId",
    "evaluatorVersion",
    "repositorySlug",
    "defaultBranch",
    "starterArtifactSha256",
    "evaluatorBundle",
    "scenarios",
    "supportedHosts",
    "evaluationTimeoutSeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "inside.workshop.assignment-manifest.v1"
    },
    "platformOrigin": {
      "type": "string",
      "format": "uri"
    },
    "assignmentId": {
      "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/opaqueId"
    },
    "caseId": {
      "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/opaqueId"
    },
    "caseVersion": {
      "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/opaqueVersion"
    },
    "variantId": {
      "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/opaqueId"
    },
    "evaluatorVersion": {
      "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/opaqueVersion"
    },
    "repositorySlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "defaultBranch": {
      "const": "main"
    },
    "starterArtifactSha256": {
      "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/sha256"
    },
    "evaluatorBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "maxBytes"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/sha256"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required"],
        "properties": {
          "id": {
            "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.primitives.v1.schema.json#/$defs/opaqueId"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "supportedHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "https://inside.sachkov.dev/contracts/workshop/inside.workshop.case-spec.v1.schema.json#/$defs/supportedHost"
      }
    },
    "evaluationTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  }
}
